-- Nemesis Combat (round 112, restructure step 5: split out of nemesis_utils)

local function debug_on() return nemesis_utils.debug_on() end
local function log_msg(...) return nemesis_utils.log_msg(...) end

local CLOSE_THREAT_M = 15

local CONTACT_LINGER_MS = 8000
local BOSS_FOCUS_M = 15
local HIT_CONTACT_MS = 1500

local SHOW_EVERY_MS = 1000
local HOLD_MAX_MS = 4000
local SCAN_MS = 500
local fight_memo = {}
local focus = {}

local NPC_FIGHT_MS = 10000

local CHECK_FIRST_MS, CHECK_SECOND_MS, CHECK_EVERY_MS = 4000, 15000, 30000
local REHIT_MS = 1500
local npc_drop = {}

local STALL_MS, STALL_START_MS, STALL_MOVE_M = 3000, 8000, 1
local stall = {}

local fight_range_cache, fight_range_at = 100, -1000000
local function fight_range()
    local now = time_global()
    if now - fight_range_at >= 1000 then
        fight_range_at = now
        local r = nemesis_mcm.get_number("fight_range", 100)
        if r < 10 then r = 10 end
        if r > 150 then r = 150 end
        fight_range_cache = r
    end
    return fight_range_cache
end

local function _dist(a, b) return a:position():distance_to(b:position()) end

local function _see(a, b) return a:see(b) end

local function _best_enemy(npc) return npc:best_enemy() end

local function sees_player(npc, range)
    local actor = db.actor
    if not actor then return false end
    local ok, d = pcall(_dist, npc, actor)
    if not ok or d > range then return false end
    local ok2, seen = pcall(_see, npc, actor)
    return ok2 and seen == true
end

local SHOOTER_MS = 20000
local UNDER_FIRE_MS = 10000
local function _threat(npc, be, range)
    if be:id() == 0 or not be:alive() then return false end

    if npc:relation(be) ~= game_object.enemy then return false end
    local now = time_global()
    local r = nemesis_state.member(npc:id())
    if r and r.hit_from == be:id() and r.hit_at and now - r.hit_at < SHOOTER_MS then return true end

    if xcombat.is_under_fire and xcombat.is_under_fire(npc, be, now, UNDER_FIRE_MS) then return true end
    local d = npc:position():distance_to(be:position())
    if d <= CLOSE_THREAT_M then return true end

    return d <= range and npc:see(be)
end

local function hostile_near(npc, range)
    local ok, be = pcall(_best_enemy, npc)
    if not ok or not be then return false end
    local ok2, hit = pcall(_threat, npc, be, range)
    return ok2 and hit == true
end

local OWNS_CACHE_MS = 100
function combat_owns(npc)
    if not npc then return false end
    local id = npc:id()
    local memo = fight_memo[id]
    if not memo then
        memo = { scan_at = 0, scan_hit = false, last_fight = 0, res_at = -1000000, res = false }
        fight_memo[id] = memo
    end
    local now = time_global()
    if now - memo.res_at < OWNS_CACHE_MS then return memo.res end
    memo.res_at = now
    local was = memo.res
    memo.res = combat_owns_now(npc, memo, now)

    if memo.res ~= was and debug_on() then
        local be_name = "none"

        pcall(function() local be = npc:best_enemy(); if be then be_name = be:id() == 0 and "you" or (be:character_name() .. " (" .. be:id() .. ")") end end)
        log_msg("Nemesis: %s %s (enemy: %s).", tostring(nemesis_state.name_of(id) or id),
            memo.res and "fights" or "is back on the chase", be_name)
    end
    return memo.res
end

local function hit_contact(id, now)
    local r = nemesis_state.member(id)
    return r ~= nil and r.hit_at ~= nil and now - r.hit_at < HIT_CONTACT_MS
end

local function _show_enemy(npc, enemy) return xcombat.show_enemy(npc, enemy) end

function combat_owns_now(npc, memo, now)
    local id = npc:id()
    if nemesis_sneak.sneak_active(id) then return false end
    local range = fight_range()
    local sees = sees_player(npc, range)

    if not sees and focus[id] and db.actor then
        local okd, d = pcall(_dist, npc, db.actor)
        sees = okd and d <= math.min(range, BOSS_FOCUS_M)
    end
    local hit = hit_contact(id, now)
    local contact = sees or hit
    if not contact then
        if now - memo.scan_at >= SCAN_MS then
            memo.scan_at = now
            memo.scan_hit = hostile_near(npc, range)
        end
        contact = memo.scan_hit
    end
    if contact then memo.last_fight = now end
    local okb, be = pcall(_best_enemy, npc)
    if okb and be then
        local eid = be:id()
        if eid ~= 0 then

            if drops_enemy(id, eid) then
                memo.npc_fight = nil
                return false
            end
            local f = memo.npc_fight
            if not f or f.id ~= eid then
                f = { id = eid, until_t = now + NPC_FIGHT_MS }
                memo.npc_fight = f
            end
            local r = nemesis_state.member(id)
            if r and r.hit_from == eid and r.hit_at and r.hit_at + NPC_FIGHT_MS > f.until_t then
                f.until_t = r.hit_at + NPC_FIGHT_MS
            end
            if now >= f.until_t then
                npc_drop[id] = npc_drop[id] or {}
                npc_drop[id][eid] = true
                memo.npc_fight = nil
                memo.last_fight = 0
                if debug_on() then
                    log_msg("Nemesis: %s drops his fight with %s after %s s without a hit from him; back on the hunt.",
                        tostring(nemesis_state.name_of(id) or id), tostring(eid), tostring(NPC_FIGHT_MS / 1000))
                end
                return false
            end
        else
            memo.npc_fight = nil
        end
        memo.hold_start, memo.holding = nil, false
        local fighting = contact or now - memo.last_fight < CONTACT_LINGER_MS
        local S0 = nemesis_state.S
        if id == S0.boss_id and not S0.emission_hunt then return fighting end
        if not memo.res then

            if fighting then
                memo.combat_since, memo.next_check = now, now + CHECK_FIRST_MS
            end
            return fighting
        end
        if now < (memo.next_check or 0) then return true end

        if fighting then
            local since = memo.combat_since or now
            if memo.next_check < since + CHECK_SECOND_MS then memo.next_check = since + CHECK_SECOND_MS
            else memo.next_check = memo.next_check + CHECK_EVERY_MS end
            return true
        end
        return false
    end
    local r = (sees or hit) and nemesis_state.member(id)
    local player_contact = sees or (hit and r and r.hit_by_player == true)

    if not player_contact and hit and r and not r.hit_by_player and r.hit_from then
        local shooter = nemesis_engine.obj(r.hit_from)

        if shooter and (nemesis_engine.is_stalker(shooter) or nemesis_engine.is_mutant(shooter)) and nemesis_fx.alive_obj(shooter) then
            if now - (memo.shown_at or -1000000) >= SHOW_EVERY_MS then
                memo.shown_at = now
                pcall(_show_enemy, npc, shooter)
            end
            memo.hold_start = memo.hold_start or now
            memo.holding = now - memo.hold_start < HOLD_MAX_MS
            return false
        end
    end
    if player_contact and db.actor then
        if now - (memo.shown_at or -1000000) >= SHOW_EVERY_MS then
            memo.shown_at = now
            pcall(_show_enemy, npc, db.actor)
        end
        memo.hold_start = memo.hold_start or now
        memo.holding = now - memo.hold_start < HOLD_MAX_MS
    else
        memo.hold_start, memo.holding = nil, false
    end
    return false
end

function drops_enemy(a, e)
    local t = a and npc_drop[a]
    if not (t and t[e]) then return false end
    local r = nemesis_state.member(a)
    if r and r.hit_from == e and r.hit_at and time_global() - r.hit_at < REHIT_MS then
        t[e] = nil
        return false
    end
    return true
end

function contact_hold(id)
    local memo = id and fight_memo[id]
    return memo ~= nil and memo.holding == true
end

function set_focus(id, on) if id then focus[id] = on and true or nil end end
function has_focus(id) return id ~= nil and focus[id] == true end

function sneak_over(id, fight)
    if not id then return end
    local memo = id and fight_memo[id]
    if fight then
        if not memo then memo = { scan_at = 0, scan_hit = false, last_fight = 0 }; fight_memo[id] = memo end
        memo.last_fight = time_global()
    end
    if memo then memo.res_at = -1000000 end
end

function stall_check(npc, gt)
    if not npc or not debug_on() then return end
    local id = npc:id()
    local pos = nil
    pcall(function() pos = npc:position() end)
    if not pos then return end
    local s = stall[id]
    if not s then
        stall[id] = { first = gt, pos = pos, since = gt }
        return
    end
    if pos:distance_to(s.pos) >= STALL_MOVE_M then
        if s.logged then log_msg("Nemesis STALL: %s moves again after %s s.", tostring(nemesis_state.name_of(id) or id), string.format("%.1f", (gt - s.since) / 1000)) end
        s.pos, s.since, s.logged = pos, gt, nil
        return
    end
    if s.logged or gt - s.since < STALL_MS or gt - s.first < STALL_START_MS then return end
    s.logged = true
    local memo, slot = fight_memo[id], nemesis_chase.chase_slot(id)
    local owner = "the chase"
    if memo and memo.res then
        local be_name = "none"

        pcall(function() local be = npc:best_enemy(); if be then be_name = be:id() == 0 and "you" or (be:character_name() .. " (" .. be:id() .. ")") end end)
        owner = "combat AI (enemy: " .. be_name .. ")"
    elseif memo and memo.holding then
        owner = "the chase, holding for the engine to pick you"
    end
    local dest = "-"
    if slot and slot.pos then pcall(function() dest = string.format("%.0f m", pos:distance_to(slot.pos)) end) end
    log_msg("Nemesis STALL: %s has stood still for 3 s. Driven by %s; target %s, %s to it; state %s%s%s.",
        tostring(nemesis_state.name_of(id) or id), owner, tostring(slot and slot.mode or "-"), dest,
        tostring(slot and slot.state or "-"),
        nemesis_siege.siege_active() and ", siege (you are indoors)" or "", nemesis_sneak.sneak_active(id) and ", sneaking" or "")
end

function reset()
    fight_memo = {}
    npc_drop, stall = {}, {}
end

function forget(id)
    if not id then return end
    fight_memo[id] = nil
    npc_drop[id], stall[id] = nil, nil
    focus[id] = nil
end
