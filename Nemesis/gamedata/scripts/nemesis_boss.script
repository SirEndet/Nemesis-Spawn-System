-- Nemesis Boss: the rare boss hunter; the mod's second module since round 135 (the emission boss is the first).

local S = nemesis_state.S

local function dbg(...) nemesis_utils.log_tag("BOSS", ...) end

local force_next = false
local warned = false

function force() force_next = true end

local function boss_day() return math.floor(nemesis_engine.game_seconds() / 86400) end

function exists()
    if S.boss_id then return true end
    local g = S.boss_ghost
    if not g then return false end
    local alive = false
    pcall(function()
        local se = nemesis_engine.se(g)
        local n = se and se:alive() and se:character_name()

        alive = n ~= nil and n ~= false and (nemesis_utils.is_boss_name(n) or nemesis_events.ask("is_boss_name", n) == true)
    end)
    if alive then return true end
    S.boss_ghost = nil
    return false
end

local BOSS_RAMP_PCT = 2
local BOSS_RAMP_HUNTS = 4
local BOSS_GUARANTEE_HUNT = 30

function chance_now()
    local base = nemesis_mcm.get_number("boss_chance", 4)
    if base <= 0 then return 0 end
    local n = S.hunts_since_boss or 0
    if n + 1 >= BOSS_GUARANTEE_HUNT then return 100 end
    return math.min(100, base + BOSS_RAMP_PCT * math.floor(n / BOSS_RAMP_HUNTS))
end

function count_hunt(had_boss)
    if had_boss then S.hunts_since_boss = 0
    else S.hunts_since_boss = (S.hunts_since_boss or 0) + 1 end
end

function roll()
    if exists() then return false end
    if force_next then
        force_next = false
        return true
    end
    if S.last_boss_day == boss_day() then return false end

    local grace = nemesis_mcm.get_number("grace_period", 18)
    if grace < 0 then grace = 0 end
    local min_days = nemesis_mcm.get_number("boss_min_day", 7)
    if min_days < 1 then min_days = 1 end
    if min_days > 7 then min_days = 7 end
    if not S.first_hunt or nemesis_engine.game_seconds() - S.first_hunt < (grace + min_days) * 86400 then return false end
    local chance = chance_now()
    if chance <= 0 then return false end
    if chance >= 100 then return true end
    return math.random() * 100 < chance
end

function roll_for_warning()
    warned = roll()
    return warned
end

function take_leader_roll(warning_on)
    local w = warned
    warned = false

    if not warning_on or (force_next and not w) then return roll() end
    return w
end

local function news(text) return nemesis_lines.boss_news(text) end

local sneak = {}

function sneak_active(id) return id ~= nil and id == S.boss_id and S.boss_sneak == true end

function set_sneak(id, on)
    if not (id ~= nil and id == S.boss_id) then return end
    S.boss_sneak = on and true or nil
    sneak = {}
end

function set_sneak_hold(id, on)
    if sneak_active(id) then sneak.hold = on and true or nil end
end

function sneak_closing(id) return sneak_active(id) and sneak.homing == true end

local MOVE_ANY, MOVE_CROUCH, MOVE_WALK, MOVE_SPRINT = 15, 16, 32, 4096

function player_running(actor)

    local ok, st = pcall(level.actor_moving_state)
    if not ok or type(st) ~= "number" then return false end

    if bit_and(st, MOVE_SPRINT) ~= 0 then return true end
    return bit_and(st, MOVE_ANY) ~= 0 and bit_and(st, MOVE_CROUCH + MOVE_WALK) == 0
end

function end_sneak(id, fight)
    if sneak_active(id) then S.boss_sneak = nil end
    nemesis_combat.sneak_over(id, fight)
end

local SNEAK_RING_M = 70
local SNEAK_STEP_DEG = 35
local SNEAK_CLOSE_DEG = 30
local SNEAK_BEHIND_M = 15
local SNEAK_FACING_MS = 5000

local function wrap_angle(a)
    while a > math.pi do a = a - 2 * math.pi end
    while a <= -math.pi do a = a + 2 * math.pi end
    return a
end

function target(npc, actor)
    local s = sneak
    local apos, npos, dir = actor:position(), npc:position(), nil
    pcall(function() dir = actor:direction() end)
    if not dir then return nil end
    local l = math.sqrt(dir.x * dir.x + dir.z * dir.z)
    if l < 0.01 then return nil end
    local back = math.atan2(-dir.z / l, -dir.x / l)
    local now = time_global()
    local p = vector()

    if nemesis_siege.indoors_since() and not s.homing then s.homing = true end
    if s.homing then
        if not s.face_at or now - s.face_at >= SNEAK_FACING_MS or now < s.face_at then
            s.face_at, s.face_back = now, back
        end
        local b = s.face_back
        p:set(apos.x + math.cos(b) * SNEAK_BEHIND_M, apos.y, apos.z + math.sin(b) * SNEAK_BEHIND_M)
        return p, "homing in behind you"
    end
    local vx, vz = npos.x - apos.x, npos.z - apos.z
    local here = math.atan2(vz, vx)
    local off = wrap_angle(back - here)
    local deg = math.abs(off) * 180 / math.pi
    if deg <= SNEAK_CLOSE_DEG then
        s.homing, s.face_at, s.face_back = true, now, back
        p:set(apos.x + math.cos(back) * SNEAK_BEHIND_M, apos.y, apos.z + math.sin(back) * SNEAK_BEHIND_M)
        return p, "homing in behind you"
    end
    local step = math.min(math.abs(off), SNEAK_STEP_DEG * math.pi / 180)
    local a = here + (off >= 0 and step or -step)
    p:set(apos.x + math.cos(a) * SNEAK_RING_M, apos.y, apos.z + math.sin(a) * SNEAK_RING_M)
    return p, "circling behind you"
end

function sneak_move(id)
    if not sneak_active(id) then return nil end
    if sneak.hold then return "hold" end
    if player_running() then return "run" end
    return "still"
end

local LOOKS = {
    monolith = { { "actors\\stalker_monolith\\stalker_monolith_preacher", "actors\\stalker_monolith\\stalker_monolith_preacher_ghillie" },
                 { "actors\\stalker_monolith\\stalker_monolith_skat9_ssp_mask" } },
    isg = { { "actors\\stalker_isg\\stalker_isg_1_commando_1", "actors\\stalker_isg\\stalker_isg_1_commando_3" },
            { "actors\\stalker_isg\\light_isg_shades" } },
}

local function roll_look()
    for _, group in ipairs(LOOKS[S.faction or "monolith"] or LOOKS.monolith) do
        local have = {}
        for _, p in ipairs(group) do
            if nemesis_engine.mesh_exists(p) then have[#have + 1] = p end
        end
        if #have > 0 then return have[math.random(#have)] end
    end
    return nil
end

function make(id)
    local r = nemesis_state.member(id)
    S.boss_id = id
    S.boss_hunt = true
    S.last_boss_day = boss_day()
    if r then r.name = nemesis_utils.get_npc_name() end

    sneak = {}
    S.boss_sneak = true
    S.sneak_started, S.sneak_said, S.sneak_wait = nil, nil, nil
    S.boss_shots, S.boss_hit_frames, S.boss_hit_frame = 0, 0, nil
    S.boss_look = roll_look()
    S.dread_next = time_global() + 20000
    dbg("Nemesis: '%s' is the BOSS of this hunt (look %s).", tostring(r and r.name), tostring(S.boss_look))
end

local stash_tried_level = nil

function on_killed(id, by_player, name)
    S.boss_ghost = id
    S.boss_id = nil
    S.boss_sneak = nil
    sneak = {}
    nemesis_fx.forget_boss()
    dbg("Nemesis: the boss '%s' is dead (%s).", tostring(name), by_player and "killed by you" or "not by you")
    if by_player and nemesis_mcm.get_bool("boss_stash", true) then
        S.stash_owed = name or nemesis_utils.get_npc_name()
        stash_tried_level = nil
    end
end

---------------------------------------------------------------------------
-- Boss stash reward (MCM "Boss stash reward", on by default; user design)
---------------------------------------------------------------------------

local function stash_on_this_map(name)
    local tm = nil
    pcall(function() tm = treasure_manager end)
    if type(tm) ~= "table" or type(tm.get_random_stash) ~= "function" or type(tm.set_random_stash) ~= "function" then
        return nil
    end
    local label = name
    pcall(function()

        local st = game.translate_string("st_stash_of")
        if type(st) == "string" and st ~= "" and st ~= "st_stash_of" then label = st .. " " .. name end
    end)

    local ok, id, sname, desc, hint = pcall(tm.get_random_stash, nil, label, true, true)
    if not ok or not id then return false end
    local str = sname or label
    if desc and hint then
        str = "%c[255,255,160,0]" .. str .. "\\n%c[default]" .. desc .. "\\n%c[160,100,100,200]" .. hint
    end

    local cnt0, last0 = nil, nil
    pcall(function()

        cnt0 = load_var(db.actor, "toolkit_reward_count")
        last0 = load_var(db.actor, "toolkit_reward_last")
        nemesis_engine.save_var(db.actor, "toolkit_reward_count", 1000000)
    end)

    local ok2, got = pcall(tm.set_random_stash, nil, str, nil, id)
    pcall(function()
        nemesis_engine.save_var(db.actor, "toolkit_reward_count", cnt0)
        nemesis_engine.save_var(db.actor, "toolkit_reward_last", last0)
    end)
    if not ok2 then return false end
    if got then return true end

    local marked = false
    pcall(function()

        marked = level.map_has_object_spot(id, "treasure") ~= 0 or level.map_has_object_spot(id, "treasure_searched") ~= 0
    end)
    return marked
end

function stash_tick()
    local name = S.stash_owed
    if not name then return end
    local lname = nil
    pcall(function() lname = nemesis_engine.level_name() end)
    if stash_tried_level and stash_tried_level == lname then return end
    local got = stash_on_this_map(name)
    if got == nil then
        S.stash_owed = nil
        dbg("!Nemesis ERROR: no treasure_manager in this game, the boss stash is dropped.")
    elseif got then
        S.stash_owed = nil
        stash_tried_level = nil

        nemesis_lines.send_news(nemesis_lines.boss_stash_line(name), nemesis_lines.text("st_nemesis_caption_unknown"))
        dbg("Nemesis: the boss stash is marked on %s.", tostring(lname))
    else
        stash_tried_level = lname
        dbg("Nemesis: no free stash on %s for the boss reward; trying again on the next map.", tostring(lname))
    end
end

---------------------------------------------------------------------------
-- Per tick (online, alive, not retreating): focus, look, sneak, dread
---------------------------------------------------------------------------

local SNEAK_TRIGGER_M = 20
local SNEAK_ATTACK_MS = 5000
local RUSH_TRIGGER_M = 20
local RUSH_ATTACK_MS = 1500
local CLOSE_TRIGGER_M = 10
local CLOSE_ATTACK_MS = 1500
local PLAYER_HIT_MS = 1500
local DREAD_M = 50

local function behind_player(obj, actor)
    local behind = false
    pcall(function()
        local apos, dir = actor:position(), actor:direction()
        local bx, bz = obj:position().x - apos.x, obj:position().z - apos.z
        local lb = math.sqrt(bx * bx + bz * bz)
        local ld = math.sqrt(dir.x * dir.x + dir.z * dir.z)

        behind = lb > 0.01 and ld > 0.01 and (bx * dir.x + bz * dir.z) / (lb * ld) < -0.5
    end)
    return behind
end

function update(obj, r, gt, actor)
    local id = r.id
    nemesis_combat.set_focus(id, true)

    local look = S.boss_look
    if look then
        if r.cloak_vis then
            r.cloak_vis = look
        else
            local vis = nemesis_fx.get_visual(obj)

            if vis ~= look and vis ~= nemesis_fx.INVISIBLE_VISUAL then nemesis_fx.set_visual(obj, look) end
        end
    end
    local d = 9999
    pcall(function() d = obj:position():distance_to(actor:position()) end)
    if S.boss_sneak then
        if not S.sneak_started then
            S.sneak_started = gt
            dbg("Nemesis: %s starts sneaking up behind you.", r.name or "The boss")
        end
        local hit = r.player_hit_at and gt - r.player_hit_at < PLAYER_HIT_MS
        if hit and not S.sneak_said then
            end_sneak(id, false)
            dbg("Nemesis: the sneak is broken: you shot him.")
        elseif not S.sneak_said then
            if player_running(actor) then
                if d <= RUSH_TRIGGER_M then
                    S.sneak_said, S.sneak_wait = gt, RUSH_ATTACK_MS
                    set_sneak_hold(id, true)
                    news(nemesis_lines.rush_line())
                    dbg("Nemesis: the boss has run you down; he opens fire in 1.5 s.")
                end
            elseif d <= SNEAK_TRIGGER_M and behind_player(obj, actor) then
                S.sneak_said, S.sneak_wait = gt, SNEAK_ATTACK_MS
                news(nemesis_lines.sneak_line())
                dbg("Nemesis: the boss is behind you; he attacks in 5 s.")
            elseif d <= CLOSE_TRIGGER_M then
                S.sneak_said, S.sneak_wait = gt, CLOSE_ATTACK_MS
                set_sneak_hold(id, true)
                news(nemesis_lines.close_line())
                dbg("Nemesis: the boss is within 10 m of you; he opens fire in 1.5 s.")
            end
        elseif gt - S.sneak_said >= (S.sneak_wait or SNEAK_ATTACK_MS) then
            end_sneak(id, true)
            nemesis_fx.boss_jolt()
            dbg("Nemesis: the boss attacks.")
        end
    end

    if r.cloak_vis and d <= DREAD_M and not S.sneak_said and gt >= (S.dread_next or 0) then
        S.dread_next = gt + math.random(45, 90) * 1000
        news(nemesis_lines.dread_line())
    end
end

---------------------------------------------------------------------------
-- Debug mode: his position on your PDA map
---------------------------------------------------------------------------

local DEBUG_MARK_MS = 3000
local DEBUG_MARK_TYPE = "red_location"
local debug_mark_id, debug_mark_at = nil, nil

local function drop_debug_mark()

    if debug_mark_id and level.present() then level.map_remove_object_spot(debug_mark_id, DEBUG_MARK_TYPE) end
    debug_mark_id = nil
end

function debug_mark_tick(gt)
    if debug_mark_at and gt - debug_mark_at < DEBUG_MARK_MS and gt >= debug_mark_at then return end
    debug_mark_at = gt

    if not level.present() then return end
    local want = nemesis_mcm.get_bool("debug_mode", false) and S.boss_id or nil
    if debug_mark_id and debug_mark_id ~= want then drop_debug_mark() end
    if want and not debug_mark_id then

        if level.map_has_object_spot(want, DEBUG_MARK_TYPE) ~= 0 then return end

        level.map_add_object_spot(want, DEBUG_MARK_TYPE, "Boss (debug): " .. tostring(nemesis_state.name_of(want) or "?"))
        if level.map_has_object_spot(want, DEBUG_MARK_TYPE) ~= 0 then debug_mark_id = want end
    end
end

function reset_runtime()
    debug_mark_id, debug_mark_at = nil, nil
    stash_tried_level = nil
    warned = false
    sneak = {}
end

local RELOAD_M = 50

function on_actor_reload(wpn)
    if S.phase ~= "hunting" or not S.boss_id or S.reload_said then return end
    local obj = nemesis_engine.obj(S.boss_id)
    if not (obj and nemesis_engine.alive(obj) and db.actor) then return end
    local d = 9999

    pcall(function() d = obj:position():distance_to(db.actor:position()) end)
    if d > RELOAD_M then return end
    S.reload_said = true
    news(nemesis_lines.reload_line())
    dbg("Nemesis: the boss saw you reload.")
end

---------------------------------------------------------------------------
-- Settings: this script declares the Boss page (since round 122, the restructure's step 7)
---------------------------------------------------------------------------

function mcm_page()
    return { id = "boss", sh = true, text = "ui_mcm_nemesis_page_boss", gr = {
            { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_nemesis_title", size = {512, 50}, spacing = 20 },
            { id = "head_names", type = "title", text = "ui_mcm_nemesis_head_names", align = "l", clr = nemesis_mcm.HEAD_CLR },

            { id = "npc_name", type = "input", val = 0, def = nemesis_utils.default_boss_name("monolith"), hint = "nemesis_npc_name" },
            { id = "isg_boss_name", type = "input", val = 0, def = nemesis_utils.default_boss_name("isg"), hint = "nemesis_isg_boss_name" },
            { id = "line_appearance", type = "line" },
            { id = "head_appearance", type = "title", text = "ui_mcm_nemesis_head_appearance", align = "l", clr = nemesis_mcm.HEAD_CLR },
            { id = "boss_chance", type = "track", val = 2, def = 4, min = 0, max = 20, step = 1, prec = 0, hint = "nemesis_boss_chance" },
            { id = "boss_min_day", type = "track", val = 2, def = 7, min = 1, max = 7, step = 1, prec = 0, hint = "nemesis_boss_min_day" },
            { id = "boss_escort", type = "track", val = 2, def = 4, min = 0, max = 4, step = 1, prec = 0, hint = "nemesis_boss_escort" },
            { id = "boss_distortion", type = "track", val = 2, def = 40, min = 0, max = 100, step = 5, prec = 0, hint = "nemesis_boss_distortion" },
            { id = "line_toughness", type = "line" },
            { id = "head_toughness", type = "title", text = "ui_mcm_nemesis_head_toughness", align = "l", clr = nemesis_mcm.HEAD_CLR },
            { id = "boss_dr", type = "track", val = 2, def = 30, min = 0, max = 85, step = 5, prec = 0, hint = "nemesis_boss_dr" },
            { id = "boss_npc_damage", type = "track", val = 2, def = 200, min = 100, max = 400, step = 25, prec = 0, hint = "nemesis_boss_npc_damage" },
            { id = "boss_misses", type = "track", val = 2, def = 2, min = 0, max = 4, step = 1, prec = 0, hint = "nemesis_boss_misses" },
            { id = "line_reward", type = "line" },
            { id = "head_reward", type = "title", text = "ui_mcm_nemesis_head_reward", align = "l", clr = nemesis_mcm.HEAD_CLR },
            { id = "boss_stash", type = "check", val = 1, def = true, hint = "nemesis_boss_stash" },
        } }
end

function mcm_presets()
    return {
        easy = { boss_chance = 3, boss_min_day = 7, boss_escort = 3, boss_dr = 20, boss_npc_damage = 150, boss_misses = 3 },
        medium = { boss_chance = 4, boss_min_day = 7, boss_escort = 4, boss_dr = 30, boss_npc_damage = 200, boss_misses = 2 },
        hard = { boss_chance = 5, boss_min_day = 6, boss_escort = 4, boss_dr = 40, boss_npc_damage = 250, boss_misses = 1 },
    }
end

function mcm_force_next() return { "boss", "ui_mcm_nemesis_force_next_boss" } end

function on_game_start()
    local name = "the boss"
    local na, nl = 0, 0

    local function answer(q, fn, order)
        na = na + 1
        nemesis_events.answer(q, name, fn, order)
    end

    local function on(ev, fn, order)
        nl = nl + 1
        nemesis_events.on(ev, name, fn, order)
    end
    answer("boss_roll", function(when, warning_on)
        if when == "warning" then return roll_for_warning() end
        return take_leader_roll(warning_on)
    end)
    answer("make_boss", function(id)
        make(id)
        return true
    end)
    answer("boss_exists", function() return exists() or nil end)

    answer("follow_boss", function(id, follow)
        make(id)
        S.boss_look = follow and follow.boss_look or S.boss_look
        return true
    end, 200)
    answer("boss_update", function(obj, r, gt, actor)
        update(obj, r, gt, actor)
        return true
    end, 200)
    answer("force", function(kind)
        if kind ~= "boss" then return nil end
        force()
        dbg("Nemesis: the next hunt brings the boss (MCM).")
        return true
    end)
    answer("sneak_move", function(id) return sneak_move(id) end)
    answer("sneak_target", function(npc, actor)
        if not sneak_active(npc:id()) then return nil end
        local p, mode = target(npc, actor)
        if p then return { pos = p, mode = mode } end
    end)
    answer("sneak_closing", function(id) return sneak_closing(id) or nil end)

    on("hunt_started", function(faction, boss_hunt, emission_hunt)
        if not emission_hunt then count_hunt(boss_hunt == true) end
    end)

    on("member_died", function(id, r, yours)
        if nemesis_member.is_boss(id) then on_killed(id, yours, r and r.name) end
    end, 20)
    on("runtime_reset", function() reset_runtime() end)

    nemesis_core.add_job("tick", "the boss's debug marker", function(gt) debug_mark_tick(gt) end, nil, true)

    nemesis_core.add_job("slow", "the boss stash", function() stash_tick() end, 40, true)

    RegisterScriptCallback("actor_on_weapon_reload", on_actor_reload)
    dbg("Nemesis: the boss module is in (%s answers, %s listeners, 1 tick job, 1 slow job, 1 callback).", tostring(na), tostring(nl))
end
