-- Nemesis Sound: every sound of the mod in one place (the owner's wish; gathered in round 126).

local function dbg(...) nemesis_utils.log_tag("SOUND", ...) end

---------------------------------------------------------------------------
-- Files and volumes
---------------------------------------------------------------------------
local sound_pick = {}

function pick(key, paths)
    if sound_pick[key] == nil then
        sound_pick[key] = false
        for _, p in ipairs(paths) do

            if nemesis_engine.sound_exists(p) then
                sound_pick[key] = p
                break
            end
        end
        if sound_pick[key] then dbg("Nemesis: %s sound: %s.", key, sound_pick[key])
        else dbg("!Nemesis ERROR: no %s sound file found (tried %s); it stays silent.", key, table.concat(paths, ", ")) end
    end
    return sound_pick[key] or nil
end

local PSY_L = { "anomaly\\psy_voices_1_l" }
local PSY_R = { "anomaly\\psy_voices_1_r" }

function psy_voices()
    local l = pick("psy voices (left)", PSY_L)
    if not l then return nil end
    return l, pick("psy voices (right)", PSY_R)
end

function volume(id, default)
    local v = nemesis_mcm.get_number(id, default) / 100
    if v < 0 then v = 0 end
    if v > 1 then v = 1 end
    return v
end

---------------------------------------------------------------------------
-- One-shots
---------------------------------------------------------------------------

function play(path, vol)
    if not path or (vol or 1) <= 0 then return false end
    local ok, done = false, false

    ok = pcall(function() done = xsound.play(path, { volume = vol or 1 }) end)
    return ok and done == true
end

function play_at(path, pos, vol)
    if not (path and pos) or (vol or 1) <= 0 then return false end
    local ok, done = false, false

    ok = pcall(function() done = xsound.play(path, { position = pos, volume = vol or 1 }) end)
    return ok and done == true
end

function teleport(spot)
    return play_at("anomaly\\teleport_incoming", spot, volume("teleport_volume", 40))
end

function pda_tip()

    pcall(function() xr_sound.set_sound_play(AC_ID, "pda_tips") end)
end

local STATIC_SOUNDS = { "radio\\white_noise\\white_noise_heavy_fade_in", "radio\\white_noise\\white_noise_light", "ambient\\radar_1" }

function warning(boss)
    local snd = pick("warning static", STATIC_SOUNDS)
    local vol = volume("warning_volume", 70)
    if vol <= 0 then return end
    if snd then play(snd, vol) end
end

---------------------------------------------------------------------------
-- The psy hum
---------------------------------------------------------------------------

HUM_FULL_M, HUM_MAX_M = 10, 100
local HUM_RAMP = 0.25
local hum = nil

function hum_id() return hum and hum.id or nil end

function hum_stop()
    if not hum then return end

    pcall(function() hum.snd:stop() end)
    dbg("Nemesis: psy hum stops.")
    hum = nil
end

function hum_update(nearest, near_id, hum_d)
    local vol = volume("hum_volume", 10)

    local id = (hum and hum_d and hum_d <= HUM_MAX_M and hum.id) or (nearest and nearest <= HUM_MAX_M and near_id) or nil
    local obj = id and vol > 0.001 and nemesis_engine.obj(id)
    if not obj then hum_stop() return end
    if hum and hum.id ~= id then hum_stop() end
    local p = obj:position()
    local pos = vector():set(p.x, p.y + 1.5, p.z)
    if not hum then
        local path = psy_voices()
        if not path then return end
        local ok, snd = pcall(function()

            local s = sound_object(path)
            s.volume = 0

            s:play_at_pos(obj, pos, 0, sound_object.s3d + sound_object.looped)
            s.min_distance, s.max_distance = HUM_FULL_M, HUM_MAX_M
            return s
        end)
        if not (ok and snd) then return end
        hum = { snd = snd, id = id, vol = 0 }

        dbg("Nemesis: psy hum starts on %s (3D, full within %s m, gone at %s m).", tostring(nemesis_state.name_of(id) or id), HUM_FULL_M, HUM_MAX_M)
    end
    hum.vol = math.min(vol, hum.vol + vol * HUM_RAMP)
    pcall(function()

        hum.snd:set_position(pos)
        hum.snd.volume = hum.vol
    end)
end

---------------------------------------------------------------------------
-- The heartbeat
---------------------------------------------------------------------------

HEART_FROM_M, HEART_LOW_BPM = 80, 85
local HEART_SLEW_BPM = 10
local HEART_STALE_MS = 1000
local HEART_FILES = { "heart\\7" }
local heart = nil
local heart_d, heart_d_at = nil, nil

local function heart_top()
    local v = nemesis_mcm.get_number("heartbeat_top", 140)
    if v < 120 then v = 120 end
    if v > 180 then v = 180 end
    return v
end

function heart_bpm(d, top)
    local k = 1 - d / HEART_FROM_M
    if k < 0 then k = 0 end
    if k > 1 then k = 1 end
    return HEART_LOW_BPM + (top - HEART_LOW_BPM) * k ^ 1.5
end

function heart_stop(why)
    heart_d, heart_d_at = nil, nil
    if not heart then return end
    heart = nil
    dbg("Nemesis: the heartbeat stops (%s).", why or "?")
end

function heart_update(boss_d)
    if not boss_d or boss_d > HEART_FROM_M then return heart_stop("the boss is out of range") end
    if volume("heartbeat_volume", 30) <= 0 then return heart_stop("volume 0") end
    heart_d, heart_d_at = boss_d, time_global()
end

function heart_frame(gt)
    if not heart_d then return end
    if gt - heart_d_at > HEART_STALE_MS or gt < heart_d_at then return heart_stop("no distance any more") end
    local want = heart_bpm(heart_d, heart_top())
    if not heart then
        local path = pick("heartbeat", HEART_FILES)
        if not path then
            heart_d, heart_d_at = nil, nil
            return
        end
        heart = { bpm = want, at = gt, next_at = gt, path = path }
        dbg("Nemesis: the heartbeat starts (the boss %s m away, %s bpm).", string.format("%.0f", heart_d), string.format("%.0f", want))
    end
    local step = HEART_SLEW_BPM * math.max(0, gt - heart.at) / 1000
    heart.at = gt
    if want > heart.bpm then
        heart.bpm = math.min(want, heart.bpm + step)
    else
        heart.bpm = math.max(want, heart.bpm - step)
    end
    if gt < heart.next_at then return end
    play(heart.path, volume("heartbeat_volume", 30))
    local gap = 60000 / heart.bpm
    heart.next_at = math.max(heart.next_at + gap, gt + gap / 2)
end

---------------------------------------------------------------------------
-- The whispers
---------------------------------------------------------------------------

WHISPER_FULL_M, WHISPER_MAX_M = 5, 25
local WHISPER_FADE_MS = 1000
local WHISPER_STALE_MS = 1000
local WHISPER_FILES = { "arszi_psy\\pripyat_whispers_final" }
local whisper = nil

local function whisper_off(why)
    if not whisper then return end

    pcall(function() whisper.snd:stop() end)
    whisper = nil
    dbg("Nemesis: the whispers stop (%s).", why or "?")
end

function whisper_fade(why)
    if not whisper or whisper.want == 0 then return end
    whisper.want = 0
    whisper.why = why
end

function whisper_update(id, d, cloaked)
    local vol = volume("whispers_volume", 25)
    local on = id ~= nil and d ~= nil and d <= WHISPER_MAX_M and cloaked == true and vol > 0
    local obj = on and nemesis_engine.obj(id)
    if not obj then return whisper_fade("the boss is not cloaked near you") end
    if whisper and whisper.id ~= id then whisper_off("another boss") end
    local p = obj:position()
    local pos = vector():set(p.x, p.y + 1.5, p.z)
    if not whisper then
        local path = pick("whispers", WHISPER_FILES)
        if not path then return end
        local ok, snd = pcall(function()

            local s = sound_object(path)
            s.volume = 0

            s:play_at_pos(obj, pos, 0, sound_object.s3d + sound_object.looped)
            s.min_distance, s.max_distance = WHISPER_FULL_M, WHISPER_MAX_M
            return s
        end)
        if not (ok and snd) then return end
        whisper = { snd = snd, id = id, vol = 0, at = time_global() }
        dbg("Nemesis: the whispers start (the boss cloaked %s m away).", string.format("%.0f", d))
    end
    whisper.want, whisper.full, whisper.seen_at = vol, vol, time_global()

    pcall(function() whisper.snd:set_position(pos) end)
end

function whisper_frame(gt)
    if not whisper then return end
    if whisper.want > 0 and gt - (whisper.seen_at or gt) > WHISPER_STALE_MS then
        whisper_fade("no target any more")
    end
    local step = math.max(whisper.full or 0, 0.01) * math.max(0, gt - whisper.at) / WHISPER_FADE_MS
    whisper.at = gt
    local v = whisper.vol
    if v < whisper.want then
        v = math.min(whisper.want, v + step)
    elseif v > whisper.want then
        v = math.max(whisper.want, v - step)
    else
        return
    end
    whisper.vol = v
    if v <= 0 and whisper.want <= 0 then return whisper_off(whisper.why) end
    pcall(function() whisper.snd.volume = v end)
end

local CALL_FILES = { "monolith_call_1", "characters_voice\\scenario\\sarcofag\\monolith_call_1" }

function arrival_call(pos, boost)
    local vol = volume("arrival_call_volume", 50) * (1 + (boost or 0))
    if vol > 1 then vol = 1 end
    if vol <= 0 or not pos then return false end
    local path = pick("arrival call", CALL_FILES)
    return path ~= nil and play_at(path, pos, vol)
end

---------------------------------------------------------------------------
-- The silence before the warning
---------------------------------------------------------------------------

local SILENCE_FADE_MS, SILENCE_BACK_MS = 3000, 1500
local SILENCE_FLOOR = 0.05
local SILENCE_WATCH_MS, SILENCE_STABLE_MS = 60000, 8000
local silence = nil
local owed = nil
local held = {}

function silence_wanted()
    return nemesis_mcm.get_bool("silence_before", true) and volume("warning_volume", 70) > 0
end

local function held_shot(path, vol, share)
    local ok, snd = pcall(function()

        local s = sound_object(path)
        s.volume = vol / share

        s:play_at_pos(db.actor, vector():set(0, 0, 0), 0, sound_object.s2d)
        s.volume = vol / share
        return s
    end)
    if ok and snd then held[#held + 1] = { snd = snd, vol = vol } end
end

local function raise_held(share)
    for i = #held, 1, -1 do
        local h = held[i]
        local playing = false

        pcall(function() playing = h.snd:playing() end)
        if playing then
            pcall(function() h.snd.volume = h.vol / share end)
        else
            table.remove(held, i)
        end
    end
end

local function say_warning(s, share)
    if s.said then return end
    s.said = true
    if s.on_warning then pcall(s.on_warning) end
    local vol = volume("warning_volume", 70)
    local snd = pick("warning static", STATIC_SOUNDS)
    if snd then held_shot(snd, vol, share) end

end

local function silence_end(why, say)
    local s = silence
    if not s then return end
    silence = nil
    if say then say_warning(s, 1) end
    local fx, mu = nemesis_engine.sound_factors()
    local fx_ours = fx ~= nil and math.abs(fx - s.set_fx) <= 0.001
    local mu_ours = mu ~= nil and math.abs(mu - s.set_mu) <= 0.001

    nemesis_engine.set_sound_factors(fx_ours and s.fx0 or nil, mu_ours and s.mu0 or nil)
    if fx and not fx_ours then
        owed = { fx0 = s.fx0, until_at = time_global() + SILENCE_WATCH_MS, last = fx, since = time_global() }
    end
    raise_held(1)
    dbg("Nemesis: the silence ends (%s)%s.", why or "?", fx_ours and "" or "; another script holds the sound volume, watched")
end

function silence_begin(boss, on_warning)
    if silence then return false end
    local fx0, mu0 = nemesis_engine.sound_factors()
    if not (fx0 and mu0) then return false end
    local hold = nemesis_mcm.get_number("silence_length", 0.75)
    if hold < 0.5 then hold = 0.5 end
    if hold > 1 then hold = 1 end
    owed = nil
    silence = { stage = "fade", t0 = time_global(), fx0 = fx0, mu0 = mu0, set_fx = fx0, set_mu = mu0,
                hold_ms = hold * 1000, boss = boss, on_warning = on_warning }
    dbg("Nemesis: the silence before the warning begins (sound %s, music %s).", string.format("%.2f", fx0), string.format("%.2f", mu0))
    return true
end

function silence_cancel(why)
    if silence then
        silence.on_warning, silence.said = nil, true
        silence_end(why, false)
    end
end

local function owed_tick(gt)
    local fx = nemesis_engine.sound_factors()
    if not fx or fx >= owed.fx0 - 0.01 or gt > owed.until_at then
        owed = nil
        return
    end
    if math.abs(fx - owed.last) > 0.0005 then
        owed.last, owed.since = fx, gt
        return
    end
    if gt - owed.since < SILENCE_STABLE_MS then return end
    nemesis_engine.set_sound_factors(owed.fx0, nil)
    dbg("!Nemesis: the sound volume stayed at %s after the silence; put back to %s.", string.format("%.2f", fx), string.format("%.2f", owed.fx0))
    owed = nil
end

local function silence_step(gt)
    local s = silence
    local fx, mu = nemesis_engine.sound_factors()
    if not (fx and mu) or math.abs(fx - s.set_fx) > 0.001 or math.abs(mu - s.set_mu) > 0.001 then
        return silence_end("another script changed the volume", true)
    end
    local t = gt - s.t0
    local share = 1
    if s.stage == "fade" then
        local k = math.min(1, math.max(0, t) / SILENCE_FADE_MS)
        share = 1 - (1 - SILENCE_FLOOR) * k
        if k >= 1 then s.stage, s.t0 = "hold", gt end
    elseif s.stage == "hold" then
        share = SILENCE_FLOOR
        if t >= s.hold_ms then
            s.stage, s.t0 = "back", gt
            say_warning(s, share)
        end
    else
        local k = math.min(1, math.max(0, t) / SILENCE_BACK_MS)
        share = SILENCE_FLOOR + (1 - SILENCE_FLOOR) * k
        if k >= 1 then return silence_end("the warning is out", false) end
    end
    s.set_fx, s.set_mu = s.fx0 * share, s.mu0 * share
    if not nemesis_engine.set_sound_factors(s.set_fx, s.set_mu) then return silence_end("the volume could not be set", true) end

    s.set_fx, s.set_mu = nemesis_engine.sound_factors()
    raise_held(share)
end

function silence_frame(gt)
    if owed then owed_tick(gt) end
    if not silence then
        if held[1] then raise_held(1) end
        return
    end
    local ok, err = pcall(silence_step, gt)
    if not ok then
        dbg("!Nemesis ERROR: the silence before the warning failed (%s); the volume is put back.", tostring(err))
        silence_end("an error", true)
    end
end

local WARM_DELAY_MS = 5000
local warm_due = nil

function reset_runtime()

    if hum then pcall(function() hum.snd:stop() end) end
    hum = nil
    heart, heart_d, heart_d_at = nil, nil, nil

    if whisper then pcall(function() whisper.snd:stop() end) end
    whisper = nil
    silence_cancel("a load")
    held, owed = {}, nil
    warm_due = time_global() + WARM_DELAY_MS
end

function warm_tick(gt)
    if not warm_due or gt < warm_due then return end
    warm_due = nil
    local paths = { pick("warning static", STATIC_SOUNDS), "anomaly\\teleport_incoming" }
    local l, r = psy_voices()
    paths[#paths + 1] = l
    paths[#paths + 1] = r
    local n = 0
    for _, p in pairs(paths) do

        if p and pcall(function() local s = sound_object(p) end) then n = n + 1 end
    end
    dbg("Nemesis: %s sound files loaded ahead of the first hunt (nothing played).", tostring(n))
end

---------------------------------------------------------------------------
-- Settings: the sound section of the General page
---------------------------------------------------------------------------

function mcm_sound_section()
    return {
        { id = "line_sound", type = "line" },
        { id = "head_sound", type = "title", text = "ui_mcm_nemesis_head_sound", align = "l", clr = nemesis_mcm.HEAD_CLR },
        { id = "warning_volume", type = "track", val = 2, def = 70, min = 0, max = 100, step = 5, prec = 0, hint = "nemesis_warning_volume" },
        { id = "teleport_volume", type = "track", val = 2, def = 40, min = 0, max = 100, step = 5, prec = 0, hint = "nemesis_teleport_volume" },
        { id = "hum_volume", type = "track", val = 2, def = 10, min = 0, max = 100, step = 5, prec = 0, hint = "nemesis_hum_volume" },
        { id = "heartbeat_volume", type = "track", val = 2, def = 30, min = 0, max = 100, step = 5, prec = 0, hint = "nemesis_heartbeat_volume" },
        { id = "heartbeat_top", type = "track", val = 2, def = 140, min = 120, max = 180, step = 5, prec = 0, hint = "nemesis_heartbeat_top" },
        { id = "arrival_call_volume", type = "track", val = 2, def = 50, min = 0, max = 100, step = 5, prec = 0, hint = "nemesis_arrival_call_volume" },
        { id = "arrival_ppe", type = "track", val = 2, def = 40, min = 0, max = 100, step = 5, prec = 0, hint = "nemesis_arrival_ppe" },
        { id = "arrival_escalation", type = "track", val = 2, def = 10, min = 0, max = 25, step = 1, prec = 0, hint = "nemesis_arrival_escalation" },
        { id = "arrival_max", type = "track", val = 2, def = 50, min = 0, max = 100, step = 5, prec = 0, hint = "nemesis_arrival_max" },
        { id = "boss_jolt", type = "check", val = 1, def = false, hint = "nemesis_boss_jolt" },
        { id = "silence_before", type = "check", val = 1, def = true, hint = "nemesis_silence_before" },
        { id = "silence_length", type = "track", val = 2, def = 0.75, min = 0.5, max = 1, step = 0.05, prec = 2, hint = "nemesis_silence_length" },
        { id = "lightning_volume", type = "track", val = 2, def = 0, min = 0, max = 100, step = 5, prec = 0, hint = "nemesis_lightning_volume" },
    }
end
