-- Nemesis State

SAVE_VERSION = 3

S = {}

local function blank()
    return {
        phase = "idle",
        cycle = 1,
        spawned_count = 0,
        first_hunt = nil,
        last_retreat = nil,
        hunt_start = nil,
        faction = nil,
        hunter_ids = {},
        squad_ids = {},
        m = {},
        dying = {},
        sim_squad_id = nil,
        pending_squad = nil,
        retreat_announced = false,
        offline_since = nil,
        seen_online = nil,
        target_restore_logged = nil,
        role_side = nil,
        fx = {},

        boss_id = nil,
        boss_hunt = nil,
        boss_ghost = nil,
        boss_sneak = nil,
        boss_look = nil,
        last_boss_day = nil,
        hunts_since_boss = 0,
        sneak_started = nil,
        sneak_said = nil,
        sneak_wait = nil,
        boss_shots = nil,
        boss_hit_frames = nil,
        boss_hit_frame = nil,
        dread_next = nil,

        spots = {},
        spot_said = nil,

        follow = nil,
        follows = 0,
    }
end

local SPOT_MAX = 5
local SPOT_DAYS = 7
local SPOT_MERGE_M = 20
local SPOT_NEAR_M = 40

local function forget_old_spots(now)
    local keep = {}
    for _, p in ipairs(S.spots) do
        if now - p.t < SPOT_DAYS * 86400 and now >= p.t then keep[#keep + 1] = p end
    end
    S.spots = keep
end

local function flat_dist2(p, pos)
    local dx, dz = p.x - pos.x, p.z - pos.z
    return dx * dx + dz * dz
end

function remember_spot(lvl, pos, now)
    if not lvl or not pos or not now then return end
    forget_old_spots(now)
    for _, p in ipairs(S.spots) do
        if p.lvl == lvl and flat_dist2(p, pos) <= SPOT_MERGE_M * SPOT_MERGE_M then
            p.x, p.y, p.z, p.t = pos.x, pos.y, pos.z, now
            return
        end
    end
    S.spots[#S.spots + 1] = { lvl = lvl, x = pos.x, y = pos.y, z = pos.z, t = now }
    local on_level, oldest = 0, nil
    for i, p in ipairs(S.spots) do
        if p.lvl == lvl then
            on_level = on_level + 1
            if not oldest or p.t < S.spots[oldest].t then oldest = i end
        end
    end
    if on_level > SPOT_MAX then table.remove(S.spots, oldest) end
end

function known_spot(lvl, pos, now)
    if not lvl or not pos or not now then return false end
    for _, p in ipairs(S.spots) do
        if p.lvl == lvl and now - p.t < SPOT_DAYS * 86400 and now >= p.t
            and flat_dist2(p, pos) <= SPOT_NEAR_M * SPOT_NEAR_M then
            return true
        end
    end
    return false
end

local function save_follow_list(list)
    if not list then return nil end
    local out = {}
    for _, e in ipairs(list) do
        out[#out + 1] = string.format("%s~%d~%d~%.2f", tostring(e.name), e.named and 1 or 0, e.boss and 1 or 0, tonumber(e.hp) or 1)
    end
    return table.concat(out, "|")
end

local function load_follow_list(str)
    if not str or str == "" then return nil end
    local out = {}
    for item in string.gmatch(tostring(str), "[^|]+") do
        local n, a, b, h = string.match(item, "^([^~]+)~([01])~([01])~([^~]+)$")
        if n then out[#out + 1] = { name = n, named = a == "1", boss = b == "1", hp = tonumber(h) or 1 } end
    end
    return out
end

local function save_spots()
    local out = {}
    for _, p in ipairs(S.spots) do
        out[#out + 1] = string.format("%s:%.1f:%.1f:%.1f:%d", p.lvl, p.x, p.y, p.z, p.t)
    end
    return table.concat(out, "|")
end

local function load_spots(str)
    local out = {}
    for item in string.gmatch(tostring(str or ""), "[^|]+") do
        local l, x, y, z, t = string.match(item, "^([^:]+):([^:]+):([^:]+):([^:]+):([^:]+)$")
        x, y, z, t = tonumber(x), tonumber(y), tonumber(z), tonumber(t)
        if l and x and y and z and t then out[#out + 1] = { lvl = l, x = x, y = y, z = z, t = t } end
    end
    return out
end

function reset()
    for k in pairs(S) do S[k] = nil end
    for k, v in pairs(blank()) do S[k] = v end
end

reset()

---------------------------------------------------------------------------
-- Members
---------------------------------------------------------------------------

function add_member(id, named, name)
    local r = {
        id = id,
        named = named and true or false,
        name = name,
        inited = false,
        hp_armed = false,
        last_hp = nil,
        grace_until = nil,
        pre_hp = nil,
        pending = false,
        retreat_at = nil,
        cover_until = nil,
        teleport_at = nil,
        cloak_vis = nil,
        cloak_off_at = nil,
        hit_at = nil,
        death = nil,
        dead = false,
        bound = false,
        role_set = false,
        idle_warned = false,
    }
    S.m[id] = r
    local list = r.named and S.hunter_ids or S.squad_ids
    list[#list + 1] = id
    return r
end

local function drop_from(list, id)
    for i = #list, 1, -1 do
        if list[i] == id then table.remove(list, i) end
    end
end

function drop_member(id)
    if not id then return end
    S.m[id] = nil
    S.dying[id] = nil
    drop_from(S.hunter_ids, id)
    drop_from(S.squad_ids, id)
end

function clear_members()
    S.m = {}
    S.hunter_ids = {}
    S.squad_ids = {}
    S.dying = {}
end

function member(id) return id ~= nil and S.m[id] or nil end
function is_member(id) return id ~= nil and S.m[id] ~= nil end
function name_of(id)
    local r = id ~= nil and S.m[id]
    return r and r.name or nil
end
function leader() return S.hunter_ids[1] end

---------------------------------------------------------------------------
-- Save / load
---------------------------------------------------------------------------
local function load_ids(text)
    local ids = {}
    if type(text) ~= "string" then return ids end
    for id in string.gmatch(text, "%d+") do ids[#ids + 1] = tonumber(id) end
    return ids
end

local function load_map(text)
    local map = {}
    if type(text) ~= "string" then return map end
    for id, v in string.gmatch(text, "(%d+)=([^|]+)") do map[tonumber(id)] = v end
    return map
end

function save(mdata, vanish_ids)
    local names, cloak, retreating = {}, {}, {}
    for id, r in pairs(S.m) do
        if r.name then names[#names + 1] = tostring(id) .. "=" .. r.name end
        if r.cloak_vis then cloak[#cloak + 1] = tostring(id) .. "=" .. r.cloak_vis end
        if r.retreat_at then retreating[#retreating + 1] = id end
    end
    local p = S.pending_squad
    mdata.nemesis_state = {
        ver = SAVE_VERSION,
        cycle = S.cycle,
        spawned_count = S.spawned_count,
        first_hunt = S.first_hunt,
        last_retreat = S.last_retreat,
        hunt_start = S.hunt_start,
        faction = S.faction,
        boss_id = S.boss_id,
        boss_hunt = S.boss_hunt and true or nil,
        boss_sneak = S.boss_sneak and true or nil,
        boss_ghost = S.boss_ghost,
        boss_look = S.boss_look,
        last_boss_day = S.last_boss_day,
        hunts_since_boss = S.hunts_since_boss,
        spots = save_spots(),
        follows = S.follows,
        follow = S.follow and save_follow_list(S.follow.members) or nil,
        follow_faction = S.follow and S.follow.faction or nil,
        follow_look = S.follow and S.follow.boss_look or nil,
        follow_boss_hunt = S.follow and S.follow.boss_hunt and true or nil,
        follow_start = S.follow and S.follow.hunt_start or nil,
        follow_lvl = S.follow and S.follow.lvl or nil,
        follow_ax = S.follow and S.follow.ax or nil,
        follow_az = S.follow and S.follow.az or nil,
        squad_follow = p and save_follow_list(p.follow) or nil,
        squad_all_named = p and p.all_named and true or nil,
        hunter_ids = table.concat(S.hunter_ids, ","),
        squad_ids = table.concat(S.squad_ids, ","),
        retreating = table.concat(retreating, ","),
        names = table.concat(names, "|"),
        cloak_vis = table.concat(cloak, "|"),
        squad_left = p and p.left or 0,
        squad_section = p and p.section or "",
        squad_origin = p and p.origin_lv or 0,
        squad_gvid = p and p.gvid or 0,
        sim_squad_id = S.sim_squad_id,
        phase = S.phase,
        vanish = table.concat(vanish_ids or {}, ","),
    }
end

function load(mdata)
    reset()
    local s = mdata and mdata.nemesis_state
    if not s then return {} end
    local vanish = load_ids(s.vanish)

    S.cycle = s.cycle or 1
    S.spawned_count = s.spawned_count or 0
    S.first_hunt = s.first_hunt
    S.last_retreat = s.last_retreat
    S.hunt_start = s.hunt_start
    S.last_boss_day = s.last_boss_day
    S.hunts_since_boss = tonumber(s.hunts_since_boss) or 0
    S.spots = load_spots(s.spots)
    S.follows = tonumber(s.follows) or 0
    local fl = load_follow_list(s.follow)
    if fl and #fl > 0 then
        S.follow = { members = fl, faction = s.follow_faction, boss_look = s.follow_look, boss_hunt = s.follow_boss_hunt and true or nil,
                     hunt_start = s.follow_start, lvl = s.follow_lvl, ax = tonumber(s.follow_ax) or 0, az = tonumber(s.follow_az) or 0 }
        S.hunt_start = S.hunt_start or s.follow_start
    end
    S.boss_ghost = tonumber(s.boss_ghost)
    S.faction = s.faction

    local hunters = load_ids(s.hunter_ids)
    local squad = load_ids(s.squad_ids)
    if #hunters == 0 then return vanish end

    local names = load_map(s.names)
    local cloak = load_map(s.cloak_vis)
    S.phase = "hunting"
    for _, id in ipairs(hunters) do add_member(id, true, names[id]) end
    for _, id in ipairs(squad) do add_member(id, false, names[id]) end
    for id, vis in pairs(cloak) do
        if S.m[id] then S.m[id].cloak_vis = vis end
    end
    local now = time_global()
    for _, id in ipairs(load_ids(s.retreating)) do
        if S.m[id] then S.m[id].retreat_at = now end
    end
    S.boss_id = tonumber(s.boss_id)
    S.boss_hunt = s.boss_hunt and true or nil
    S.boss_sneak = s.boss_sneak and true or nil
    S.boss_look = s.boss_look
    S.sim_squad_id = tonumber(s.sim_squad_id)

    local left = tonumber(s.squad_left) or 0
    if left > 0 and type(s.squad_section) == "string" and s.squad_section ~= "" and (tonumber(s.squad_gvid) or 0) > 0 then
        local used_names = {}
        for _, name in pairs(names) do used_names[name] = true end
        local origin = tonumber(s.squad_origin) or 0
        S.pending_squad = {
            section = s.squad_section,
            origin_lv = origin,
            gvid = tonumber(s.squad_gvid),
            left = left,
            used = { [origin] = true },
            used_names = used_names,
            misses = 0,
            all_named = s.squad_all_named and true or nil,
            follow = load_follow_list(s.squad_follow),
        }
    end
    return vanish
end
