-- Nemesis State: the mod's whole saved state in one table, S, and its member records.
-- Used by: nearly every Nemesis script (nemesis_state.S, member, name_of ...); nemesis_core saves
-- and loads it (save, load) and resets it (reset).
-- Uses: nothing of the mod's: plain Lua tables and strings (time_global for the load's timers).
-- The whole hunt state in one table, S, shared by every Nemesis module (nemesis_state.S).
-- S is never replaced, only refilled (reset), so a module may keep a reference to it.
--
-- Every hunt member has ONE record, S.m[id], made by add_member and dropped by drop_member.
-- A member's data was once spread over about twenty id-keyed tables (before round 39), and a reset
-- that missed one of them left stale data behind for a recycled engine id (the round 30 bugs).
-- A record is created fresh when the member joins, so nothing from an earlier NPC with the
-- same id can leak into it.
--
-- Save format: the same keys as round 37/38 saves (they load unchanged), plus ver.

SAVE_VERSION = 3                   -- written into every save as ver

S = {}                             -- the state; refilled by reset, never replaced

-- A fresh state: every field with its starting value and what it holds (the list below is
-- also the reference for S's fields). Used by reset.
local function blank()
    return {
        phase = "idle",          -- idle | hunting
        cycle = 1,
        spawned_count = 0,
        first_hunt = nil,        -- game seconds the mod first ran in this game
        last_retreat = nil,      -- game seconds the last hunt ended (cooldown)
        hunt_start = nil,        -- game seconds the running hunt spawned (time limit)
        faction = nil,           -- "monolith", or "isg" when the player is Monolith, Zombified or Sin
        hunter_ids = {},         -- named hunters in spawn order; the first is the leader
        squad_ids = {},          -- regular members
        m = {},                  -- [id] = member record (add_member)
        dying = {},              -- [id] = true: a death the next frame handles
        sim_squad_id = nil,      -- the hunt's simulation squad
        pending_squad = nil,     -- extras still waiting for their own vertex
        retreat_announced = false,
        offline_since = nil,
        seen_online = nil,
        target_restore_logged = nil,
        role_side = nil,         -- flank side handed to the last extra
        fx = {},                 -- recent particle and sound objects (kept alive while they play)
        -- the boss
        boss_id = nil,           -- the boss of the running hunt
        boss_hunt = nil,         -- he was in this hunt (beating it halves the cycle)
        boss_ghost = nil,        -- the last boss, until he is confirmed gone
        boss_sneak = nil,        -- his approach is running (until he opens fire)
        boss_look = nil,         -- his model
        last_boss_day = nil,     -- in-game day of the last boss (once a day)
        hunts_since_boss = 0,    -- hunts since the last boss (his chance climbs with it)
        sneak_started = nil,
        sneak_said = nil,        -- when his line went out
        sneak_wait = nil,        -- ms from his line to opening fire (5 s behind you, 1.5 s running)
        boss_shots = nil,        -- shots he has fired this hunt (his first ones always miss)
        boss_hit_frames = nil,   -- frames in which his hits reached you (the same, if shots are not counted)
        boss_hit_frame = nil,
        dread_next = nil,
        -- where you beat them (round 64): { lvl, x, y, z, t } (t: game seconds)
        spots = {},
        spot_said = nil,         -- this hunt's "same spot" line went out
        -- they follow you to another map (round 65)
        follow = nil,            -- { members = { {name, named, boss, hp} }, faction, boss_look, boss_hunt, hunt_start, lvl, ax, az }
        follows = 0,             -- changes of map they followed this hunt
        stash_owed = nil,        -- the boss's name: his stash reward is still to be marked (round 66)
        -- the emission boss (round 93); the rest of his state is his module's own (round 115)
        emission_hunt = nil,     -- this hunt is his (nemesis_emission)
        reload_said = nil,       -- the boss's "Reloading?" line went out this hunt
        reserved = {},           -- [body id] = { t = game seconds you killed him, sec = his section } (round 76/79)
    }
end

---------------------------------------------------------------------------
-- Remembered spots (user design): where you stood when a named hunter broke off from your
-- hits. Up to SPOT_MAX per level, each forgotten after SPOT_DAYS in-game days. A later hunt
-- that finds you within SPOT_NEAR_M of one knows where you are.
---------------------------------------------------------------------------
local SPOT_MAX = 5
local SPOT_DAYS = 7
local SPOT_MERGE_M = 20          -- a new spot this close to an old one refreshes it
local SPOT_NEAR_M = 40

-- Drops the remembered spots older than SPOT_DAYS (or from the future, after a time change),
-- at game time now (seconds).
local function forget_old_spots(now)
    local keep = {}
    for _, p in ipairs(S.spots) do
        if now - p.t < SPOT_DAYS * 86400 and now >= p.t then keep[#keep + 1] = p end
    end
    S.spots = keep
end

-- The squared distance between spot p and position pos on the ground (height left out).
local function flat_dist2(p, pos)
    local dx, dz = p.x - pos.x, p.z - pos.z
    return dx * dx + dz * dz
end

-- Remembers spot pos on level lvl at game time now: refreshes a spot within SPOT_MERGE_M, else
-- adds one and drops the oldest past SPOT_MAX on that level. Called by nemesis_core when you
-- beat a hunt, so later hunters know where you fought them.
function remember_spot(lvl, pos, now)
    if not lvl or not pos or not now then return end
    forget_old_spots(now)
    for _, p in ipairs(S.spots) do
        if p.lvl == lvl and flat_dist2(p, pos) <= SPOT_MERGE_M * SPOT_MERGE_M then
            p.x, p.y, p.z, p.t = pos.x, pos.y, pos.z, now
            return
        end
    end
    S.spots[#S.spots + 1] = { lvl = lvl, x = pos.x, y = pos.y, z = pos.z, t = now }
    local on_level, oldest = 0, nil
    for i, p in ipairs(S.spots) do
        if p.lvl == lvl then
            on_level = on_level + 1
            if not oldest or p.t < S.spots[oldest].t then oldest = i end
        end
    end
    if on_level > SPOT_MAX then table.remove(S.spots, oldest) end
end

-- Whether pos on level lvl is within SPOT_NEAR_M of a spot remembered in the last SPOT_DAYS;
-- reach_factor (1 when not given) widens that radius (the Hunt's Eye on a targeted map: they
-- know your ground better, round 164). Called by nemesis_core, which then tells the chase that
-- they know where you are.
function known_spot(lvl, pos, now, reach_factor)
    if not lvl or not pos or not now then return false end
    local near_m = SPOT_NEAR_M * math.max(1, tonumber(reach_factor) or 1)
    for _, p in ipairs(S.spots) do
        if p.lvl == lvl and now - p.t < SPOT_DAYS * 86400 and now >= p.t
            and flat_dist2(p, pos) <= near_m * near_m then
            return true
        end
    end
    return false
end

-- Follow list: "name~named~boss~hp|..." (names hold no ~ or |).
local function save_follow_list(list)
    if not list then return nil end
    local out = {}
    for _, e in ipairs(list) do
        out[#out + 1] = string.format("%s~%d~%d~%.2f", tostring(e.name), e.named and 1 or 0, e.boss and 1 or 0, tonumber(e.hp) or 1)
    end
    return table.concat(out, "|")
end

-- The follow list back from its save string (save_follow_list's format); nil when empty.
local function load_follow_list(str)
    if not str or str == "" then return nil end
    local out = {}
    for item in string.gmatch(tostring(str), "[^|]+") do
        local n, a, b, h = string.match(item, "^([^~]+)~([01])~([01])~([^~]+)$")
        if n then out[#out + 1] = { name = n, named = a == "1", boss = b == "1", hp = tonumber(h) or 1 } end
    end
    return out
end

-- The remembered spots as one save string: "level:x:y:z:time|...".
local function save_spots()
    local out = {}
    for _, p in ipairs(S.spots) do
        out[#out + 1] = string.format("%s:%.1f:%.1f:%.1f:%d", p.lvl, p.x, p.y, p.z, p.t)
    end
    return table.concat(out, "|")
end

-- The reserved bodies (Reserve your kills) as one save string: "id:time:section,...".
local function save_reserved()
    local out = {}
    for id, v in pairs(S.reserved) do
        out[#out + 1] = string.format("%d:%d:%s", id, math.floor(v.t), v.sec or "")
    end
    return table.concat(out, ",")
end

-- The reserved bodies back from save_reserved's string: { [id] = { t, sec } }.
local function load_reserved(str)
    local out = {}
    for id, t, sec in string.gmatch(tostring(str or ""), "(%d+):(%d+):([%w_]*)") do
        out[tonumber(id)] = { t = tonumber(t), sec = sec ~= "" and sec or nil }
    end
    return out
end

-- The remembered spots back from save_spots' string; a malformed item is skipped.
local function load_spots(str)
    local out = {}
    for item in string.gmatch(tostring(str or ""), "[^|]+") do
        local l, x, y, z, t = string.match(item, "^([^:]+):([^:]+):([^:]+):([^:]+):([^:]+)$")
        x, y, z, t = tonumber(x), tonumber(y), tonumber(z), tonumber(t)
        if l and x and y and z and t then out[#out + 1] = { lvl = l, x = x, y = y, z = z, t = t } end
    end
    return out
end

-- Empties S and refills it with blank()'s fields, in place: S is never replaced, so every
-- script's reference to it stays good. Called here at load time of this file and by
-- nemesis_core (a new game, or a save without Nemesis data).
function reset()
    for k in pairs(S) do S[k] = nil end
    for k, v in pairs(blank()) do S[k] = v end
end

reset()

---------------------------------------------------------------------------
-- Members
---------------------------------------------------------------------------
-- named: a named hunter (escalation, retreat, cloak, boss) or a regular extra.
function add_member(id, named, name)
    local r = {
        id = id,
        named = named and true or false,
        name = name,
        inited = false,          -- seen online once (relations, retreat grace, health armed)
        hp_armed = false,        -- a real health reading is stored in last_hp
        last_hp = nil,           -- health after the last check or hit
        grace_until = nil,       -- time_global before which he cannot retreat
        hit_cut = nil,           -- an engine hit was cut before it landed (the hit callback)
        hit_pre = nil,           -- his health just before that hit
        bh_frame = nil,          -- time_global of the last hit seen by "before hit" (round 88)
        bypass_guard = nil,      -- invulnerable for a lethal hit that skipped "before hit"
        mask_vis = nil,          -- his own model while masked for a possibly lethal hit
        pending = false,         -- a hit asked for the retreat; the tick starts it
        retreat_at = nil,        -- time_global he broke off
        cover_until = nil,       -- time_global by which he must have teleported
        teleport_at = nil,       -- time_global of the burst (vanish timer)
        cloak_vis = nil,         -- his own model while cloaked (saved)
        cloak_off_at = nil,      -- time_global he last reappeared
        hit_at = nil,            -- time_global of the last hit he took
        death = nil,             -- { teleport = bool }, set by the death callback
        dead = false,            -- the death callback fired
        bound = false,           -- squad relations have been set
        role_set = false,        -- extra: tactic role handed to the chase
        idle_warned = false,     -- diagnostic: "chase action has not run" logged
    }
    S.m[id] = r
    local list = r.named and S.hunter_ids or S.squad_ids
    list[#list + 1] = id
    return r
end

-- Removes every entry id from the id list list (hunter_ids, squad_ids).
local function drop_from(list, id)
    for i = #list, 1, -1 do
        if list[i] == id then table.remove(list, i) end
    end
end

-- Drops member id: his record, his pending death and his place in the hunter and squad lists.
-- Called by nemesis_member when he is gone for good.
function drop_member(id)
    if not id then return end
    S.m[id] = nil
    S.dying[id] = nil
    drop_from(S.hunter_ids, id)
    drop_from(S.squad_ids, id)
end

-- Drops every member at once. Called by nemesis_core and nemesis_spawn at a hunt's end and start.
function clear_members()
    S.m = {}
    S.hunter_ids = {}
    S.squad_ids = {}
    S.dying = {}
end

-- Member id's record (S.m[id]), or nil when he is no member. The most called read of the mod.
function member(id) return id ~= nil and S.m[id] or nil end
-- Whether id is a member now. Called by nemesis_core and nemesis_guard.
function is_member(id) return id ~= nil and S.m[id] ~= nil end
-- Member id's name (the one his PDA lines carry), or nil.
function name_of(id)
    local r = id ~= nil and S.m[id]
    return r and r.name or nil
end
-- A regular who is not dead (a body you left stays listed as a corpse).
function regular_alive(id)
    local r = S.m[id]
    return r ~= nil and not r.death and not r.dead
end

-- The hunt lasts while anyone is left (round 82, user rule): a named hunter, or a living
-- regular. When the last named hunter is gone the regulars keep hunting you. Members still to
-- come count too (round 121): a squad fills one stalker every 750 ms (nemesis_spawn.fill_squad),
-- so a boss killed before his first escort joined used to end the hunt and drop the escort.
-- Every way the filling can fail clears S.pending_squad, so this never keeps a hunt alive for
-- nobody.
function members_left()
    if #S.hunter_ids > 0 then return true end
    local p = S.pending_squad
    if p and (p.left or 0) > 0 then return true end
    for _, id in ipairs(S.squad_ids) do
        if regular_alive(id) then
            return true
        end
    end
    return false
end

-- The first named hunter; with none left, the first living regular (for the PDA lines).
function leader()
    if S.hunter_ids[1] then return S.hunter_ids[1] end
    for _, id in ipairs(S.squad_ids) do
        if regular_alive(id) then
            return id
        end
    end
    return nil
end

---------------------------------------------------------------------------
-- Save / load
---------------------------------------------------------------------------
local function load_ids(text)
    local ids = {}
    if type(text) ~= "string" then return ids end
    for id in string.gmatch(text, "%d+") do ids[#ids + 1] = tonumber(id) end
    return ids
end

-- An "id=value|..." save string back as { [id] = value } (the names, models, health).
local function load_map(text)
    local map = {}
    if type(text) ~= "string" then return map end
    for id, v in string.gmatch(text, "(%d+)=([^|]+)") do map[tonumber(id)] = v end
    return map
end

-- vanish_ids: teleports still waiting for removal (nemesis_fx), so an invisible hunter or
-- body is not left in the world after a load.
function save(mdata, vanish_ids)
    local names, cloak, mask, retreating, struck, hps, dead = {}, {}, {}, {}, {}, {}, {}
    for id, r in pairs(S.m) do
        if r.name then names[#names + 1] = tostring(id) .. "=" .. r.name end
        if r.cloak_vis then cloak[#cloak + 1] = tostring(id) .. "=" .. r.cloak_vis end
        if r.mask_vis then mask[#mask + 1] = tostring(id) .. "=" .. r.mask_vis end
        if r.retreat_at then retreating[#retreating + 1] = id end
        if r.player_struck then struck[#struck + 1] = id end
        -- A change of map is a save and a load (found in round 87). Health and bodies must outlive it, the
        -- hunters are offline on the old map by then and cannot be read again.
        if r.last_hp then hps[#hps + 1] = tostring(id) .. "=" .. string.format("%.3f", r.last_hp) end
        if r.dead or r.death then dead[#dead + 1] = id end
    end
    local p = S.pending_squad
    mdata.nemesis_state = {
        ver = SAVE_VERSION,
        cycle = S.cycle,
        spawned_count = S.spawned_count,
        first_hunt = S.first_hunt,
        last_retreat = S.last_retreat,
        hunt_start = S.hunt_start,
        faction = S.faction,
        boss_id = S.boss_id,
        boss_hunt = S.boss_hunt and true or nil,
        boss_sneak = S.boss_sneak and true or nil,
        boss_ghost = S.boss_ghost,
        boss_look = S.boss_look,
        last_boss_day = S.last_boss_day,
        hunts_since_boss = S.hunts_since_boss,
        spots = save_spots(),
        follows = S.follows,
        stash_owed = S.stash_owed,
        reserved = save_reserved(),
        follow = S.follow and save_follow_list(S.follow.members) or nil,
        follow_faction = S.follow and S.follow.faction or nil,
        follow_look = S.follow and S.follow.boss_look or nil,
        follow_boss_hunt = S.follow and S.follow.boss_hunt and true or nil,
        follow_start = S.follow and S.follow.hunt_start or nil,
        follow_lvl = S.follow and S.follow.lvl or nil,
        follow_ax = S.follow and S.follow.ax or nil,
        follow_az = S.follow and S.follow.az or nil,
        follow_emission = S.follow and S.follow.emission_hunt and true or nil,
        emission_hunt = S.emission_hunt and true or nil,
        reload_said = S.reload_said and true or nil,
        squad_follow = p and save_follow_list(p.follow) or nil,
        squad_all_named = p and p.all_named and true or nil,
        hunter_ids = table.concat(S.hunter_ids, ","),
        squad_ids = table.concat(S.squad_ids, ","),
        retreating = table.concat(retreating, ","),
        names = table.concat(names, "|"),
        cloak_vis = table.concat(cloak, "|"),
        mask_vis = table.concat(mask, "|"),
        struck = table.concat(struck, ","),
        hps = table.concat(hps, "|"),
        dead = table.concat(dead, ","),
        squad_left = p and p.left or 0,
        squad_section = p and p.section or "",
        squad_origin = p and p.origin_lv or 0,
        squad_gvid = p and p.gvid or 0,
        sim_squad_id = S.sim_squad_id,
        phase = S.phase,
        vanish = table.concat(vanish_ids or {}, ","),
    }
end

-- Returns the ids to remove after the load (pending teleports).
function load(mdata)
    reset()
    local s = mdata and mdata.nemesis_state
    if not s then return {} end
    local vanish = load_ids(s.vanish)

    S.cycle = s.cycle or 1
    S.spawned_count = s.spawned_count or 0
    S.first_hunt = s.first_hunt
    S.last_retreat = s.last_retreat
    S.hunt_start = s.hunt_start
    S.last_boss_day = s.last_boss_day
    S.hunts_since_boss = tonumber(s.hunts_since_boss) or 0
    S.spots = load_spots(s.spots)
    S.follows = tonumber(s.follows) or 0
    if type(s.stash_owed) == "string" and s.stash_owed ~= "" then S.stash_owed = s.stash_owed end
    S.reserved = load_reserved(s.reserved)
    local fl = load_follow_list(s.follow)
    if fl and #fl > 0 then
        S.follow = { members = fl, faction = s.follow_faction, boss_look = s.follow_look, boss_hunt = s.follow_boss_hunt and true or nil,
                     hunt_start = s.follow_start, lvl = s.follow_lvl, ax = tonumber(s.follow_ax) or 0, az = tonumber(s.follow_az) or 0,
                     emission_hunt = s.follow_emission and true or nil }
        S.hunt_start = S.hunt_start or s.follow_start
    end
    S.boss_ghost = tonumber(s.boss_ghost)
    S.faction = s.faction
    S.reload_said = s.reload_said and true or nil

    local hunters = load_ids(s.hunter_ids)
    local squad = load_ids(s.squad_ids)
    -- Only regulars left is still a hunt (round 82); before round 87 a load dropped it.
    if #hunters == 0 and #squad == 0 then return vanish end

    local names = load_map(s.names)
    local cloak = load_map(s.cloak_vis)
    S.phase = "hunting"
    for _, id in ipairs(hunters) do add_member(id, true, names[id]) end
    for _, id in ipairs(squad) do add_member(id, false, names[id]) end
    for id, vis in pairs(cloak) do
        if S.m[id] then S.m[id].cloak_vis = vis end
    end
    -- A member masked in the save comes back masked (round 79) and is restored on the first
    -- frame; the boss you already shot stays a normal enemy and never cloaks again.
    for id, vis in pairs(load_map(s.mask_vis)) do
        if S.m[id] then S.m[id].mask_vis = vis end
    end
    for _, id in ipairs(load_ids(s.struck)) do
        if S.m[id] then S.m[id].player_struck = true end
    end
    for id, v in pairs(load_map(s.hps)) do
        local hp = tonumber(v)
        if S.m[id] and hp and hp > 0.05 and hp <= 1 then S.m[id].last_hp = hp end
    end
    -- A body left in the hunt stays a body (it is listed as a corpse, round 82).
    for _, id in ipairs(load_ids(s.dead)) do
        if S.m[id] then
            S.m[id].dead = true
            S.m[id].death = { teleport = false }
        end
    end
    local now = time_global()
    for _, id in ipairs(load_ids(s.retreating)) do
        if S.m[id] then S.m[id].retreat_at = now end
    end
    S.boss_id = tonumber(s.boss_id)
    S.boss_hunt = s.boss_hunt and true or nil
    S.boss_sneak = s.boss_sneak and true or nil
    S.boss_look = s.boss_look
    S.emission_hunt = s.emission_hunt and true or nil
    S.sim_squad_id = tonumber(s.sim_squad_id)

    local left = tonumber(s.squad_left) or 0
    if left > 0 and type(s.squad_section) == "string" and s.squad_section ~= "" and (tonumber(s.squad_gvid) or 0) > 0 then
        local used_names = {}
        for _, name in pairs(names) do used_names[name] = true end
        local origin = tonumber(s.squad_origin) or 0
        S.pending_squad = {
            section = s.squad_section,
            origin_lv = origin,
            gvid = tonumber(s.squad_gvid),
            left = left,
            used = { [origin] = true },
            used_names = used_names,
            misses = 0,
            all_named = s.squad_all_named and true or nil,
            follow = load_follow_list(s.squad_follow),
        }
    end
    return vanish
end
