-- Nemesis Utilities

local DEFAULT_NAME = "Bogdan Kravets"

local epoch = nil

function debug_on() return nemesis_mcm.get_bool("debug_logs", false) end

function log_msg(...)
    if not debug_on() then return end
    printf(...)
end

---------------------------------------------------------------------------
-- Time
---------------------------------------------------------------------------

function game_seconds()
    if not epoch then
        epoch = game.CTime()
        epoch:set(2000, 1, 1, 0, 0, 0, 0)
    end
    return game.get_game_time():diffSec(epoch)
end

function same_level(se_a, se_b)
    if not se_a or not se_b then return nil end
    local ok, a, b = pcall(function()
        return xlevel.get_level_id(se_a), xlevel.get_level_id(se_b)
    end)
    if not ok or not a or not b then return nil end
    return a == b
end

---------------------------------------------------------------------------
-- Settings-derived values
---------------------------------------------------------------------------

function get_npc_name()
    return nemesis_mcm.get_string("npc_name", DEFAULT_NAME)
end

local FIRST_NAMES = {
    "Dmitri", "Sergei", "Ivan", "Mykola", "Andrei", "Alexei", "Viktor", "Pavel",
    "Igor", "Oleg", "Boris", "Mikhail", "Yuri", "Roman", "Taras",
    "Vasyl", "Petro", "Stepan", "Yaroslav", "Volodymyr", "Leonid", "Maksym", "Vadim",
    "Artem", "Konstantin", "Gennadiy", "Arkadiy", "Ostap", "Fedir", "Anatoliy",
}

local LAST_NAMES = {
    "Shevchenko", "Kravchenko", "Petrenko", "Kovalenko", "Bondarenko", "Savchenko",
    "Tkachenko", "Marchenko", "Rudenko", "Lysenko", "Boyko", "Melnyk",
    "Kovalchuk", "Shevchuk", "Bondarchuk", "Polishchuk", "Kravchuk", "Tarasyuk",
    "Sotkinov", "Volkov", "Sokolov", "Morozov", "Lebedev", "Novikov",
    "Kozlov", "Orlov", "Fedorov", "Smirnov", "Popov", "Belov",
}

function set_health(obj, v)
    if not obj or not v then return false end
    if v < 0 then v = 0 end
    if v > 1 then v = 1 end
    return pcall(function() obj:set_health_ex(v) end)
end

local function compose_name()
    return FIRST_NAMES[math.random(#FIRST_NAMES)] .. " " .. LAST_NAMES[math.random(#LAST_NAMES)]
end

local RANKS = {
    monolith = { "Acolyte", "Disciple", "Zealot", "Sentinel", "Templar", "Herald" },
    isg = { "Sergeant", "Lieutenant", "Captain", "Major", "Specialist", "Operative" },
}

local function rank()
    local list = RANKS[nemesis_state.S.faction] or RANKS.monolith
    return list[math.random(#list)]
end

function next_hunter_name(used, named)
    used = used or {}
    local boss = get_npc_name()
    local name = nil
    for _ = 1, 24 do
        name = compose_name()
        if named then name = rank() .. " " .. name end
        if not used[name] and name ~= boss then break end
    end
    if name == boss then name = (named and rank() .. " " or "") .. "Taras Kravchuk" end
    used[name] = true
    return name
end

function get_escalation(cycle)
    local speed = nemesis_mcm.get_number("escalation_speed", 1.1)
    if speed < 1 then speed = 1 end
    local cap = nemesis_mcm.get_number("max_escalation", 3)
    if cap < 1 then cap = 1 end
    local v = speed ^ math.max(0, (cycle or 1) - 1)
    if v > cap then v = cap end
    return v
end

function get_retreat_health(cycle)
    local base = nemesis_mcm.get_number("retreat_health", 25) / 100
    local v = base / get_escalation(cycle)
    if v < 0.10 then v = 0.10 end
    if v > 0.9 then v = 0.9 end
    return v
end

function br_gains(cycle)
    local notch = nemesis_mcm.get_number("br_escalation", 0)
    if notch < -5 or notch > 5 then notch = 0 end
    local span = math.abs(notch) * 0.3
    local mult = 1 + span
    if notch < 0 then mult = 1 / mult end

    local br_cap = nemesis_mcm.get_number("br_class_cap", 0.2)
    if br_cap < 0 then br_cap = 0 end
    if br_cap > 1 then br_cap = 1 end
    local pct_cap = nemesis_mcm.get_number("br_pct_cap", 25)
    if pct_cap < 5 then pct_cap = 5 end
    if pct_cap > 50 then pct_cap = 50 end
    pct_cap = pct_cap / 100
    local steps = math.max(0, (cycle or 1) - 1)
    local share = steps * mult / 10
    local br = math.min(br_cap, br_cap * share)
    local pct = math.min(pct_cap, pct_cap * share)
    return br, pct
end

function obrien_item_stats(sec, cond)
    local br = ini_sys:r_float_ex(sec, "br_class") or 0
    local pct = ini_sys:r_float_ex(sec, "hit_fraction_actor") or 0
    return br * cond, pct * cond
end

local obrien_warned = false
function warn_obrien_off(sec)
    if obrien_warned then return end
    local has = false
    pcall(function() has = ini_sys:line_exist(sec, "br_class") end)
    if has then
        obrien_warned = true
        log_msg("!Nemesis: your armour has br_class (Obrien GAMMA Overhaul) but the MCM option 'Obrien GAMMA Overhaul armour' is off. Hunters will get far too much armour; turn it on.")
    end
end

function player_br_stats()
    local body_br, head_br, body_pct, head_pct = 0, 0, 0, 0
    local body_hf, head_hf = 1, 1
    local obrien = nemesis_mcm.get_bool("obrien_armor", false)
    local actor = db.actor
    if not actor then return body_br, head_br, body_pct, head_pct, body_hf, head_hf end
    pcall(function()
        local outfit = actor:item_in_slot(7)
        if outfit then
            local cond = outfit:condition() or 1
            if obrien then
                body_br, body_pct = obrien_item_stats(outfit:section(), cond)
            else
                local hf = ini_sys:r_float_ex(outfit:section(), "hit_fraction_actor")
                if hf then body_br = (1 - hf) * cond; body_hf = hf end
                local c = outfit:cast_CustomOutfit()
                if c and BoneID and BoneID["bip01_spine"] then
                    body_pct = (c:GetBoneArmor(BoneID["bip01_spine"]) or 0) * cond * 0.80
                end
                warn_obrien_off(outfit:section())
            end
        end
        local helmet = actor:item_in_slot(12)
        if helmet then
            local cond = helmet:condition() or 1
            if obrien then
                head_br, head_pct = obrien_item_stats(helmet:section(), cond)
            else
                local hf = ini_sys:r_float_ex(helmet:section(), "hit_fraction_actor")
                if hf then head_br = (1 - hf) * cond; head_hf = hf end
                local c = helmet:cast_Helmet()
                if c and BoneID and BoneID["bip01_head"] then
                    head_pct = (c:GetBoneArmor(BoneID["bip01_head"]) or 0) * cond * 0.80
                end
                warn_obrien_off(helmet:section())
            end
        end
    end)
    local function clamp_br(v)
        if not v or v < 0 then return 0 end
        return v
    end
    local function clamp_pct(v)
        if not v or v < 0 then return 0 end
        if v > 0.90 then return 0.90 end
        return v
    end
    local function clamp_hf(v)
        if not v or v > 1 then return 1 end
        if v < 0.05 then return 0.05 end
        return v
    end
    return clamp_br(body_br), clamp_br(head_br), clamp_pct(body_pct), clamp_pct(head_pct),
        clamp_hf(body_hf), clamp_hf(head_hf)
end

---------------------------------------------------------------------------
-- Spawn sections
---------------------------------------------------------------------------

function player_community()
    local comm = nil
    pcall(function() comm = get_actor_true_community() end)
    if type(comm) ~= "string" then pcall(function() comm = db.actor:character_community() end) end
    if type(comm) == "string" then comm = string.gsub(comm, "^actor_", "") end
    return type(comm) == "string" and comm or nil
end

function faction_for_player()
    return player_community() == "monolith" and "isg" or "monolith"
end

local function hunt_faction() return nemesis_state.S.faction == "isg" and "isg" or "monolith" end

local SQUADS = { monolith = "nemesis_hunter_squad", isg = "nemesis_hunter_squad_isg" }

function resolve_squad_section(faction)
    local sec = SQUADS[faction] or SQUADS.monolith
    if ini_sys:section_exist(sec) then return sec end
    log_msg("!Nemesis ERROR: squad section %s not found (squad_descr_nemesis.ltx is not loaded).", sec)
    return nil
end

local MEMBER_POOL = {
    monolith = { "sim_default_monolith_3", "sim_default_monolith_2", "sim_default_monolith_4",
                 "sim_default_monolith_1", "sim_monolith_sniper" },
    isg = { "sim_default_isg_3", "sim_default_isg_4", "sim_default_isg_2", "sim_default_isg_1" },
}

function pick_member_section(faction)
    local pool = {}
    for _, sect in ipairs(MEMBER_POOL[faction] or MEMBER_POOL.monolith) do
        if ini_sys:section_exist(sect) then pool[#pool + 1] = sect end
    end
    if #pool == 0 then return nil end
    return pool[math.random(#pool)]
end

---------------------------------------------------------------------------
-- Chase movement
---------------------------------------------------------------------------

local CHASE_REFRESH_MS = 6000

local RESEND_MS = 250
local SNEAK_REFRESH_MS = 1500
local SPRINT_FROM_M = 50
local CLOSE_THREAT_M = 30

local CONTACT_LINGER_MS = 8000
local HIT_CONTACT_MS = 1500

local SHOW_EVERY_MS = 1000
local HOLD_MAX_MS = 4000
local SCAN_MS = 500
local fight_memo = {}

local roles = {}
local retreat_dest = {}
local focus = {}
local sneak = {}
local chase = {}

local function copy_vec(v)
    local c = vector()
    c:set(v.x, v.y, v.z)
    return c
end

function reset_chase(id)
    if id then
        chase[id] = nil
    else
        chase = {}
        fight_memo = {}
    end
end

function retreat_arrived(npc)
    local vid = npc and retreat_dest[npc:id()]
    if not vid then return true end
    local here = false
    pcall(function()
        here = npc:level_vertex_id() == vid or npc:position():distance_to(level.vertex_position(vid)) < 1.5
    end)
    return here
end

function forget_fight(id)
    if not id then return end
    fight_memo[id] = nil
    roles[id] = nil
    retreat_dest[id] = nil
    focus[id] = nil
    sneak[id] = nil
end

function set_focus(id, on) if id then focus[id] = on and true or nil end end

function set_sneak(id, on)
    if not id then return end
    if on then sneak[id] = sneak[id] or { done = false } else sneak[id] = nil end
end
function sneak_active(id) local s = id and sneak[id]; return s ~= nil and not s.done end
function set_sneak_hold(id, on) local s = id and sneak[id]; if s then s.hold = on and true or nil end end
local function sneak_holding(id) local s = id and sneak[id]; return s ~= nil and s.hold == true end
local function sneak_closing(id) local s = id and sneak[id]; return s ~= nil and s.closing == true end

local MOVE_SAMPLE_MS = 500
local MOVE_RUN_MPS = 2.5
local MOVE_JUMP_M = 50
local move_at, move_x, move_z, move_running = nil, nil, nil, false
function player_running(actor)
    local now = time_global()
    if move_at and now - move_at < MOVE_SAMPLE_MS and now >= move_at then return move_running end
    local p = nil
    pcall(function() p = actor:position() end)
    if not p then return move_running end
    if move_at and now > move_at then
        local dx, dz = p.x - move_x, p.z - move_z
        local d = math.sqrt(dx * dx + dz * dz)
        if d <= MOVE_JUMP_M then move_running = d / ((now - move_at) / 1000) > MOVE_RUN_MPS end
    end
    move_at, move_x, move_z = now, p.x, p.z
    return move_running
end
function reset_movement() move_at, move_x, move_z, move_running = nil, nil, nil, false end
function end_sneak(id, fight)
    local s = id and sneak[id]
    if s then s.done = true end
    local memo = id and fight_memo[id]
    if fight then
        if not memo then memo = { scan_at = 0, scan_hit = false, last_fight = 0 }; fight_memo[id] = memo end
        memo.last_fight = time_global()
    end
    if memo then memo.res_at = -1000000 end
end

function pick_dest(npc, pos, lv)
    if not pos then return nil end
    lv = lv or level.vertex_id(pos)
    local reachable = false
    local ok_acc, acc = pcall(function() return npc:accessible(pos) end)
    if ok_acc then reachable = acc end
    if not reachable then
        local ok_near, near = pcall(function()
            return npc:accessible_nearest(pos, vector())
        end)
        if ok_near and near and near < 4294967295 then
            lv = near
            local vp = level.vertex_position(near)
            if vp then pos = vp end
        end
    end
    if not lv or lv >= 4294967295 or not pos then return nil end
    return lv, copy_vec(pos)
end

local fight_range_cache, fight_range_at = 70, -1000000
local function fight_range()
    local now = time_global()
    if now - fight_range_at >= 1000 then
        fight_range_at = now
        local r = nemesis_mcm.get_number("fight_range", 70)
        if r < 10 then r = 10 end
        if r > 150 then r = 150 end
        fight_range_cache = r
    end
    return fight_range_cache
end

local function _dist(a, b) return a:position():distance_to(b:position()) end
local function _see(a, b) return a:see(b) end
local function _best_enemy(npc) return npc:best_enemy() end

local function sees_player(npc, range)
    local actor = db.actor
    if not actor then return false end
    local ok, d = pcall(_dist, npc, actor)
    if not ok or d > range then return false end
    local ok2, seen = pcall(_see, npc, actor)
    return ok2 and seen == true
end

local function _threat(npc, be, range)
    if be:id() == 0 or not be:alive() then return false end
    if npc:relation(be) ~= game_object.enemy then return false end
    local d = npc:position():distance_to(be:position())
    if d <= CLOSE_THREAT_M then return true end
    return d <= range and npc:see(be)
end

local function hostile_near(npc, range)
    local ok, be = pcall(_best_enemy, npc)
    if not ok or not be then return false end
    local ok2, hit = pcall(_threat, npc, be, range)
    return ok2 and hit == true
end

local OWNS_CACHE_MS = 100
function combat_owns(npc)
    if not npc then return false end
    local id = npc:id()
    local memo = fight_memo[id]
    if not memo then
        memo = { scan_at = 0, scan_hit = false, last_fight = 0, res_at = -1000000, res = false }
        fight_memo[id] = memo
    end
    local now = time_global()
    if now - memo.res_at < OWNS_CACHE_MS then return memo.res end
    memo.res_at = now
    memo.res = combat_owns_now(npc, memo, now)
    return memo.res
end

local function hit_contact(id, now)
    local r = nemesis_state.member(id)
    if not (r and r.hit_at and now - r.hit_at < HIT_CONTACT_MS) then return false end
    return r.hit_by_player == true or not focus[id]
end

local function _show_enemy(npc, enemy) return xcombat.show_enemy(npc, enemy) end

function combat_owns_now(npc, memo, now)
    local id = npc:id()
    if sneak_active(id) then return false end
    local range = fight_range()
    local sees = sees_player(npc, range)
    local hit = hit_contact(id, now)
    local contact = sees or hit
    if not contact and not focus[id] then
        if now - memo.scan_at >= SCAN_MS then
            memo.scan_at = now
            memo.scan_hit = hostile_near(npc, range)
        end
        contact = memo.scan_hit
    end
    if contact then memo.last_fight = now end
    local okb, be = pcall(_best_enemy, npc)
    if okb and be then
        memo.hold_start, memo.holding = nil, false
        return contact or now - memo.last_fight < CONTACT_LINGER_MS
    end
    local r = (sees or hit) and nemesis_state.member(id)
    local player_contact = sees or (hit and r and r.hit_by_player == true)
    if player_contact and db.actor then
        if now - (memo.shown_at or -1000000) >= SHOW_EVERY_MS then
            memo.shown_at = now
            pcall(_show_enemy, npc, db.actor)
        end
        memo.hold_start = memo.hold_start or now
        memo.holding = now - memo.hold_start < HOLD_MAX_MS
    else
        memo.hold_start, memo.holding = nil, false
    end
    return false
end

function contact_hold(id)
    local memo = id and fight_memo[id]
    return memo ~= nil and memo.holding == true
end

---------------------------------------------------------------------------
-- Tactics (Batch D), built on xlibs xcombat (the primitives AlifeTactics uses)
---------------------------------------------------------------------------

local LKP_GIVE_UP_MS = 60000
local FLANK_MIN_M = 30
local SNIPER_MARGIN_M = 5

function set_role(id, role) if id then roles[id] = role end end
function set_retreat_dest(id, vid) if id then retreat_dest[id] = vid end end
function get_retreat_dest(id) return id and retreat_dest[id] or nil end

local function player_target(npc, actor)
    local live_pos, live_lv = actor:position(), actor:level_vertex_id()
    if not nemesis_mcm.get_bool("last_known_chase", true) then
        return live_pos, live_lv, "live"
    end
    local mt, sees = 0, false
    pcall(function() mt = npc:memory_time(actor) end)
    pcall(function() sees = npc:see(actor) end)
    if sees then return live_pos, live_lv, "seen" end
    if not mt or mt <= 0 or time_global() - mt > LKP_GIVE_UP_MS then return live_pos, live_lv, "live" end
    local pos = nil
    pcall(function() pos = xcombat.get_track_pos(npc, actor, false) end)
    if not pos or (pos.x == 0 and pos.y == 0 and pos.z == 0) then return live_pos, live_lv, "live" end
    return pos, nil, "last known"
end

local function flank_vertex(npc, tpos, role)
    local npos = npc:position()
    local dx, dz = tpos.x - npos.x, tpos.z - npos.z
    local d = math.sqrt(dx * dx + dz * dz)
    if d < FLANK_MIN_M then return nil end
    local a = math.rad(role.angle * role.side)
    local ca, sa = math.cos(a), math.sin(a)
    local dir = vector()
    dir:set((dx * ca - dz * sa) / d, 0, (dx * sa + dz * ca) / d)
    local vid = nil
    pcall(function() vid = xcombat.find_flee_lane(npc, dir, math.min(d * 0.5, 35), 10, 30) end)
    return vid
end

local function sniper_vertex(npc, tpos)
    local kind = nil
    pcall(function() kind = xcombat.get_weapon_kind(npc) end)
    if not (kind and xcombat.SNIPER_KINDS[kind]) then return nil end
    local hold = math.max(30, fight_range() - SNIPER_MARGIN_M)
    if npc:position():distance_to(tpos) > hold then return nil end
    local vid = nil
    pcall(function()
        vid = xcombat.find_cover(npc, tpos, { selection = xcombat.COVER.NEAREST, firing = true, radius = 15, search_pos = npc:position() })
    end)
    return vid or npc:level_vertex_id()
end

local SNEAK_RING_M = 70
local SNEAK_STEP_DEG = 35
local SNEAK_CLOSE_DEG = 30
local SNEAK_BEHIND_M = 15
local SNEAK_FACING_MS = 5000

local function wrap_angle(a)
    while a > math.pi do a = a - 2 * math.pi end
    while a <= -math.pi do a = a + 2 * math.pi end
    return a
end

local function sneak_target(npc, actor)
    local s = sneak[npc:id()]
    local apos, npos, dir = actor:position(), npc:position(), nil
    pcall(function() dir = actor:direction() end)
    if not dir then return nil end
    local l = math.sqrt(dir.x * dir.x + dir.z * dir.z)
    if l < 0.01 then return nil end
    local back = math.atan2(-dir.z / l, -dir.x / l)
    local now = time_global()
    local p = vector()
    if s.homing then
        if not s.face_at or now - s.face_at >= SNEAK_FACING_MS or now < s.face_at then
            s.face_at, s.face_back = now, back
        end
        s.closing = true
        local b = s.face_back
        p:set(apos.x + math.cos(b) * SNEAK_BEHIND_M, apos.y, apos.z + math.sin(b) * SNEAK_BEHIND_M)
        return p, "homing in behind you"
    end
    local vx, vz = npos.x - apos.x, npos.z - apos.z
    local here = math.atan2(vz, vx)
    local off = wrap_angle(back - here)
    local deg = math.abs(off) * 180 / math.pi
    if deg <= SNEAK_CLOSE_DEG then
        s.homing, s.closing, s.face_at, s.face_back = true, true, now, back
        p:set(apos.x + math.cos(back) * SNEAK_BEHIND_M, apos.y, apos.z + math.sin(back) * SNEAK_BEHIND_M)
        return p, "homing in behind you"
    end
    local step = math.min(math.abs(off), SNEAK_STEP_DEG * math.pi / 180)
    local a = here + (off >= 0 and step or -step)
    p:set(apos.x + math.cos(a) * SNEAK_RING_M, apos.y, apos.z + math.sin(a) * SNEAK_RING_M)
    return p, "circling behind you"
end

local function chase_target(npc, actor)
    if sneak_active(npc:id()) then

        if sneak_holding(npc:id()) then
            return npc:position(), npc:level_vertex_id(), "holding, about to open fire"
        end

        if not player_running(actor) then
            local p, phase = sneak_target(npc, actor)
            if p then return p, nil, phase end
        else
            local s = sneak[npc:id()]
            if s then s.closing = false end
        end
    end
    local tpos, tlv, mode = player_target(npc, actor)
    local role = roles[npc:id()]
    if role and role.extra and nemesis_mcm.get_bool("squad_tactics", true) then
        local svid = sniper_vertex(npc, tpos)
        if svid then return level.vertex_position(svid), svid, mode .. ", sniper position" end
        local fvid = flank_vertex(npc, tpos, role)
        if fvid then return level.vertex_position(fvid), fvid, mode .. ", flank" end
    end
    return tpos, tlv, mode
end

local function state_exists(name)
    local ok, res = pcall(function()
        return state_lib ~= nil and state_lib.states ~= nil and state_lib.states[name] ~= nil
    end)
    return ok and res == true
end

local STATE_ORDER = {
    far = { "sprint", "rush", "assault", "run" },
    near = { "rush", "assault", "run" },
    sneak = { "sneak_run", "sneak", "assault", "run" },
}
local picked_state = {}
local function pick_state(far, sneaky)
    local key = sneaky and "sneak" or (far and "far" or "near")
    local name = picked_state[key]
    if name == nil then
        name = false
        for _, n in ipairs(STATE_ORDER[key]) do
            if state_exists(n) then name = n; break end
        end
        if name then picked_state[key] = name end
    end
    return name or nil
end

local route_logged = {}
local function apply_state(npc, slot, far, sneaky)
    local name = pick_state(far, sneaky)
    local ok = false
    if name and db.storage[npc:id()] and db.storage[npc:id()].state_mgr then
        ok = pcall(function()
            state_mgr.set_state(npc, name, nil, nil, nil, { fast_set = true })
        end)
    end
    if debug_on() then
        local route = ok and ("state_mgr " .. tostring(name)) or "raw run (no state manager)"
        if route_logged[npc:id()] ~= route then
            route_logged[npc:id()] = route
            log_msg("Nemesis: chase movement for %s via %s.", tostring(npc:id()), route)
        end
    end
    if ok then
        slot.state = name
        return true
    end
    slot.state = nil
    return pcall(function()
        npc:set_movement_type(move.run)
        npc:set_mental_state(anim.danger)
        npc:set_sight(look.path_dir, nil, 0)
    end)
end

local function send_to(npc, lv)
    local used = nil
    if utils_obj and utils_obj.send_to_nearest_accessible_vertex then
        pcall(function() used = utils_obj.send_to_nearest_accessible_vertex(npc, lv, "nemesis_chase") end)
    end
    if type(used) == "number" and used < 4294967295 then return used end
    local ok = pcall(function() npc:set_dest_level_vertex_id(lv) end)
    return ok and lv or nil
end

function drive_chase(npc, actor)
    if not npc or not actor then return false, false end

    local id = npc:id()
    local slot = chase[id]
    if not slot then
        slot = { at = 0 }
        chase[id] = slot
    end

    local cover = retreat_dest[id]
    if cover then
        local now = time_global()
        if slot.cover_lv == cover and now - (slot.cover_at or -1000000) < RESEND_MS then return true, false end
        slot.cover_lv, slot.cover_at = cover, now
        pcall(function()
            npc:set_path_type(game_object.level_path)
            npc:set_detail_path_type(move.line)
            npc:set_desired_position()
            npc:set_desired_direction()
        end)
        pcall(function() xcombat.set_destination(npc, cover) end)
        return apply_state(npc, slot, true), false
    end

    if combat_owns(npc) then
        slot.was_fighting = true
        slot.holding = nil
        return nil, nil
    end

    if contact_hold(id) then
        if not slot.holding then
            slot.holding = true
            pcall(function()
                npc:set_desired_position()
                npc:set_desired_direction()
            end)
            local here = nil
            pcall(function() here = npc:level_vertex_id() end)
            if here and here < 4294967295 then send_to(npc, here) end
            apply_state(npc, slot, false, false)
            slot.was_fighting = true
        end
        return true, false
    end
    slot.holding = nil

    if slot.was_fighting then
        slot.was_fighting = nil
        slot.lv = nil
        slot.at = 0
    end

    local gt = time_global()
    local refreshed = false
    local sneaking = sneak_active(id)
    local refresh_ms = sneaking and SNEAK_REFRESH_MS or CHASE_REFRESH_MS

    if sneaking then
        local how = (sneak_holding(id) and "hold") or (player_running(actor) and "run") or "still"
        if slot.sneak_how ~= how then slot.sneak_how = how; slot.lv = nil end
    end
    if not slot.lv or gt - slot.at >= refresh_ms then
        local tpos, tlv, mode = chase_target(npc, actor)
        local lv, pos = pick_dest(npc, tpos, tlv)
        if not lv then return false, false end
        if slot.mode ~= mode then
            slot.mode = mode
            log_msg("Nemesis: %s chases toward %s.", tostring(id), mode)
        end
        slot.lv = lv
        slot.pos = pos
        slot.at = gt
        refreshed = true
    end

    if not refreshed and slot.sent_lv == slot.lv and gt - (slot.sent_at or -1000000) < RESEND_MS then
        return true, false
    end

    local dist = 9999
    pcall(function() dist = npc:position():distance_to(actor:position()) end)
    local far = dist > SPRINT_FROM_M

    local sneaky = sneaking and sneak_closing(id) and not sneak_holding(id) and not player_running(actor)

    pcall(function()
        npc:set_path_type(game_object.level_path)

        npc:set_detail_path_type(move.line)

        npc:set_desired_position()
        npc:set_desired_direction()
    end)
    local used = send_to(npc, slot.lv)
    if not used then return false, refreshed end
    local moved = apply_state(npc, slot, far, sneaky)
    slot.sent_lv, slot.sent_at = slot.lv, gt
    return moved, refreshed
end

---------------------------------------------------------------------------
-- UI
---------------------------------------------------------------------------

local FALLBACK_ICON = "ui_inGame2_PD_storonnik_ravnovesiya"
local NEWS_SHOW_MS = 7000

function send_news(text, caption, icon_override)
    local actor = db.actor
    if not actor then
        log_msg("!Nemesis: PDA message skipped, no actor yet: %s", tostring(text))
        return false
    end
    if type(caption) ~= "string" or caption == "" then caption = "Nemesis" end
    local icon = "ui_nemesis_news"
    if nemesis_mcm.get_bool("hd_icon", false) then
        icon = "ui_nemesis_news_hd"
    end
    if type(icon_override) == "string" and icon_override ~= "" then icon = icon_override end
    local ok, err = pcall(function() actor:give_game_news(caption, text, icon, 0, NEWS_SHOW_MS) end)
    if not ok then
        log_msg("!Nemesis ERROR: PDA message failed with icon %s (%s), retrying with a vanilla icon.", icon, tostring(err))
        icon = FALLBACK_ICON
        ok, err = pcall(function() actor:give_game_news(caption, text, icon, 0, NEWS_SHOW_MS) end)
    end
    if ok then
        pcall(function() xr_sound.set_sound_play(AC_ID, "pda_tips") end)
        log_msg("Nemesis: PDA message sent [%s] %s (icon %s).", caption, text, icon)
    else
        log_msg("!Nemesis ERROR: PDA message failed twice (%s).", tostring(err))
    end
    return ok
end

function sound_exists(path)
    local ok, res = pcall(function() return getFS():exist("$game_sounds$", path .. ".ogg") end)
    return ok and res and true or false
end

local sound_pick = {}
function pick_sound(key, paths)
    if sound_pick[key] == nil then
        sound_pick[key] = false
        for _, p in ipairs(paths) do
            if sound_exists(p) then sound_pick[key] = p; break end
        end
        log_msg("Nemesis: %s sound: %s.", key, sound_pick[key] or "none found")
    end
    return sound_pick[key] or nil
end

function volume_setting(id, default)
    local v = nemesis_mcm.get_number(id, default) / 100
    if v < 0 then v = 0 end
    if v > 1 then v = 1 end
    return v
end

local function player_name()
    local name = nil
    pcall(function() name = db.actor:character_name() end)
    if type(name) ~= "string" or name == "" then name = "Stalker" end
    return name
end

