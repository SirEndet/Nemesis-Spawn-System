-- Nemesis Utilities: the debug log, the settings readers and the hunt's squad sections.

local function default_name(kind) return nemesis_lines.text("st_nemesis_boss_name_" .. kind) end

function debug_on() return nemesis_mcm.get_bool("debug_logs", false) end

local IMPORTANT_EVERY_MS = 60000
local important_at = {}

local function stamp(tag, now) return "[" .. tag .. " " .. string.format("%.1f", now / 1000) .. "s] " end

local LOG_FILE, LOG_MAX_BYTES = "nemesis.log", 5 * 1024 * 1024
local LOG_QUEUE_MAX = 2000
local file_log = nil
local log_queue = {}

local function to_file(level, text)
    if file_log == nil then
        if #log_queue < LOG_QUEUE_MAX then log_queue[#log_queue + 1] = { level, text } end
        return
    end
    if file_log then
        pcall(file_log[level], "%s", text)
    else
        printf("%s", text)
    end
end

function log_ready()
    if file_log == nil then
        local ok, l = pcall(function()

            return xlog.get_logger("NEMESIS", { outfile = LOG_FILE, level = "TRACE", stack_trace = false, max_file_size = LOG_MAX_BYTES })
        end)
        file_log = ok and type(l) == "table" and l or false
    end
    local q = log_queue
    log_queue = {}
    for _, e in ipairs(q) do to_file(e[1], e[2]) end
end

function log_flush()
    if file_log then pcall(file_log.flush) end
end

function log_copy(text) to_file("info", text) end

function log_tag(tag, fmt, ...)
    if type(fmt) ~= "string" then return end
    if fmt:sub(1, 2) == "!!" then
        local now = (time_global and time_global()) or 0
        local body = (fmt:sub(3):gsub("^Nemesis ERROR:%s*", ""))
        local ok, text = pcall(string.format, body, ...)
        if not ok then text = body end
        local key = tostring(tag) .. "|" .. text
        local last = important_at[key]
        if last and now >= last and now - last < IMPORTANT_EVERY_MS then return end
        important_at[key] = now
        printf("%s", "~" .. stamp(tag, now) .. "NEMESIS IMPORTANT ERROR (please report): " .. text)

        local tb = ""
        pcall(function() tb = debug.traceback("", 2) end)
        to_file("fatal", stamp(tag, now) .. "NEMESIS IMPORTANT ERROR: " .. text .. (tb or ""))
        return
    end
    local err = fmt:sub(1, 1) == "!"
    if not err and not debug_on() then return end
    local body = err and fmt:sub(2) or fmt
    local ok, text = pcall(string.format, body, ...)
    if not ok then text = body end
    local head = stamp(tag, (time_global and time_global()) or 0)
    to_file(err and "error" or "debug", (err and "!" or "") .. head .. text)
end

function log_msg(fmt, ...)
    local tag = "AI"
    if type(fmt) == "string" then
        if fmt:find("STALL", 1, true) then tag = "STALL"
        elseif fmt:find("PDA message", 1, true) then tag = "PDA"
        elseif fmt:find("sound", 1, true) then tag = "SOUND"
        elseif fmt:find("Obrien", 1, true) or fmt:find("latest exes", 1, true) or fmt:find("squad section", 1, true) then tag = "COMPAT" end
    end
    log_tag(tag, fmt, ...)
end

---------------------------------------------------------------------------
-- Settings-derived values
---------------------------------------------------------------------------

local UP, LOW = "[%u\192-\223\168\165\170\175\178]", "[%l\224-\255\184\180\186\191\179]"
local SPACE_AT = "(" .. UP .. LOW .. LOW .. "+)(" .. UP .. ")"

function spaced_name(name)
    if type(name) ~= "string" then return name end
    return (string.gsub(name, SPACE_AT, "%1 %2"))
end

function monolith_boss_name() return spaced_name(nemesis_mcm.get_string("npc_name", default_name("monolith"))) end

function isg_boss_name() return spaced_name(nemesis_mcm.get_string("isg_boss_name", default_name("isg"))) end

function army_boss_name() return spaced_name(nemesis_mcm.get_string("army_boss_name", default_name("army"))) end

function default_boss_name(kind) return default_name(kind) end

function get_npc_name()
    if nemesis_state.S.faction == "isg" then return isg_boss_name() end
    if nemesis_state.S.faction == "army" then return army_boss_name() end
    return monolith_boss_name()
end

function is_boss_name(n)
    return n ~= nil and (n == monolith_boss_name() or n == isg_boss_name() or n == army_boss_name())
end

function clamped(id, def, lo, hi)
    local v = tonumber(nemesis_mcm.get_number(id, def)) or def
    if v < lo then v = lo end
    if v > hi then v = hi end
    return v
end

function escalation(cycle)
    local step = clamped("esc_step", 2, 0, 5)
    local max = clamped("esc_max", 20, 0, 40)
    return math.min(max, step * math.max(0, (cycle or 1) - 1)) / 100
end

function get_retreat_health()
    return clamped("retreat_health", 25, 10, 60) / 100
end

function br_bonus()
    return clamped("br_bonus", 0.05, 0, 0.5), clamped("pct_bonus", 10, 0, 50) / 100
end

local function clamp_br(v)
    if not v or v < 0 then return 0 end
    return v
end

local function clamp_pct(v)
    if not v or v < 0 then return 0 end
    if v > 0.90 then return 0.90 end
    return v
end

local function clamp_hf(v)
    if not v or v > 1 then return 1 end
    if v < 0.05 then return 0.05 end
    return v
end

local function read_br_stats(actor, outfit, helmet, obrien)
    local body_br, head_br, body_pct, head_pct = 0, 0, 0, 0
    local body_hf, head_hf = 1, 1
    pcall(function()
        if outfit then

            local cond = outfit:condition() or 1
            if obrien then
                body_br, body_pct = nemesis_compat.obrien_item_stats(outfit:section(), cond)
            else

                local hf = ini_sys:r_float_ex(outfit:section(), "hit_fraction_actor")
                if hf then
                    body_br = (1 - hf) * cond
                    body_hf = hf
                end

                local c = outfit:cast_CustomOutfit()
                if c and BoneID and BoneID["bip01_spine"] then

                    body_pct = (c:GetBoneArmor(BoneID["bip01_spine"]) or 0) * cond * 0.80
                end
            end
        end
        if helmet then
            local cond = helmet:condition() or 1
            if obrien then
                head_br, head_pct = nemesis_compat.obrien_item_stats(helmet:section(), cond)
            else
                local hf = ini_sys:r_float_ex(helmet:section(), "hit_fraction_actor")
                if hf then
                    head_br = (1 - hf) * cond
                    head_hf = hf
                end

                local c = helmet:cast_Helmet()
                if c and BoneID and BoneID["bip01_head"] then
                    head_pct = (c:GetBoneArmor(BoneID["bip01_head"]) or 0) * cond * 0.80
                end
            end
        end
    end)
    return { clamp_br(body_br), clamp_br(head_br), clamp_pct(body_pct), clamp_pct(head_pct),
        clamp_hf(body_hf), clamp_hf(head_hf) }
end

local BR_CACHE_MS = 500
local br_cache = { at = -1000000 }

local function _item_id(o) return o:id() end

local function _item_sec(o) return o:section() end

local function _slot(a, n) return a:item_in_slot(n) end

local function item_key(item)
    if not item then return "-" end
    local ok1, id = pcall(_item_id, item)
    local ok2, sec = pcall(_item_sec, item)
    return tostring(ok1 and id or "?") .. "/" .. tostring(ok2 and sec or "?")
end

function player_br_stats()
    local actor = db.actor
    if not actor then return 0, 0, 0, 0, 1, 1 end
    local ok1, outfit = pcall(_slot, actor, 7)
    local ok2, helmet = pcall(_slot, actor, 12)
    if not ok1 then outfit = nil end
    if not ok2 then helmet = nil end
    local oid, hid = item_key(outfit), item_key(helmet)
    local okso, so = pcall(_item_sec, outfit)
    local oksh, sh = pcall(_item_sec, helmet)
    local obrien = nemesis_compat.obrien_on(okso and so or nil, oksh and sh or nil)
    local now = time_global()
    local c = br_cache
    if not (c.v and c.oid == oid and c.hid == hid and c.obrien == obrien and now - c.at < BR_CACHE_MS) then
        c.v = read_br_stats(actor, outfit, helmet, obrien)
        c.oid, c.hid, c.obrien, c.at = oid, hid, obrien, now
    end
    local v = c.v
    return v[1], v[2], v[3], v[4], v[5], v[6]
end

---------------------------------------------------------------------------
-- Spawn sections
---------------------------------------------------------------------------

function player_community()
    local comm = nil
    pcall(function() comm = get_actor_true_community() end)

    if type(comm) ~= "string" then pcall(function() comm = db.actor:character_community() end) end
    if type(comm) == "string" then comm = string.gsub(comm, "^actor_", "") end
    return type(comm) == "string" and comm or nil
end

local UNISG_HUNTS = { monolith = true, zombied = true, greh = true }

local function monolith_hunters()
    local v = nemesis_mcm.get_string("monolith_hunters", "army")
    if v == "isg" then return "isg" end
    return "army"
end

function faction_for_player()
    local comm = player_community()
    if comm == "monolith" then return monolith_hunters() end
    return UNISG_HUNTS[comm] and "isg" or "monolith"
end

local SQUADS = { monolith = "nemesis_hunter_squad", isg = "nemesis_hunter_squad_isg", army = "nemesis_hunter_squad_army" }

function resolve_squad_section(faction)
    local sec = SQUADS[faction] or SQUADS.monolith
    if nemesis_engine.section_exists(sec) then return sec end
    log_msg("!!Nemesis ERROR: squad section %s not found (squad_descr_nemesis.ltx is not loaded).", sec)
    return nil
end

local MEMBER_POOL = {
    monolith = { "sim_default_monolith_3", "sim_default_monolith_2", "sim_default_monolith_4",
                 "sim_default_monolith_1", "sim_monolith_sniper" },
    isg = { "sim_default_isg_3", "sim_default_isg_4", "sim_default_isg_2", "sim_default_isg_1" },

    army = { "sim_default_military_3", "sim_default_military_2", "sim_default_military_4",
             "sim_default_military_1", "sim_default_military_3_sniper" },
}

function member_pool(faction)
    local out = {}
    for i, sec in ipairs(MEMBER_POOL[faction] or MEMBER_POOL.monolith) do out[i] = sec end
    return out
end

function pick_member_section(faction)
    local pool = {}
    for _, sect in ipairs(MEMBER_POOL[faction] or MEMBER_POOL.monolith) do
        if nemesis_engine.section_exists(sect) then pool[#pool + 1] = sect end
    end
    if #pool == 0 then return nil end
    return pool[math.random(#pool)]
end

function reset_chase(id)
    if id then
        nemesis_chase.reset_slot(id)
    else
        nemesis_chase.reset_slots()
        nemesis_combat.reset()
        nemesis_siege.reset()
    end
end

function forget_fight(id)
    if not id then return end
    nemesis_combat.forget(id)
    nemesis_chase.forget_tactics(id)
end
