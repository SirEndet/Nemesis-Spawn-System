-- Nemesis FX

local S = nemesis_state.S

local function dbg(...) nemesis_utils.log_msg(...) end

---------------------------------------------------------------------------
-- Teleport burst
---------------------------------------------------------------------------

local FX_KEEP = 16
local function keep_fx(o)
    S.fx[#S.fx + 1] = o
    if #S.fx > FX_KEEP then table.remove(S.fx, 1) end
end

function play_retreat_fx(pos)
    if not pos or not db.actor then return end
    local spot = vector()
    spot:set(pos.x, pos.y + 1, pos.z)
    local ok = pcall(function()
        local parti = particles_object("anomaly2\\teleport_out_00")
        parti:play_at_pos(spot)
        keep_fx(parti)
    end)
    if not ok then dbg("Nemesis: retreat particle failed") end
    pcall(function()
        local snd = sound_object("anomaly\\teleport_incoming")

        snd.volume = nemesis_utils.volume_setting("teleport_volume", 40)
        snd:play_at_pos(db.actor, spot)
        snd.volume = nemesis_utils.volume_setting("teleport_volume", 40)
        keep_fx(snd)
    end)
end

---------------------------------------------------------------------------
-- Invisible model
---------------------------------------------------------------------------

INVISIBLE_VISUAL  = "actors\\stalker_invisible\\stalker_invisible"
DEAD_BODY_DELAY_MS = 0
RETREAT_VANISH_MS  = 1000

local invisible_ok = nil

function invisible_model_exists()
    if invisible_ok == nil then
        invisible_ok = false
        pcall(function()
            invisible_ok = getFS():exist("$game_meshes$", INVISIBLE_VISUAL .. ".ogf") and true or false
        end)
        dbg("Nemesis: invisible model %s.", invisible_ok and "found" or "NOT found, teleports use the burst only")
    end
    return invisible_ok
end

local function _alive(obj) return obj:alive() end
function alive_obj(obj)
    if not obj then return false end
    local ok, alive = pcall(_alive, obj)
    return ok and alive == true
end

function mesh_exists(path)
    local ok = false
    pcall(function() ok = getFS():exist("$game_meshes$", path .. ".ogf") and true or false end)
    return ok
end

local function _set_visual(obj, vis) obj:set_visual_name(vis) end
local function _get_visual(obj) return obj:get_visual_name() end

function set_visual(obj, vis)
    if not alive_obj(obj) then return false end
    return pcall(_set_visual, obj, vis)
end

function get_visual(obj)
    local ok, vis = pcall(_get_visual, obj)
    if ok and type(vis) == "string" then return vis end
    return nil
end

function make_invisible(obj)
    if not obj or not alive_obj(obj) or not invisible_model_exists() then return false end
    local ok, err = pcall(_set_visual, obj, INVISIBLE_VISUAL)
    if not ok then dbg("!Nemesis ERROR: invisible model swap failed (%s).", tostring(err)) end
    return ok
end

---------------------------------------------------------------------------
-- Removal: vanish queue, offline members, empty squads
---------------------------------------------------------------------------
local vanish_queue = {}
local squad_cleanup = {}
local SQUAD_CLEANUP_MS = 3000

function queue_vanish(id, delay_ms)
    if not id then return end
    vanish_queue[id] = time_global() + (delay_ms or 0)
end

function vanish_ids()
    local ids = {}
    for id in pairs(vanish_queue) do ids[#ids + 1] = id end
    return ids
end

function remove_object(se)
    if not se then return false end
    return pcall(function()
        if type(alife_release) == "function" then
            alife_release(se)
        else
            alife():release(se, true)
        end
    end)
end

function queue_squad_cleanup(id)
    if id then squad_cleanup[id] = time_global() + SQUAD_CLEANUP_MS end
end

local function process_squad_cleanup(gt)
    for id, at in pairs(squad_cleanup) do
        if gt >= at then
            squad_cleanup[id] = nil
            local sq = alife():object(id)
            local n, is_squad = 1, false
            pcall(function()
                n = sq:npc_count()
                is_squad = sq:clsid() == clsid.online_offline_group_s
            end)
            if sq and is_squad and n == 0 and id ~= S.sim_squad_id then
                if remove_object(sq) then dbg("Nemesis: empty hunt squad %s removed.", tostring(id)) end
            end
        end
    end
end

local function process_vanish(gt)
    for id, at in pairs(vanish_queue) do
        if gt >= at then
            vanish_queue[id] = nil
            local se = alife():object(id)
            local is_npc = false
            pcall(function() is_npc = IsStalker(nil, se:clsid()) end)
            if se and is_npc then
                local ok, err = remove_object(se)
                if ok then
                    dbg("Nemesis: %s teleported out (removed).", tostring(id))
                else
                    dbg("!Nemesis ERROR: could not remove %s (%s).", tostring(id), tostring(err))
                end
            end
        end
    end
end

function process_queues(gt)
    if next(vanish_queue) ~= nil then process_vanish(gt) end
    if next(squad_cleanup) ~= nil then process_squad_cleanup(gt) end
end

function remove_offline(ids)
    for _, id in ipairs(ids) do
        local se = alife():object(id)
        local alive, online = false, true
        pcall(function() alive = se:alive(); online = se.online end)
        if se and alive and not online then
            if remove_object(se) then dbg("Nemesis: offline hunt member %s removed.", tostring(id)) end
        end
    end
end

---------------------------------------------------------------------------
-- Cloak (MCM, on by default; always on for the boss)
---------------------------------------------------------------------------

local CLOAK_MIN_M = 30
local REVEAL_M = 15
local CLOAK_COOLDOWN_MS = 20000
local HIT_REVEAL_MS = 1500

local BUMP_M = 2
local BUMP_MS = 500
local neutral = {}
local neutral_any = false

local function set_neutral(id, on)
    if on then neutral[id] = true else neutral[id] = nil end
    neutral_any = next(neutral) ~= nil
end

local BOSS_YOU_FIRST_MS = 5000

local function boss_wants_you()
    local bid = S.boss_id
    local r = bid and S.m[bid]
    return r ~= nil and r.player_hit_at ~= nil and time_global() - r.player_hit_at < BOSS_YOU_FIRST_MS
end

function on_enemy_eval(npc, enemy, flags)
    if not npc or not enemy or not flags then return end
    if boss_wants_you() and npc:id() == S.boss_id and enemy:id() ~= 0 then
        flags.override = true
        flags.result = false
        return
    end
    if not neutral_any then return end
    local a, e = npc:id(), enemy:id()
    if not neutral[a] and not neutral[e] then return end
    if a == 0 or e == 0 then return end
    flags.override = true
    flags.result = false
end

local function hostile_bump(obj)
    local found = false
    pcall(function()
        level.iterate_nearest(obj:position(), BUMP_M, function(o)
            if found or not o or o:id() == 0 or o:id() == obj:id() then return end
            if nemesis_state.member(o:id()) then return end

            if not (IsMonster(o) or IsStalker(o)) or not alive_obj(o) then return end
            if IsMonster(o) then found = true
            elseif IsStalker(o) then
                local ok, rel = pcall(function() return obj:relation(o) end)
                local ok2, rel2 = pcall(function() return o:relation(obj) end)
                if (ok and rel == game_object.enemy) or (ok2 and rel2 == game_object.enemy) then found = true end
            end
            return found
        end)
    end)
    return found
end

function reveal(obj, r, gt, why)
    if not r or not r.cloak_vis then return end
    set_neutral(r.id, false)
    set_visual(obj, r.cloak_vis)
    r.cloak_vis = nil
    r.cloak_off_at = gt or time_global()
    dbg("Nemesis: %s reappears (%s).", r.name or "A hunter", why or "?")
end

local function cloak(obj, r)
    local vis = get_visual(obj)
    if not vis or vis == "" or vis == INVISIBLE_VISUAL then return end
    r.cloak_vis = vis
    if not make_invisible(obj) then
        r.cloak_vis = nil
        return
    end
    dbg("Nemesis: %s cloaks.", r.name or "A hunter")
end

local function _dist(a, b) return a:position():distance_to(b:position()) end

function cloak_update(obj, r, gt, actor)
    local id = r.id

    local enabled
    if id == S.boss_id then enabled = not r.player_struck
    else enabled = nemesis_mcm.get_bool("hunter_cloak", true) end
    enabled = enabled and invisible_model_exists()
    local hit = r.hit_at and gt - r.hit_at < HIT_REVEAL_MS
    if id == S.boss_id and nemesis_utils.sneak_active(id) then
        hit = r.player_hit_at and gt - r.player_hit_at < HIT_REVEAL_MS
    end
    local ok, d = pcall(_dist, obj, actor)
    if not ok then d = 9999 end
    local fighting = nemesis_utils.combat_owns(obj) == true
    if r.cloak_vis then
        if not enabled then reveal(obj, r, gt, "option off")
        elseif fighting then reveal(obj, r, gt, "fighting")
        elseif d <= REVEAL_M and not nemesis_utils.sneak_active(id) then reveal(obj, r, gt, "close")
        elseif hit then reveal(obj, r, gt, "hit")
        elseif gt - (r.bump_at or -BUMP_MS) >= BUMP_MS then
            r.bump_at = gt
            if hostile_bump(obj) then reveal(obj, r, gt, "an enemy within 2 m") end
        end
    elseif enabled and not fighting and not hit and d > CLOAK_MIN_M
        and gt - (r.cloak_off_at or -CLOAK_COOLDOWN_MS) >= CLOAK_COOLDOWN_MS then
        cloak(obj, r)
    end
    local want = (r.cloak_vis and not r.player_struck) and true or false
    if want ~= (neutral[id] == true) then
        set_neutral(id, want)
        dbg("Nemesis: %s is %s.", r.name or "A hunter", want and "no one's enemy while cloaked" or "a normal enemy again")
    end
end

function forget_boss() if S.boss_ghost then set_neutral(S.boss_ghost, false) end end
function forget_neutral(id) if id then set_neutral(id, false) end end

local masked = {}

function unmask(obj, r)
    if not (r and r.mask_vis) or not alive_obj(obj) then return end
    local ok, hp = pcall(function() return obj.health end)
    if not ok or not hp or hp <= 0 then return end
    local vis = r.mask_vis
    r.mask_vis = nil
    masked[r.id] = nil
    set_visual(obj, vis)
end

function unmask_survivors()
    if next(masked) == nil then return end
    for id in pairs(masked) do
        local r = S.m[id]
        if not (r and r.mask_vis) then
            masked[id] = nil
        elseif not r.death then
            local obj = level.object_by_id(id)
            if obj then unmask(obj, r) end
        end
    end
end

function note_masked(id) if id then masked[id] = true end end

function reveal_all()
    neutral, neutral_any = {}, false
    for id, r in pairs(S.m) do
        if r.mask_vis then
            local obj = level.object_by_id(id)
            if obj then unmask(obj, r) end
        end
        if r.cloak_vis then
            local obj = level.object_by_id(id)
            if obj then reveal(obj, r, nil, "hunt over") end
            r.cloak_vis = nil
        end
    end
end

---------------------------------------------------------------------------
-- Psy hum
---------------------------------------------------------------------------

local HUM_RANGE_M = 60
local HUM_FULL_M = 10
local hum = nil

function hum_stop()
    if not hum then return end
    pcall(function() xsound.release(hum.l) end)
    if hum.r then pcall(function() xsound.release(hum.r) end) end
    hum = nil
end

function measure(actor)
    local nearest, boss_d = nil, nil
    if not (actor and S.phase == "hunting") then return nil, nil end
    for _, id in ipairs(S.hunter_ids) do
        local r = S.m[id]
        local obj = level.object_by_id(id)
        if obj and r and not r.death and alive_obj(obj) then
            local ok, d = pcall(_dist, obj, actor)
            if ok then
                if not r.retreat_at and (not nearest or d < nearest) then nearest = d end
                if id == S.boss_id then boss_d = d end
            end
        end
    end
    return nearest, boss_d
end

function hum_update(nearest)
    local slider = nemesis_utils.volume_setting("hum_volume", 20)
    local target = 0
    if nearest and nearest < HUM_RANGE_M then
        local close = (HUM_RANGE_M - nearest) / (HUM_RANGE_M - HUM_FULL_M)
        if close > 1 then close = 1 end
        target = slider * (0.5 + 0.5 * close)
    end
    if target <= 0.001 then
        hum_stop()
        return
    end
    if not hum then
        local path_l, path_r = nemesis_utils.psy_voices()
        if not path_l then return end
        local l, rr = nil, nil
        pcall(function()
            l = xsound.create_sound(path_l, { looped = true, s2d = true, smoothing = 0.6 })
            if path_r then rr = xsound.create_sound(path_r, { looped = true, s2d = true, smoothing = 0.6 }) end
        end)
        if not l then
            if rr then pcall(function() xsound.release(rr) end) end
            return
        end
        hum = { l = l, r = rr }
        dbg("Nemesis: psy hum starts (a named hunter is within %s m).", HUM_RANGE_M)
    end
    pcall(function()
        xsound.set_volume(hum.l, target)
        if hum.r then xsound.set_volume(hum.r, target) end
    end)
end

---------------------------------------------------------------------------
-- Boss distortion (MCM "Boss presence distortion", round 76)
---------------------------------------------------------------------------

local DISTORT_PPE = "alcohol.ppe"
local DISTORT_RANGE_M = 60
local DISTORT_FULL_M = 5
local DISTORT_KEEP_M = 70
local DISTORT_SPEED = 0.5
local distort = nil
local distort_ok = nil

local function distort_file_ok()
    if distort_ok == nil then
        distort_ok = false
        pcall(function() distort_ok = getFS():exist("$game_anims$", DISTORT_PPE) and true or false end)
        if not distort_ok then dbg("!Nemesis ERROR: %s not found; the boss distortion stays off.", DISTORT_PPE) end
    end
    return distort_ok
end

function distort_stop()
    if not distort then return end
    pcall(function() xpp.release(distort) end)
    distort = nil
end

function distort_update(d)
    local slider = nemesis_mcm.get_number("boss_distortion", 50)
    if slider < 0 then slider = 0 end
    if slider > 100 then slider = 100 end
    if not d or d > DISTORT_KEEP_M or slider <= 0 then
        distort_stop()
        return
    end
    local strength = 0
    if d < DISTORT_RANGE_M then
        local close = (DISTORT_RANGE_M - d) / (DISTORT_RANGE_M - DISTORT_FULL_M)
        if close > 1 then close = 1 end
        strength = slider / 100 * close * close
    end
    if not distort then
        if strength <= 0.001 or not distort_file_ok() then return end
        local h = nil
        pcall(function() h = xpp.create_effector(DISTORT_PPE, { cyclic = true, smoothing = DISTORT_SPEED }) end)
        if not h then return end

        pcall(function() level.set_pp_effector_factor(h, 0.0001) end)
        distort = h
        dbg("Nemesis: boss distortion starts (he is within %s m).", DISTORT_RANGE_M)
    end
    pcall(function() xpp.set_target(distort, strength) end)
end

---------------------------------------------------------------------------
-- Reserved bodies (MCM "Reserve your kills", round 76, user design)
---------------------------------------------------------------------------

local RESERVE_S = 2 * 3600
local RESERVE_AWAY_M = 150
local RESERVE_AWAY_MS = 180000
local reserve_away = {}
local reserve_hooked = false

local function reserve_on() return nemesis_mcm.get_bool("reserve_kills", false) end

function alifeplus_reserve()
    local present, on = false, false
    pcall(function()
        if ap_ext_loot_claim and ap_core_mcm and ap_core_mcm.cfg then
            present = true
            on = ap_core_mcm.cfg.loot_reserve_own_enabled == true
        end
    end)
    return present, on
end

local function is_reserved(id)
    local v = id and S.reserved[id]
    if not v or not reserve_on() then return false end
    return nemesis_utils.game_seconds() - v.t <= RESERVE_S
end

local function _reserved_obj(obj) return obj and is_reserved(obj:id()) end
local function near_actor_wrap(orig, obj, ...)

    if next(S.reserved) == nil then return orig(obj, ...) end
    local ok, yes = pcall(_reserved_obj, obj)
    if ok and yes then return true end
    return orig(obj, ...)
end

local function install_reserve_hook()
    if reserve_hooked then return true end
    local cd = nil
    pcall(function() cd = xr_corpse_detection end)
    if not (cd and type(cd.near_actor) == "function") then
        dbg("!Nemesis ERROR: xr_corpse_detection.near_actor not found; bodies cannot be reserved.")
        return false
    end
    local done = false
    pcall(function()
        done = xevent and not xevent.is_hooked("xr_corpse_detection", "near_actor")
            and xevent.register_hook("xr_corpse_detection", "near_actor", near_actor_wrap) and true or false
    end)
    if not done then
        local orig = cd.near_actor
        cd.near_actor = function(obj, ...) return near_actor_wrap(orig, obj, ...) end
    end
    reserve_hooked = true
    dbg("Nemesis: NPC looting of your Nemesis kills is gated (xr_corpse_detection.near_actor).")
    return true
end

function reserve_body(id)
    if not id or not reserve_on() then return end
    local present, on = alifeplus_reserve()
    if present then
        dbg("Nemesis: body %s: %s", tostring(id), on and "AlifePlus reserves your kills (its own radius and time)."
            or "AlifePlus's \"reserve own kills\" is off, so the body is not reserved.")
        return
    end
    if not install_reserve_hook() then return end
    local sec = nil
    pcall(function() sec = alife():object(id):section_name() end)
    S.reserved[id] = { t = nemesis_utils.game_seconds(), sec = sec }
    reserve_away[id] = nil
    dbg("Nemesis: body %s reserved for you (2 in-game hours, or 3 min more than 150 m away).", tostring(id))
end

function reserve_tick(gt, actor)
    if next(S.reserved) == nil then return end
    if not reserve_on() or alifeplus_reserve() then
        S.reserved, reserve_away = {}, {}
        return
    end
    install_reserve_hook()
    local now = nemesis_utils.game_seconds()
    for id, v in pairs(S.reserved) do
        local why = nil
        local se = alife():object(id)
        local sec = nil
        if se then pcall(function() sec = se:section_name() end) end
        if now - v.t > RESERVE_S or now < v.t then why = "2 in-game hours passed"
        elseif not se then why = "the body is gone"
        elseif v.sec and sec ~= v.sec then why = "the body is gone (its id is someone else's now)"
        else
            local far = true
            pcall(function()
                if nemesis_utils.same_level(se, alife():actor()) ~= false then
                    far = se.position:distance_to(actor:position()) > RESERVE_AWAY_M
                end
            end)
            if far then
                reserve_away[id] = reserve_away[id] or gt
                if gt - reserve_away[id] > RESERVE_AWAY_MS then why = "you were more than 150 m away for 3 min" end
            else
                reserve_away[id] = nil
            end
        end
        if why then
            S.reserved[id], reserve_away[id] = nil, nil
            dbg("Nemesis: body %s is free to loot again (%s).", tostring(id), why)
        end
    end
end

function reset_runtime()
    distort = nil
    masked = {}
    reserve_away = {}
    neutral, neutral_any = {}, false
    hum = nil
    vanish_queue = {}
    squad_cleanup = {}
end
