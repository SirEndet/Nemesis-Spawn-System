            "st_nemesis_em_isg_arrival_1",
            "st_nemesis_em_isg_arrival_2",
            "st_nemesis_em_isg_arrival_3",
            "st_nemesis_em_isg_arrival_4",
            "st_nemesis_em_isg_arrival_5",
            "st_nemesis_em_isg_arrival_6",
            "st_nemesis_em_isg_arrival_7",
            "st_nemesis_em_isg_arrival_8",
        },
        boss_escape = {
            "st_nemesis_em_isg_boss_escape_1",
            "st_nemesis_em_isg_boss_escape_2",
        },
