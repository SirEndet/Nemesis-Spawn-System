-- Nemesis Emission Boss (round 93, user design)

local S = nemesis_state.S
local NO_VERTEX = 4294967295

local function dbg(...) nemesis_utils.log_tag("EMISSION", ...) end

local H = { horde_done = nil,
            released = nil,
            squads = nil }
local function clear_hunt_state() H.horde_done, H.released, H.squads = nil, nil, nil end
local saved_flow = nil

local SQUADS = { greh = "nemesis_emission_squad", isg = "nemesis_emission_squad_isg" }
local OWN_SECTIONS = { "nemesis_emission_squad", "nemesis_emission_squad_isg", "nemesis_emission_boss",
                       "nemesis_emission_boss_isg", "nemesis_horde_zombied", "nemesis_horde_snork",
                       "nemesis_horde_snork_normal", "nemesis_phantom" }
local function squad_section(faction)
    local sec = SQUADS[faction] or SQUADS.greh
    if nemesis_engine.section_exists(sec) then return sec end
    dbg("!!Nemesis ERROR: squad section %s not found (squad_descr_nemesis_emission.ltx is not loaded).", sec)
    return nil
end

local WAIT_INSIDE_MS  = 60000
local HAUNT_LEAD_MS   = 20000
local HORDE_DELAY_MS  = 15000
local RETRY_MS        = 5000
local GIVE_UP_MS      = 60000

local SCAN_HEADINGS, SCAN_HOP_HEADINGS = 24, 12
local SCAN_STEP_M, SCAN_MAX_M, SCAN_HOP_MAX_M = 2, 30, 20
local SCAN_DOOR_M, SCAN_REACH_M, SCAN_HOP_REACH_M = 5, 60, 40
local ENC_NO_WALL_M = SCAN_REACH_M
local SCAN_PER_TICK = 2
local SCAN_HOPS_MAX = 6
local EXIT_MERGE_M = 4
local EXITS_MAX = 6

local BURST_HEADINGS, BURST_PER_TICK = 120, 60
local BURST_SPOTS, BURST_SPOT_GAP_M = 3, 8
local BURST_Y, BURST_PAST_M = 0.4, 3

local GHOST_FX = "monsters\\polter_black_idle"

local RING_M, RING_GHOSTS = 55, 12
local RING_PUSH_M, RING_BACK_M = 53, 6
local RING_PAST_WALL_M = 25

local RING_FILL = { { 5, 0 }, { -5, 0 }, { 10, 0 }, { -10, 0 }, { 0, 0.25 }, { 0, -0.25 },
                    { 5, 0.25 }, { 5, -0.25 }, { -5, 0.25 }, { -5, -0.25 }, { 0, 0.45 }, { 0, -0.45 } }
local GHOST_PUSH_M = 3.5

local DOOR_SIDE_M = { 2, 1.2 }

local SMALL_ROOM_M2 = 12
local SHOVE_BACK_M = 1.5
local SHOVE_COOLDOWN_MS = 1500

local SHELTER_MS = 3000

local SKIP_LOG_MS = 5000

local WAIT_LOG_MS = 5000
local SHOVE_PPE = "psychic.ppe"
local SHOVE_PPE_ID = 93101

local PHANTOM_SECTION = "nemesis_phantom"
local PHANTOMS_PER_SHOVE = 2
local PHANTOMS_MAX = 4

local LIGHTNING_FX = "crommcruac\\psi_storm_01"
local LIGHTNING_SOUNDS = { "anomaly\\psi_storm_01" }

local HORDE_ZOMBIES = { "sim_default_zombied_0", "sim_default_zombied_1", "sim_default_zombied_2" }
local HORDE_SNORK_WEAK, HORDE_SNORK = "snork_weak", "snork_normal"

local HORDE_SQUAD_ZOMBIE, HORDE_SQUAD_SNORK, HORDE_SQUAD_SNORK_NORMAL = "nemesis_horde_zombied", "nemesis_horde_snork", "nemesis_horde_snork_normal"

local em = nil
local roll = nil
local extra = nil
local again = false
local again_exits = nil
local force_next = false
local psy_at = nil
local horde_job = nil
local allies = {}
local allies_any = false
local immune = nil

function force()
    if em or S.emission_hunt or own_follow_now() or force_next then
        nemesis_utils.log_tag("EMISSION", "Nemesis: the emission boss is already on his way; a second one is refused (MCM).")
        nemesis_utils.send_news(nemesis_utils.text("st_nemesis_em_msg_on_his_way"), nemesis_utils.text("st_nemesis_caption"))
        return false
    end
    force_next = true
    return true
end

function own_follow_now() return S.follow ~= nil and S.follow.emission_hunt == true end

---------------------------------------------------------------------------
-- Settings
---------------------------------------------------------------------------

local function default_name() return nemesis_utils.text("st_nemesis_em_boss_name") end
function boss_name() return nemesis_utils.spaced_name(nemesis_mcm.get_string("emission_name", default_name())) end

local function enabled() return nemesis_mcm.get_bool("emission_enabled", true) end

local function setting(id, def, lo, hi)
    return math.max(lo, math.min(hi, nemesis_mcm.get_number(id, def)))
end

local function chance() return enabled() and setting("emission_chance", 100, 0, 100) or 0 end

local function extra_chance() return enabled() and setting("emission_extra", 6, 0, 100) or 0 end

function npc_cut() return setting("emission_npc_cut", 70, 0, 95) / 100 end
local function psy_damage() return setting("emission_psy", 4, 0, 20) / 100 end
local function horde_size() return math.floor(setting("emission_horde", 4, 0, 8) + 0.5) end

function faction_for_player()
    return nemesis_utils.faction_for_player() == "isg" and "isg" or "greh"
end

local function surge() return nemesis_compat.surge_on() end
local function deadly() return nemesis_compat.surge_deadly() end
local function level_name() return nemesis_engine.level_name() end

