-- Nemesis Emission Boss (round 93, user design)
-- A second boss, tied to emissions. An emission and a hunt meet (a hunt is running when the
-- emission starts, or a hunt is about to start during one): the hunt is called off and he comes
-- instead. Nowhere else does he appear.
--
--   1. You shelter indoors. The building's exits (up to EXITS_MAX) and your room are found. Round
--      128 (owner): a ring of RING_GHOSTS ghosts, RING_M around the spot you sheltered, traps you,
--      and a ghost stands at each door found. Round 130: a big building's ring stands further out.
--   2. Reach the ring and you are pushed back into it; come close to a door ghost and you are
--      pushed back inside, every tick (round 130): phantoms fly at you and a little psy damage, at
--      most once per SHOVE_COOLDOWN_MS. No door pushes in a very small room.
--   3. HAUNT_LEAD_MS later he arrives alone, outside, with a lightning strike, the teleport burst
--      and his PDA line.
--   4. HORDE_LEAD_MS before his arrival (round 147; it used to be HORDE_DELAY_MS after it) easy mutants
--      spawn past the ghosts on his side, a share of them past the far door's ghosts, and come in after you.
--   5. He walks (never runs) to the building; the ghosts never stop him. They hold until his
--      hunt ends (so since round 106, kept in round 128).
-- One emission boss at a time (force refuses a second, round 99).
--
-- He is a Sin (UNISG for Monolith, Zombified and Sin players, like every other hunt), walks
-- through the emission unharmed, never cloaks or sneaks. Every hit on him goes through the damage
-- formula with Emission boss damage reduction (round 100, nemesis_damage); NPC and mutant hits
-- are cut by Emission boss NPC damage reduction first (only him). Every other
-- boss rule holds: one boss at a time, he fights to the death, he leaves a body for you, and
-- beating his hunt halves the escalation.
--
-- The hunt itself is a normal hunt (nemesis_spawn.spawn_lone_boss): saved, followed to other
-- maps, ended by the time limit. This file adds the trigger, the haunting, the horde and his
-- own per-tick rules. S.emission_hunt marks his hunt.
--
-- The first module (round 115, restructure step 6; owner: part of the same install). The core
-- never calls this file: on_game_start (bottom) adds its answers and listeners to nemesis_events,
-- its slow job and its sections to nemesis_core, and it saves its own state under its own key.
-- Turning him off is the MCM Emission boss box, as before.
-- Used by: nobody by name (a module, see on_game_start); the kit reads state and hunt_state.
-- Uses: nemesis_state (S), nemesis_events, nemesis_core (add_job, add_uninstall_sections),
-- nemesis_spawn (spawn_lone_boss and the squad helpers), nemesis_engine (the doorway: vertices,
-- the building reads, squads), nemesis_compat (surge_manager, the psy rework, phantoms),
-- nemesis_sound, nemesis_fx, nemesis_lines, nemesis_combat (focus), nemesis_member, nemesis_mcm,
-- nemesis_utils; xlibs xsquad, xsmart and xmath.
-- src (plain reads used throughout this file, round 121): engine script_game_object_script2.cpp (level_vertex_id); engine script_game_object_script2.cpp (position); engine script_game_object_script2.cpp (section)

local S = nemesis_state.S
local NO_VERTEX = 4294967295     -- the engine's "no level vertex" (round 103: one name for it)

-- A log line tagged EMISSION (nemesis_utils.log_tag: Debug logs, or always when it starts with "!!").
local function dbg(...) nemesis_utils.log_tag("EMISSION", ...) end

-- His hunt's own state (round 115: this module's, saved under its own key). Cleared when a new
-- hunt starts (hunt_started; a follow is the same hunt), kept over a follow and a load.
local H = { horde_done = nil,      -- his horde has come this hunt
            released = nil,        -- his ghosts are gone this hunt (they do not come back after a load)
            squads = nil }         -- his horde's squad ids
-- His hunt's state starts again (a new hunt, a new game, the uninstall).
local function clear_hunt_state() H.horde_done, H.released, H.squads = nil, nil, nil end
local saved_flow = nil             -- runtime: the flow from the save, restored at the first update

-- His squads, with his own stalker sections since round 95 (configs/mod_system_nemesis_emission.ltx,
-- so the emission's ignore list holds him alone), and every section of his world objects, for the
-- uninstall sweep.
local SQUADS = { greh = "nemesis_emission_squad", isg = "nemesis_emission_squad_isg" }
local OWN_SECTIONS = { "nemesis_emission_squad", "nemesis_emission_squad_isg", "nemesis_emission_boss",
                       "nemesis_emission_boss_isg", "nemesis_horde_zombied", "nemesis_horde_snork",
                       "nemesis_horde_snork_normal", "nemesis_phantom" }
-- His squad's section for faction, or nil with an important error when his files are not loaded.
local function squad_section(faction)
    local sec = SQUADS[faction] or SQUADS.greh
    if nemesis_engine.section_exists(sec) then return sec end   -- section_exists: nemesis_engine, is this ini section there
    dbg("!!Nemesis ERROR: squad section %s not found (squad_descr_nemesis_emission.ltx is not loaded).", sec)
    return nil
end

local WAIT_INSIDE_MS  = 60000      -- not indoors this long after the trigger: he comes anyway, no ghosts
local HAUNT_LEAD_MS   = 20000      -- ghosts first, then he arrives
local HORDE_DELAY_MS  = 15000      -- user value: the mutants come this long after his arrival (now only when they could not come before him)
local HORDE_LEAD_MS   = 20000      -- the owner's value (22 October 2026): the horde comes this long before him
local RETRY_MS        = 5000       -- a failed arrival is tried again after this
local GIVE_UP_MS      = 60000      -- ... until this long after the planned arrival

-- Exits: from you outward on SCAN_HEADINGS headings, SCAN_STEP_M at a time up to SCAN_MAX_M, the
-- first outdoor vertex (xcombat.is_indoor) on a straight walkable line. A line that ends at a wall
-- inside is cast again from there (SCAN_HOP_HEADINGS headings), so doors off a corridor are found.
-- A few headings per tick: is_indoor is up to 5 ray picks.
-- The building's map sets the reach since round 129 (owner: a big hall's far end was never reached).
-- The shelter test already reads the walls (xlibs get_enclosure: the wall distances east, west,
-- north, south, up to 40 m). Each line reaches as far as that box does in its direction plus
-- SCAN_DOOR_M (through a door), between SCAN_MAX_M (never shorter than before) and SCAN_REACH_M;
-- the second casts along the walls reach the box's longest side, between SCAN_HOP_MAX_M and
-- SCAN_HOP_REACH_M; and up to EXITS_MAX doors are kept (was 3). No enclosure probe (an older
-- xlibs): the old reaches.
local SCAN_HEADINGS, SCAN_HOP_HEADINGS = 24, 12
local SCAN_STEP_M, SCAN_MAX_M, SCAN_HOP_MAX_M = 2, 30, 20
local SCAN_DOOR_M, SCAN_REACH_M, SCAN_HOP_REACH_M = 5, 60, 40
local ENC_NO_WALL_M = SCAN_REACH_M   -- no wall hit that way (xlibs' wall rays reach 40 m): the building goes on, so the full reach
local SCAN_PER_TICK = 2
local SCAN_HOPS_MAX = 6
local EXIT_MERGE_M = 4
local EXITS_MAX = 6
-- The raycast burst, the owner's design of round 132 (the round 130 play test found no door in the
-- Butcher's hangar, its lines all stopped on things near the shelter): when the lines are done,
-- BURST_HEADINGS rays go out from the shelter and from up to BURST_SPOTS more spots the lines
-- reached (BURST_SPOT_GAP_M apart), BURST_Y above the ground (under any window sill: only a door
-- or a gap in a wall lets one out), against the level's geometry only (an NPC or a crate never
-- hides a door), to BURST_PAST_M past the building's box (the walls the shelter read). A ray that
-- gets past the box found an opening; neighbouring ones are one opening, and its door is where
-- its middle ray leaves the building: the first navmesh spot on it (SCAN_STEP_M apart, no
-- further than the ray was clear) that is outside by the lines' own rule (round 130).
-- The burst's doors come first, then the lines' (merged within EXIT_MERGE_M; since round 130 the
-- lines find no false door, and in the kit's test a burst that saw fewer doors than the lines
-- would have lost real ones). On an xlibs without the ray: the lines' alone. BURST_PER_TICK rays
-- a tick: the lines already cost more (up to 5 rays per indoor read).
local BURST_HEADINGS, BURST_PER_TICK = 120, 60
local BURST_SPOTS, BURST_SPOT_GAP_M = 3, 8
local BURST_Y, BURST_PAST_M = 0.4, 3

-- The ghosts: the black poltergeist's idle effect (checked in Anomaly's particles.xr), kept
-- playing where each one is.
local GHOST_FX = "monsters\\polter_black_idle"
-- The ring, since round 128 (owner, after the RC12 test in the Butcher's hangar: the door scan is the fragile
-- part in a big building): a ring of RING_GHOSTS ghosts, RING_M around the spot where your
-- shelter was confirmed, evenly spaced, each on the navmesh where it stands. A ring point with no
-- navmesh under it (inside a wall, a rock, another building's wall) gets no ghost: level.vertex_id
-- answers no vertex for such a point (xray-monolith MT level_graph.cpp, CLevelGraph::vertex_id).
-- Past RING_PUSH_M from the centre you are pushed RING_BACK_M back toward it: the ring traps you
-- (owner: only back into the ring). And a ghost stands at each door the exit scan found: within
-- GHOST_PUSH_M of one you are pushed back inside, toward the shelter (owner: they block the door).
-- They all hold until his hunt ends. Owner: 12 ghosts, 16 if it needs to be tighter.
-- Further out in a big building since round 130 (owner): the ring stands RING_PAST_WALL_M past the
-- building's farthest wall the exit scan read, never closer than RING_M; the push comes
-- RING_M - RING_PUSH_M inside it, as before.
local RING_M, RING_GHOSTS = 55, 12
local RING_PUSH_M, RING_BACK_M = 53, 6
local RING_PAST_WALL_M = 25
-- Spots off solid ground, since round 131 (owner's play test: 6 of 12 ring spots in solid ground, a gap at one end): a spot
-- with no navmesh tries these instead, in order, and the first on the navmesh gets the ghost:
-- { metres out (+) or in (-), a share of the step to the next ghost along the ring }.
local RING_FILL = { { 5, 0 }, { -5, 0 }, { 10, 0 }, { -10, 0 }, { 0, 0.25 }, { 0, -0.25 },
                    { 5, 0.25 }, { 5, -0.25 }, { -5, 0.25 }, { -5, -0.25 }, { 0, 0.45 }, { 0, -0.45 } }
local GHOST_PUSH_M = 3.5
-- Side ghosts, since round 132 (owner: at least 2 ghosts per door, preferably 3, to fill any gaps): beside each
-- door's ghost, one each side across the door (DOOR_SIDE_M along the wall, then nearer), each
-- on the navmesh; a side in the wall gets its ghost DOOR_SIDE_M further out instead, so every
-- door has at least 2. Each stands outside, as the door's own ghost (a door reached at an angle
-- tilts "across", and a side spot could fall back inside). Their reach (GHOST_PUSH_M each)
-- closes a door about 11 m wide.
local DOOR_SIDE_M = { 2, 1.2 }
-- A shelter under SMALL_ROOM_M2 (the scan's floor plan, measured to the last walkable spot
-- before each wall, so about 5 x 5 m in reality) gets no door pushes and no psy damage there
-- (user: too small a room, the psy would hit from both sides); the ring still holds.
local SMALL_ROOM_M2 = 12
local SHOVE_BACK_M = 1.5
local SHOVE_COOLDOWN_MS = 1500
-- A real shelter, since round 116 (play: the ghosts came while a friend ran to a building, and pushed him out). One
-- indoor read is not a shelter: xcombat.is_indoor reads a roof within 4 m and walls within 5 m on
-- 2 of 4 sides, so a porch, an awning by a wall or a doorway can read indoor for a moment as you
-- run past. The haunting starts only after SHELTER_MS indoors without a single outdoor read in
-- between (owner: 3 s). Every push must take you closer to the shelter (round 128: the ring's
-- centre), or it is not made.
local SHELTER_MS = 3000
-- The owner's rule of round 116: the shelter must be emission cover too, as the emission decides it
-- (nemesis_compat.actor_in_surge_cover: the level's cover zones, not the roof), and indoors (a
-- building to haunt: a tent is cover but has no doors). Both, for SHELTER_MS in a row.
local SKIP_LOG_MS = 5000           -- a skipped push is logged at most this often
-- The wait's debug line, since round 127 (owner's RC12 test: in the Butcher's hangar the log only said "you are not indoors"
-- after a minute): with Debug logs on, every WAIT_LOG_MS of his wait one line says what the
-- shelter test reads where you stand: building or not, with the roof and the four wall distances
-- (xlibs get_enclosure, east, west, north, south; "-" = no hit), emission cover, how long you
-- have been inside, and how long until he comes without the ghosts.
local WAIT_LOG_MS = 5000
local SHOVE_PPE = "psychic.ppe"    -- the emission's own psy jolt (surge_manager)
local SHOVE_PPE_ID = 93101
-- Phantoms (vanilla m_phantom, our own section with no contact damage, configs/mod_system_nemesis_phantom.ltx):
-- they fly at you when you are shoved. The psy damage is our own (psy_hit).
local PHANTOM_SECTION = "nemesis_phantom"
local PHANTOMS_PER_SHOVE = 2
local PHANTOMS_MAX = 4

-- His arrival: the psi storm's lightning strike (particles.xr) and the teleport burst. The strike's
-- own sound has its own slider, off by default (round 99, play: it doubled the emission's sound).
-- Never the blowout impact files: they are the emission's own sounds (round 99).
local LIGHTNING_FX = "crommcruac\\psi_storm_01"
local LIGHTNING_SOUNDS = { "anomaly\\psi_storm_01" }

-- The horde ("not too hard", by map tier, user design): zombies (zombified stalkers), and on
-- later maps a snork or two. Two squads of our own sections (squad_descr_nemesis_emission.ltx, his own file), one
-- species each. Everyone in it and the boss leave each other alone (on_enemy_eval).
local HORDE_ZOMBIES = { "sim_default_zombied_0", "sim_default_zombied_1", "sim_default_zombied_2" }
local HORDE_SNORK_WEAK, HORDE_SNORK = "snork_weak", "snork_normal"
-- A squad's leader is its section's own npc (sim_squad_scripted.create_npc reads it), so tier
-- 4 and 5 maps get a squad section whose leader is a snork_normal (round 95).
local HORDE_SQUAD_ZOMBIE, HORDE_SQUAD_SNORK, HORDE_SQUAD_SNORK_NORMAL = "nemesis_horde_zombied", "nemesis_horde_snork", "nemesis_horde_snork_normal"

local em = nil                     -- runtime: the trigger, the haunting and the ghosts (see begin)
local roll = nil                   -- this emission's roll: nil (not rolled), true, false
local extra = nil                  -- this emission's own roll (Emission boss extra chance) is used
local again = false                -- his hunt was called off offline (core): he takes the next one
local again_exits = nil            -- ... with the exits found before (his ring is cast from them)
local force_next = false           -- MCM "Force the next hunt: Emission boss"
local psy_at = nil                 -- runtime: the last ghost psy hit (PSY_COOLDOWN_MS)
local horde_job = nil              -- runtime: horde members still to add, one per tick
local allies = {}                  -- [id] = true: the boss and his horde (they never fight each other)
local allies_any = false
local immune = nil                 -- { sec, old }: his section on the emission's ignore list

-- One emission boss at a time (round 99, play: a second pick of the list while he was coming
-- brought a second one the moment his hunt ended). Refused while he is coming, hunting or
-- following you; the debug list too.
function force()
    if em or S.emission_hunt or own_follow_now() or force_next then
        nemesis_utils.log_tag("EMISSION", "Nemesis: the emission boss is already on his way; a second one is refused (MCM).")
        -- send_news, text: nemesis_lines, a PDA message and a string table's text
        nemesis_lines.send_news(nemesis_lines.text("st_nemesis_em_msg_on_his_way"), nemesis_lines.text("st_nemesis_caption"))
        return false
    end
    force_next = true
    return true
end

-- Whether the squad following you to this map is his hunt.
function own_follow_now() return S.follow ~= nil and S.follow.emission_hunt == true end

---------------------------------------------------------------------------
-- Settings
---------------------------------------------------------------------------
-- His default name from his own string table (round 134: in Russian, Ilarion Grekh in Cyrillic).
local function default_name() return nemesis_lines.text("st_nemesis_em_boss_name") end
-- His name: MCM Emission boss name, else his default, with its spaces put back.
-- spaced_name: nemesis_utils, spaces before capitals; get_string: nemesis_mcm, a menu text box
function boss_name() return nemesis_utils.spaced_name(nemesis_mcm.get_string("emission_name", default_name())) end

-- MCM Emission boss (on or off).
local function enabled() return nemesis_mcm.get_bool("emission_enabled", true) end   -- get_bool: nemesis_mcm, a menu checkbox (cached)

-- An MCM number, held to lo..hi.
local function setting(id, def, lo, hi)
    return math.max(lo, math.min(hi, nemesis_mcm.get_number(id, def)))   -- get_number: nemesis_mcm, a menu number (cached)
end

-- Emission boss chance (0 when he is off).
local function chance() return enabled() and setting("emission_chance", 100, 0, 100) or 0 end
-- Emission boss extra chance: rolled once per emission, no hunt needed.
local function extra_chance() return enabled() and setting("emission_extra", 6, 0, 100) or 0 end
-- The part of an NPC's or a mutant's hit on him that is cut (0..0.95).
function npc_cut() return setting("emission_npc_cut", 70, 0, 95) / 100 end
-- The share of your psy bar a shove takes (0..0.20).
local function psy_damage() return setting("emission_psy", 4, 0, 20) / 100 end
-- How many mutants his horde brings (0..8).
local function horde_size() return math.floor(setting("emission_horde", 4, 0, 8) + 0.5) end
-- Horde flank share as 0..0.5, through setting (the menu number, held to its range): the part of
-- the horde that comes from the far door's side (added in round 147). Used by spawn_horde.
local function flank_share() return setting("emission_flank", 30, 0, 50) / 100 end

-- Sin, or UNISG for players the Sin would not hunt (Monolith, Zombified, Sin), like every hunt.
function faction_for_player()
    return nemesis_utils.faction_for_player() == "isg" and "isg" or "greh"   -- faction_for_player: nemesis_utils, the hunt's faction
end

-- An emission (or a psi storm) is on, and its deadly part (from its first wave) has begun; the
-- current map. Through the doorways (round 109): nemesis_compat for surge_manager, nemesis_engine.
local function surge() return nemesis_compat.surge_on() end   -- surge_on: nemesis_compat, xlibs' is_surge
-- The deadly part has begun (see above).
local function deadly() return nemesis_compat.surge_deadly() end   -- surge_deadly: nemesis_compat, from the first wave
-- The current map's name (see above).
local function level_name() return nemesis_engine.level_name() end   -- level_name: nemesis_engine, this map's name

