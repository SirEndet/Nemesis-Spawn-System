function on_mcm_load()
    return options()
end

local PAGE_OF = {}
for _, page in ipairs(options().gr) do
    for _, o in ipairs(page.gr) do
        if o.val then PAGE_OF[o.id] = { page = page.id, val = o.val } end
    end
end

function path(id)
    local e = PAGE_OF[id]
    return e and ("nemesis/" .. e.page .. "/" .. id) or ("nemesis/" .. id)
end

local migrated = false
function migrate()
    if migrated then return end
    local cfg = axr_main and axr_main.config
    if not cfg then return end
    migrated = true
    local moved = 0
    pcall(function()
        for id, e in pairs(PAGE_OF) do
            local new = path(id)
            if cfg:r_value("mcm", new, e.val) == nil then
                local old = cfg:r_value("mcm", "nemesis/" .. id, e.val)
                if old ~= nil then
                    cfg:w_value("mcm", new, old)
                    moved = moved + 1
                end
            end
        end
        if moved > 0 then cfg:save() end
    end)
    if moved > 0 and printf then printf("Nemesis: %s settings moved to the new MCM pages.", tostring(moved)) end
end

local cache = {}
local cache_at = nil
local CACHE_MS = 5000

function invalidate()
    cache = {}
    cache_at = nil
end

function on_option_change() invalidate() end

function on_game_start()
    migrate()
    RegisterScriptCallback("on_option_change", on_option_change)
end

function get_setting(id, default)
    local now = time_global and time_global() or 0
    if cache_at == nil or now - cache_at > CACHE_MS or now < cache_at then
        cache = {}
        cache_at = now
    end
    local v = cache[id]
    if v ~= nil then return v end
    if ui_mcm then
        v = ui_mcm.get(path(id))
        if v ~= nil then
            cache[id] = v
            return v
        end
    end
    return default
end

function get_number(id, default)
    local v = tonumber(get_setting(id, default))
    if v == nil then return default end
    return v
end

function get_bool(id, default)
    local v = get_setting(id, default)
    if type(v) == "boolean" then return v end
    if v == 1 or v == "1" or v == "true" then return true end
    if v == 0 or v == "0" or v == "false" then return false end
    return default
end

function get_string(id, default)
    local v = get_setting(id, default)
    if type(v) ~= "string" then return default end
    v = string.gsub(v, ":", "")
    v = string.gsub(v, "^%s+", "")
    v = string.gsub(v, "%s+$", "")
    if v == "" then return default end
    return v
end
