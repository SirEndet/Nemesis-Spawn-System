-- Nemesis MCM Configuration

HEAD_CLR = { 255, 250, 150, 75 }

local provider

local PAGES = { "general", "nemesis_spawn", "nemesis_damage", "nemesis_boss", "nemesis_emission", "debug" }

provider = function(name)
    local m = rawget(_G, name)
    if m == nil and nemesis_engine and nemesis_engine.file_exists("$game_scripts$", name .. ".script") then
        pcall(function() m = _G[name] end)
    end
    if type(m) == "table" and type(m.mcm_page) == "function" then return m end
    return nil
end

local function force_next_choices()
    local list = { { "none", "ui_mcm_nemesis_force_next_none" } }
    for _, name in ipairs(PAGES) do
        local m = provider(name)
        if m and type(m.mcm_force_next) == "function" then
            local ok, c = pcall(m.mcm_force_next)
            if ok and type(c) == "table" then list[#list + 1] = c end
        end
    end
    return list
end

local function sound_section()
    local m = rawget(_G, "nemesis_sound")
    if m == nil and nemesis_engine and nemesis_engine.file_exists("$game_scripts$", "nemesis_sound.script") then
        pcall(function() m = _G["nemesis_sound"] end)
    end
    if not (type(m) == "table" and type(m.mcm_sound_section) == "function") then return {} end
    local ok, t = pcall(m.mcm_sound_section)
    return ok and type(t) == "table" and t or {}
end
local function with_sound(items)
    local out = {}
    for _, o in ipairs(items) do
        if o.id == "line_effects" then for _, x in ipairs(sound_section()) do out[#out + 1] = x end end
        out[#out + 1] = o
    end
    return out
end

local function general_page()
    return { id = "general", sh = true, text = "ui_mcm_nemesis_page_general", gr = with_sound({
            { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_nemesis_title", size = {512, 50}, spacing = 20 },
            { id = "difficulty", type = "list", val = 0, def = "medium", no_str = true, hint = "nemesis_difficulty",
              on_selection_functor = { on_difficulty_selected },
              content = { { "easy", "ui_mcm_nemesis_difficulty_easy" }, { "medium", "ui_mcm_nemesis_difficulty_medium" },
                          { "hard", "ui_mcm_nemesis_difficulty_hard" }, { "custom", "ui_mcm_nemesis_difficulty_custom" } } },
            { id = "load_custom_backup", type = "check", val = 1, def = false, hint = "nemesis_load_custom_backup" },
            { id = "line_warnings", type = "line" },
            { id = "head_warnings", type = "title", text = "ui_mcm_nemesis_head_warnings", align = "l", clr = HEAD_CLR },
            { id = "warning_audio", type = "check", val = 1, def = true, hint = "nemesis_warning_audio" },
            { id = "warning_pda", type = "check", val = 1, def = false, hint = "nemesis_warning_pda" },
            { id = "hd_icon", type = "check", val = 1, def = false, hint = "nemesis_hd_icon" },
            { id = "line_effects", type = "line" },
            { id = "head_effects", type = "title", text = "ui_mcm_nemesis_head_effects", align = "l", clr = HEAD_CLR },
            { id = "wd_malfunction", type = "check", val = 1, def = true, hint = "nemesis_wd_malfunction" },
        }) }
end

local function debug_page()
    return { id = "debug", sh = true, text = "ui_mcm_nemesis_page_debug", gr = {
            { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_nemesis_title", size = {512, 50}, spacing = 20 },
            { id = "head_debug", type = "title", text = "ui_mcm_nemesis_head_debug", align = "l", clr = HEAD_CLR },
            { id = "debug_mode", type = "check", val = 1, def = false, hint = "nemesis_debug_mode" },
            { id = "debug_logs", type = "check", val = 1, def = false, hint = "nemesis_debug_logs" },
            { id = "force_next", type = "list", val = 0, def = "none", no_str = true, hint = "nemesis_force_next",
              content = force_next_choices() },
            { id = "line_tools", type = "line" },
            { id = "head_tools", type = "title", text = "ui_mcm_nemesis_head_tools", align = "l", clr = HEAD_CLR },
            { id = "reset_escalation_now", type = "check", val = 1, def = false, hint = "nemesis_reset_escalation_now" },
            { id = "prepare_uninstall", type = "check", val = 1, def = false, hint = "nemesis_prepare_uninstall" },
        } }
end

local function pages()
    local out, missing = {}, false
    for _, name in ipairs(PAGES) do
        local page = nil
        if name == "general" then page = general_page()
        elseif name == "debug" then page = debug_page()
        else
            local m = provider(name)
            if m then
                local ok, t = pcall(m.mcm_page)
                if ok and type(t) == "table" then page = t else missing = true end
            elseif rawget(_G, name) ~= nil then
                missing = true
            end
        end
        if page then out[#out + 1] = page end
    end
    return out, missing
end

local function options() return { id = "nemesis", gr = (pages()) } end

function on_mcm_load()
    register_apply_handler()
    build()
    return options()
end

local PAGE_OF = {}
local built = false
function build()
    if built then return end
    local list, missing = pages()
    for _, page in ipairs(list) do
        for _, o in ipairs(page.gr) do
            if o.val then PAGE_OF[o.id] = page.id end
        end
    end
    for _, name in ipairs(PAGES) do
        local m = provider(name)
        if m and type(m.mcm_presets) == "function" then
            local ok, t = pcall(m.mcm_presets)
            if ok and type(t) == "table" then
                for level, vals in pairs(t) do
                    if DIFFICULTY[level] then for id, v in pairs(vals) do DIFFICULTY[level][id] = v end end
                end
            end
        end
    end
    built = not missing
end

function path(id)
    build()
    local page = PAGE_OF[id]
    return page and ("nemesis/" .. page .. "/" .. id) or ("nemesis/" .. id)
end

DIFFICULTY = { easy = {}, medium = {}, hard = {} }

local APPLIED_SECTION, APPLIED_KEY = "nemesis", "difficulty_applied"
local applied_mem = nil

local function read_applied()

    local ok, v = pcall(function() return axr_main.config:r_value(APPLIED_SECTION, APPLIED_KEY, 0) end)
    if not ok then return applied_mem end
    if type(v) == "string" and v ~= "" then return v end
    return nil
end

local function write_applied(level)
    applied_mem = level
    pcall(function()

        axr_main.config:w_value(APPLIED_SECTION, APPLIED_KEY, level)

        axr_main.config:save()
    end)
end

local function set_value(id, v)

    pcall(function() ui_mcm.set(path(id), v) end)
end

local function raw_number(id)
    local v = nil

    pcall(function() v = tonumber(ui_mcm.get(path(id))) end)
    return v
end

local function matches(level)
    build()
    local preset = DIFFICULTY[level]
    if not preset then return false end
    for id, want in pairs(preset) do
        local have = raw_number(id)
        if have == nil or math.abs(have - want) > 0.001 then return false end
    end
    return true
end

local function current_difficulty()
    local v = nil

    pcall(function() v = ui_mcm.get(path("difficulty")) end)
    if v == "easy" or v == "medium" or v == "hard" or v == "custom" then return v end
    return "medium"
end

local function log(...)
    if nemesis_utils and nemesis_utils.log_tag then nemesis_utils.log_tag("MCM", ...)
    elseif printf and get_bool("debug_logs", false) then printf(...) end
end

local BACKUP_SECTION = "custom_backup"

local function values_are_yours()
    return not (matches("easy") or matches("medium") or matches("hard"))
end

local function backup_custom(why)
    build()
    if not (nemesis_config and values_are_yours()) then return end
    local want, n = {}, 0
    for id in pairs(DIFFICULTY.medium) do
        local v = raw_number(id)
        if v ~= nil then nemesis_config.set(BACKUP_SECTION, id, v); want[id] = v; n = n + 1 end
    end
    if n == 0 then return end
    nemesis_config.set(BACKUP_SECTION, "from", why)
    local res, key = nemesis_config.save_checked(BACKUP_SECTION, want)
    if res == "failed" then
        log("!Nemesis ERROR: the automatic backup of your settings did not save (%s).", tostring(key))
    else
        log("Nemesis: your own settings (%s) backed up to %s before a difficulty is applied (%s%s).", tostring(n),
            nemesis_config.FILE, why, res == "unverified" and "; a new file, checked from the next game start" or "")
    end
end

function load_custom_backup()
    build()
    if not nemesis_config then return 0 end
    local n = 0
    for id in pairs(DIFFICULTY.medium) do
        local v = nemesis_config.get(BACKUP_SECTION, id, 2, nil)
        if v ~= nil then set_value(id, v); n = n + 1 end
    end
    if n == 0 then
        log("Nemesis: Load settings from Automatic Backup: there is no backup yet (one is made when a difficulty replaces your own settings).")
        return 0
    end
    set_value("difficulty", "custom")
    write_applied("custom")
    invalidate()
    log("Nemesis: %s settings loaded from the automatic backup (%s); the difficulty shows Custom. The backup is kept.",
        tostring(n), tostring(nemesis_config.get(BACKUP_SECTION, "from", nil, "?")))
    return n
end

function sync_difficulty(picked)
    build()
    if not ui_mcm then return end
    local cur = current_difficulty()
    local last = read_applied()
    local apply = cur ~= "custom" and (picked or (last ~= nil and cur ~= last) or (last == nil and cur ~= "medium"))
    if apply then
        backup_custom("applied " .. cur)
        for id, v in pairs(DIFFICULTY[cur]) do set_value(id, v) end
        write_applied(cur)
        invalidate()
        log("Nemesis: difficulty %s applied (last applied: %s).", cur, tostring(last))
        return
    end
    if cur ~= "custom" and not matches(cur) then
        set_value("difficulty", "custom")
        write_applied("custom")
        invalidate()
        log("Nemesis: difficulty %s no longer matches its settings (changed by hand): Custom.", cur)
        return
    end
    if last ~= cur then write_applied(cur) end
end

local cache = {}
local cache_at = nil
local CACHE_MS = 5000

local version = 0

function invalidate()
    cache = {}
    cache_at = nil
    version = version + 1
end

function settings_version() return version end

function on_option_change()
    invalidate()
    sync_difficulty()
end

local main_menu_ref = nil
local function remember_main_menu(mm) main_menu_ref = mm end

local function mcm_window()
    local w = nil
    pcall(function() w = main_menu_ref and main_menu_ref.mcm_dlg end)
    if w and w.CacheValue and w.Reset_opt then return w end
    return nil
end

function on_difficulty_selected(opt_path, opt, value, v)
    build()
    local preset = DIFFICULTY[value]
    if not preset then return end
    backup_custom("picked " .. tostring(value) .. " in the menu")
    local gui = mcm_window()
    if not gui then return end
    for id, val in pairs(preset) do
        local page = PAGE_OF[id]
        if page then
            pcall(function()
                local p = "nemesis/" .. page

                gui:CacheValue(p, id, val, ui_mcm.get_opt_table(p .. "/" .. id))
            end)
        end
    end

    pcall(function() gui:Reset_opt(gui.last_curr_tree, gui.last_path) end)

    pcall(function() gui:UpdatePending() end)
end

function on_mcm_option_change(changes)
    invalidate()
    local picked = type(changes) == "table" and changes[path("difficulty")] ~= nil
    sync_difficulty(picked)
end

function register_apply_handler()
    if not (ui_mcm and ui_mcm.get) then return end

    RegisterScriptCallback("mcm_option_change", on_mcm_option_change)
    RegisterScriptCallback("main_menu_on_init", remember_main_menu)
end

function on_game_start()

    RegisterScriptCallback("on_option_change", on_option_change)
    register_apply_handler()
end

function get_setting(id, default)
    local now = time_global and time_global() or 0
    if cache_at == nil or now - cache_at > CACHE_MS or now < cache_at then
        cache = {}
        cache_at = now
    end
    local v = cache[id]
    if v ~= nil then return v end
    if ui_mcm then

        v = ui_mcm.get(path(id))
        if v ~= nil then
            cache[id] = v
            return v
        end
    end
    return default
end

function get_number(id, default)
    local v = tonumber(get_setting(id, default))
    if v == nil then return default end
    return v
end

function get_bool(id, default)
    local v = get_setting(id, default)
    if type(v) == "boolean" then return v end
    if v == 1 or v == "1" or v == "true" then return true end
    if v == 0 or v == "0" or v == "false" then return false end
    return default
end

NAME_MAX = 48
function get_string(id, default)
    local v = get_setting(id, default)
    if type(v) ~= "string" then return default end
    v = string.gsub(v, ":", "")
    v = string.gsub(v, "^%s+", "")
    v = string.gsub(v, "%s+$", "")
    if v == "" then return default end

    if #v > NAME_MAX then v = string.sub(v, 1, NAME_MAX) end
    return v
end
