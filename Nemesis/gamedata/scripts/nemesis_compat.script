-- Nemesis Compat: the doorway to every other mod (made in round 109). Each part is detected at

local function dbg(...) nemesis_utils.log_tag("COMPAT", ...) end

---------------------------------------------------------------------------
-- GAMMA ballistics (grok_bo)
---------------------------------------------------------------------------

function grok_bo()
    local gbo = nil
    pcall(function() gbo = _G["grok_bo"] end)
    if type(gbo) ~= "table" or type(gbo.npc_on_before_hit) ~= "function" or type(gbo.custom_bone_value) ~= "table" then return nil end
    return gbo
end

---------------------------------------------------------------------------
-- GAMMA psy rework (arszi_psy)
---------------------------------------------------------------------------

function psy_rework()
    local lib = nil
    pcall(function() lib = _G["arszi_psy"] end)
    if type(lib) ~= "table" or type(lib.change_psy_health) ~= "function"
        or type(lib.get_psy_health) ~= "function" then return nil end

    local ok, v = pcall(lib.get_psy_health)
    if not ok or type(v) ~= "number" then return nil end
    return lib
end

---------------------------------------------------------------------------
-- Wearable Devices (sulikz)
---------------------------------------------------------------------------

local wd_api, wd_api_file = nil, nil

function wearable()
    if wd_api == nil then
        wd_api = false
        local file = nemesis_engine.file_exists("$game_scripts$", "wd_attach.script")
        if file then
            pcall(function() wd_api = wd_attach and wd_attach.hide_screens and wd_attach.show_screens and wd_attach or false end)
        end
        wd_api_file = file
    end
    return wd_api
end

function wearable_file() return wd_api_file == true end

---------------------------------------------------------------------------
-- The Wearable Devices PDA mod (realzelda414, BennyDollaz)
---------------------------------------------------------------------------

local wd_pda_api = nil

function wd_pda()
    if wd_pda_api == nil then
        wd_pda_api = false
        if nemesis_engine.file_exists("$game_scripts$", "zz_wd_pda_redirect.script") then
            pcall(function()
                local t = zz_wd_pda_redirect and zz_wd_pda_redirect.wd_pda_redirect
                if type(t) == "table" and type(t.push_external_faction) == "function" then wd_pda_api = t end
            end)
            if not wd_pda_api then dbg("!zz_wd_pda_redirect.script found but not its push_external_faction; our messages stay off its page.") end
        end
    end
    return wd_pda_api
end

---------------------------------------------------------------------------
-- AlifeTactics (damian_sirbu)
---------------------------------------------------------------------------
local at_found = nil

function alifetactics()
    if at_found == nil then
        at_found = false
        if nemesis_engine.file_exists("$game_scripts$", "at_reaction.script") then
            pcall(function() at_found = type(at_reaction) == "table" and type(at_reaction.apply) == "function" end)
        end
    end
    return at_found
end

function rank_levers(obj, vision, burst)
    if not obj then return false end
    local ok = false
    pcall(function()

        ok = xcombat.set_vision_speed(obj, vision) == true

        xcombat.set_view_distance_factor(obj, vision)

        xcombat.set_fire_queue_scale(obj, burst, -1)
    end)
    return ok
end

---------------------------------------------------------------------------
-- AlifePlus
---------------------------------------------------------------------------
local ap_found, ap_next_try = nil, 0

function alifeplus()
    if ap_found then return ap_found end
    local now = time_global()
    if now < ap_next_try then return nil end
    ap_next_try = now + 60000
    local t = nil
    pcall(function() t = ap_api end)
    if type(t) == "table" then ap_found = t end
    return ap_found
end

---------------------------------------------------------------------------
-- Obrien GAMMA Overhaul
---------------------------------------------------------------------------

function obrien_item_stats(sec, cond)

    local br = ini_sys:r_float_ex(sec, "br_class") or 0
    local pct = ini_sys:r_float_ex(sec, "hit_fraction_actor") or 0
    return br * cond, pct * cond
end

local obrien_found = false
local obrien_checked = {}
local OBRIEN_PROBES = { "novice_outfit", "stalker_outfit", "helm_respirator" }

local function obrien_check(sec)
    if obrien_found or not sec or obrien_checked[sec] then return end
    obrien_checked[sec] = true
    local has = false

    pcall(function() has = ini_sys:line_exist(sec, "br_class") == true end)
    if has then
        obrien_found = true
        dbg("Nemesis: Obrien GAMMA Overhaul detected (%s has br_class); hunters copy its armour.", tostring(sec))
    end
end

function reset_obrien() obrien_found, obrien_checked = false, {} end

function obrien_on(outfit_sec, helmet_sec)
    for _, sec in ipairs(OBRIEN_PROBES) do obrien_check(sec) end
    obrien_check(outfit_sec)
    obrien_check(helmet_sec)
    return obrien_found
end

---------------------------------------------------------------------------
-- Emissions: surge_manager and its ignore list
---------------------------------------------------------------------------

function surge_on()
    local on = false

    pcall(function() on = xlevel.is_surge() == true end)
    return on
end

function surge_kind()
    local kind = nil
    pcall(function()
        local p = _G["psi_storm_manager"]

        if type(p) == "table" and p.is_loaded and p.is_loaded() and p.is_started() then
            kind = "psi_storm"
            return
        end
        local m = _G["surge_manager"]

        if type(m) == "table" and m.is_loaded and m.is_loaded() and m.is_started() then
            kind = "emission"
        end
    end)
    return kind
end

function surge_deadly()
    local ok, on = pcall(function()
        local m = _G["surge_manager"]

        if type(m) ~= "table" or not (m.is_started and m.is_started()) then return true end

        local sm = m.get_surge_manager()
        return sm.effector_set == true or (sm.stages ~= nil and sm.stages["1stwavesnd"] == true)
    end)
    return not ok or on == true
end

function actor_in_surge_cover()
    if type(GetEvent) ~= "function" then return nil end

    local ok, v = pcall(GetEvent, "current_safe_cover")
    if not ok then return nil end
    return v ~= nil and v ~= false
end

function surge_ignore_list()
    local t = nil
    pcall(function() t = surge_manager_ignore_npc.ignore_npc end)
    return type(t) == "table" and t or nil
end

---------------------------------------------------------------------------
-- Phantoms (vanilla phantom_manager)
---------------------------------------------------------------------------

function phantom_count(sec)
    local live = 0

    pcall(function() live = phantom_manager.dynamic_phantom_count(sec) or 0 end)
    return live
end

---------------------------------------------------------------------------
-- The downed state (xr_wounded; GAMMA's is Modular Tweaks')
---------------------------------------------------------------------------

function no_downed(id)
    local st = db.storage[id]
    local w = st and st.wounded
    if not (w and w.wounded_set) then return end
    w.wounded_set = false
    if w.wound_manager then w.wound_manager.state, w.wound_manager.sound = "nil", "nil" end
    local o = nemesis_engine.obj(id)
    if o then

        nemesis_engine.save_var(o, "wounded_state", "nil")
        nemesis_engine.save_var(o, "wounded_sound", "nil")
        nemesis_engine.save_var(o, "wounded_fight", "true")
        nemesis_engine.save_var(o, "wounded_victim", "nil")
    end
end

local function log_msg(...) return nemesis_utils.log_msg(...) end

function exe_ai_on() return nemesis_mcm.get_bool("exe_ai", true) end

function register_post(name, fn)
    if type(RegisterScriptCallbackPost) == "function" then

        if pcall(RegisterScriptCallbackPost, name, fn) then return true end
    end

    RegisterScriptCallback(name, fn)
    return false
end

local held = {}
local hold_logged = false

function hold_still(obj)
    if not obj or not exe_ai_on() then return false end

    local ok, done = pcall(xcombat.set_movement_hold, obj, true)
    if not (ok and done) then return false end
    held[obj:id()] = true
    if not hold_logged then
        hold_logged = true
        log_msg("Nemesis: engine movement hold in use (latest exes).")
    end
    return true
end

function is_held(id) return id ~= nil and held[id] == true end

local BIAS_ACTOR = 1800
local REDIRECT_FALLOFF_M = 60

local function attack_pull(boss)
    local v = boss and nemesis_mcm.get_number("boss_attack_pull", 300) or nemesis_mcm.get_number("hunter_attack_pull", 600)
    if v < 0 then v = 0 end
    if v > 1800 then v = 1800 end
    return v > 0 and v or -1
end
local AI_REFRESH_MS = 2000
local ai_logged = false

function apply_ai(obj, r, gt)
    if not (obj and r and r.named) then return end
    if exe_ai_on() then
        if r.ai_at and gt - r.ai_at < AI_REFRESH_MS then return end
        r.ai_at = gt
        local boss = r.id == nemesis_state.S.boss_id

        local ok1, b = pcall(xcombat.set_visible_enemy_bias, obj, BIAS_ACTOR, -1)

        local ok2, h = pcall(xcombat.set_hit_redirect, obj, attack_pull(boss), REDIRECT_FALLOFF_M)
        r.ai_set = ((ok1 and b) or (ok2 and h)) and true or nil
        if r.ai_set and not ai_logged then
            ai_logged = true
            log_msg("Nemesis: engine target bias and hit redirect in use (latest exes).")
        end
    elseif r.ai_set then
        r.ai_set, r.ai_at = nil, nil
        pcall(xcombat.set_visible_enemy_bias, obj, -1, -1)
        pcall(xcombat.set_hit_redirect, obj, -1, 0)
    end
end

function release_hold(id, obj)
    if not (id and held[id]) then return end
    held[id] = nil

    if obj then pcall(xcombat.set_movement_hold, obj, false) end
end

---------------------------------------------------------------------------
-- Dynamic Faction Relations Customizer, when installed (round 186)
---------------------------------------------------------------------------

local dfrc_hooked = false
local dfrc_skip_logged = false
local dfrc_skip_section = nil

local function dfrc_skipped(t) return type(t) == "table" and dfrc_skip_section ~= nil and t.section == dfrc_skip_section end

local function dfrc_relation_wrap(orig, victim_tbl, killer_tbl, ...)
    if dfrc_skipped(victim_tbl) or dfrc_skipped(killer_tbl) then
        if not dfrc_skip_logged then
            dfrc_skip_logged = true
            dbg("Nemesis: DFRC: a death with the Thunder Boss moves no faction's relations (logged once).")
        end
        return
    end
    return orig(victim_tbl, killer_tbl, ...)
end

function hook_dfrc_skip(section)
    dfrc_skip_section = section
    if dfrc_hooked then return true end

    if not nemesis_engine.file_exists("$game_scripts$", "dynamic_faction_relations_customizer.script") then return false end
    local dfrc = nil
    pcall(function() dfrc = dynamic_faction_relations_customizer end)
    if not (type(dfrc) == "table" and type(dfrc.calculate_relation_change) == "function") then return false end
    local how = nil
    local have_xevent = type(xevent) == "table" and type(xevent.register_hook) == "function"
    local taken = false
    if have_xevent then

        pcall(function() taken = xevent.is_hooked("dynamic_faction_relations_customizer", "calculate_relation_change") == true end)
        if not taken then

            local ok, done = pcall(xevent.register_hook, "dynamic_faction_relations_customizer", "calculate_relation_change", dfrc_relation_wrap)
            if ok and done then how = "xlibs xevent hook" end
        end
    end
    if not how then
        local orig = dfrc.calculate_relation_change

        dfrc.calculate_relation_change = function(...) return dfrc_relation_wrap(orig, ...) end
        how = (taken and "wrapped on top of another mod's xevent hook")
            or (have_xevent and "wrapped (xevent refused the hook)")
            or "wrapped (this xlibs has no xevent)"
    end
    dfrc_hooked = true
    dbg("Nemesis: DFRC found: deaths with the Thunder Boss move no faction's relations (%s).", how)
    return true
end

---------------------------------------------------------------------------
-- Interaction Dot Marks (Catspaw), when installed
---------------------------------------------------------------------------

function forget_dot_mark(id)
    if not id then return end
    pcall(function()

        if ui_hud_dotmarks and ui_hud_dotmarks.unregister_scanned_entity then ui_hud_dotmarks.unregister_scanned_entity(id) end
    end)
end

---------------------------------------------------------------------------
-- Runtime
---------------------------------------------------------------------------

function forget_runtime()
    wd_api, wd_api_file = nil, nil
    wd_pda_api = nil
    at_found = nil
end
