-- Nemesis Core

local S = nemesis_state.S

local TICK_IDLE_MS     = 2000
local TICK_HUNT_MS     = 250
local SLOW_MS          = 2000
local OFFLINE_LIMIT_MS = 90000
local RETREAT_GRACE_MS = 8000
local RETREAT_COVER_RADIUS_M = 20
local RETREAT_COVER_AHEAD_M = 10
local RETREAT_MIN_RUN_M = 6
local RETREAT_FLEE_M = 15
local RETREAT_COVER_MS = 4000

local loaded_flag = false
local load_vanish = {}
local next_tick = 0
local next_slow = 0
local chase_install_warned = false

local function dbg(...) nemesis_utils.log_msg(...) end

local XLIBS_API = {
    xsquad = { "set_target_actor", "iterate_member_ids", "release_squad" },
    xsmart = { "get_named_smarts", "is_base", "assign_squad_to_smart" },
    xlevel = { "get_level_id", "get_danger_tier" },
    xsound = { "play", "create_sound", "set_volume", "release" },
    xcombat = { "find_cover", "register_cover", "release_cover", "find_flee_lane", "get_track_pos",
                "get_weapon_kind", "set_destination", "show_enemy", "COVER", "SNIPER_KINDS",
                "is_indoor", "INDOOR_LEVELS" },
    xgraft = { "get_blocked_planners", "is_takeover_current" },
}
local xlibs_ok = nil
local function check_xlibs()
    if xlibs_ok ~= nil then return xlibs_ok end
    local missing = {}
    for mod, names in pairs(XLIBS_API) do
        local lib = nil
        pcall(function() lib = _G[mod] end)
        for _, n in ipairs(names) do
            if type(lib) ~= "table" or lib[n] == nil then missing[#missing + 1] = mod .. "." .. n end
        end
    end
    xlibs_ok = #missing == 0
    if not xlibs_ok then
        table.sort(missing)
        printf("!Nemesis ERROR: xlibs 1.9.1 or newer is required (missing: %s). The mod is off.", table.concat(missing, ", "))
    end
    return xlibs_ok
end

local function never_ignore_player(obj)
    pcall(function() save_var(obj, "xr_combat_ignore_enabled", false) end)
end

---------------------------------------------------------------------------
-- Leaving the hunt
---------------------------------------------------------------------------

local function release_id(id)
    local obj = level.object_by_id(id)
    if obj then pcall(function() obj:invulnerable(false) end) end
    local cover = nemesis_utils.get_retreat_dest(id)
    if cover then pcall(xcombat.release_cover, cover, id) end
    nemesis_utils.reset_chase(id)
    nemesis_chase.forget(id)
    nemesis_fx.forget_neutral(id)
end

local function teleport_away(obj, id)
    nemesis_fx.play_retreat_fx(obj:position())
    pcall(function() obj:set_relation(game_object.neutral, db.actor) end)
    nemesis_fx.make_invisible(obj)
    nemesis_fx.queue_vanish(id, nemesis_fx.RETREAT_VANISH_MS)
end

local function release_extras()
    local offline, ids = {}, {}
    for i, id in ipairs(S.squad_ids) do ids[i] = id end
    for _, id in ipairs(ids) do
        local obj = level.object_by_id(id)
        local r = S.m[id]
        if obj and nemesis_fx.alive_obj(obj) then
            teleport_away(obj, id)
        elseif obj and r and not r.death and r.inited and not r.hit_by_player then

            nemesis_fx.play_retreat_fx(obj:position())
            nemesis_fx.queue_vanish(id, nemesis_fx.DEAD_BODY_DELAY_MS)
        elseif not obj then
            offline[#offline + 1] = id
        end
        release_id(id)
        nemesis_state.drop_member(id)
    end
    S.squad_ids = {}
    nemesis_fx.remove_offline(offline)
end

local function release_sim_squad()
    local id = S.sim_squad_id
    if id then
        local squad = alife():object(id)
        if squad then pcall(xsquad.release_squad, squad) end
        if ap_api and ap_api.release_squad then
            pcall(function() ap_api.release_squad(id) end)
        end
        S.sim_squad_id = nil
        nemesis_fx.queue_squad_cleanup(id)
    end
end

local function release_npc()
    nemesis_fx.reveal_all()
    local offline = {}
    for _, id in ipairs(S.hunter_ids) do
        local obj = level.object_by_id(id)
        if not obj then
            offline[#offline + 1] = id
        elseif nemesis_fx.alive_obj(obj) then
            local r = S.m[id]

            if r and r.teleport_at then
                nemesis_fx.queue_vanish(id, nemesis_fx.RETREAT_VANISH_MS)
            else
                teleport_away(obj, id)
            end
        end
        release_id(id)
    end
    nemesis_boss.clear()
    S.hunter_ids = {}
    S.offline_since = nil
    S.pending_squad = nil
    release_extras()
    release_sim_squad()
    nemesis_damage.unseed_br()
    nemesis_state.clear_members()

    nemesis_fx.remove_offline(offline)
end

local function end_hunt(reason, escaped)

    local next_cycle = S.cycle + 1
    if escaped then next_cycle = math.max(1, S.cycle - 1)
    elseif S.boss_hunt then next_cycle = math.max(1, math.floor(S.cycle / 2)) end
    dbg("Nemesis: hunt ended (%s). Cycle %s -> %s", reason, S.cycle, next_cycle)
    S.phase = "idle"
    release_npc()
    nemesis_utils.reset_chase()
    S.retreat_announced = false
    S.seen_online = nil
    S.hunt_start = nil
    local now = nemesis_utils.game_seconds()
    if next_cycle ~= S.cycle then nemesis_damage.unseed_br() end
    S.cycle = next_cycle
    S.last_retreat = now
end

---------------------------------------------------------------------------
-- Retreat
---------------------------------------------------------------------------

local function teleport_out(obj, r)
    local id = r.id
    local cover = nemesis_utils.get_retreat_dest(id)
    if cover then pcall(xcombat.release_cover, cover, id) end
    nemesis_utils.set_retreat_dest(id, nil)
    nemesis_chase.set_wanted(id, false)
    pcall(function() obj:set_movement_type(move.stand) end)
    nemesis_fx.play_retreat_fx(obj:position())
    nemesis_fx.make_invisible(obj)
    r.cloak_vis = nil
    r.teleport_at = time_global()
end

local function begin_retreat(obj, r)
    if S.phase ~= "hunting" or r.retreat_at then return end
    local id = r.id
    r.pending = false
    r.retreat_at = time_global()
    nemesis_chase.set_wanted(id, false)

    if r.hit_by_player then
        pcall(function() nemesis_state.remember_spot(level.name(), db.actor:position(), nemesis_utils.game_seconds()) end)
    end
    dbg("Nemesis: %s is wounded and breaks off the fight.", r.name or "A hunter")
    pcall(function() obj:invulnerable(true) end)

    nemesis_utils.set_health(obj, 1)

    pcall(function() obj:set_relation(game_object.neutral, db.actor) end)

    local dest, how = nil, nil
    if nemesis_mcm.get_bool("retreat_to_cover", true) then
        local pos, apos = obj:position(), db.actor:position()
        local dx, dz = pos.x - apos.x, pos.z - apos.z
        local len = math.sqrt(dx * dx + dz * dz)
        if len < 0.1 then dx, dz, len = 1, 0, 1 end
        local away = vector():set(dx / len, 0, dz / len)

        local my_d = pos:distance_to(apos)
        local function far_enough(vid)
            local ok, yes = pcall(function()
                local vp = level.vertex_position(vid)
                return pos:distance_to(vp) >= RETREAT_MIN_RUN_M and vp:distance_to(apos) > my_d
            end)
            return ok and yes == true
        end
        pcall(function()
            local search = vector():set(pos.x + away.x * RETREAT_COVER_AHEAD_M, pos.y, pos.z + away.z * RETREAT_COVER_AHEAD_M)
            dest = xcombat.find_cover(obj, apos, { selection = xcombat.COVER.NEAREST,
                firing = false, radius = RETREAT_COVER_RADIUS_M, search_pos = search })
        end)
        if dest and not far_enough(dest) then dest = nil end
        if dest and not xcombat.register_cover(dest, id) then dest = nil end
        if dest then how = "cover" end
        if not dest then
            pcall(function() dest = xcombat.find_flee_lane(obj, away, RETREAT_FLEE_M, 20, 90) end)
            if dest and not (far_enough(dest) and xcombat.register_cover(dest, id)) then dest = nil end
            if dest then how = "away from you" end
        end
    end
    if dest then
        r.cover_until = time_global() + RETREAT_COVER_MS
        nemesis_utils.set_retreat_dest(id, dest)
        nemesis_chase.set_wanted(id, true)
        nemesis_chase.install(obj)
        dbg("Nemesis: %s runs %s before teleporting.", r.name or "A hunter", how == "cover" and "for cover" or "away from you")
    else
        dbg("Nemesis: %s has nowhere to run and teleports on the spot.", r.name or "A hunter")
        teleport_out(obj, r)
    end
    if not S.retreat_announced then
        S.retreat_announced = true
        nemesis_utils.send_news(nemesis_utils.retreat_line(), r.name)
    end
end

---------------------------------------------------------------------------
-- Deaths
---------------------------------------------------------------------------

local function process_deaths()
    local last_gone = false
    for id in pairs(S.dying) do
        S.dying[id] = nil
        local r = S.m[id]
        if r and r.death then
            if r.death.teleport then
                local corpse = level.object_by_id(id)
                if corpse then nemesis_fx.play_retreat_fx(corpse:position()) end
                release_id(id)
                nemesis_state.drop_member(id)
                nemesis_fx.queue_vanish(id, nemesis_fx.DEAD_BODY_DELAY_MS)
                if S.phase == "hunting" and #S.hunter_ids == 0 then last_gone = true end
            else
                r.cloak_vis = nil
            end
        end
    end

    if last_gone then end_hunt(S.retreat_announced and "retreat" or "killed") end
end

local function decide_death(id, r, killer, by_player, source)
    if r.death then return end
    r.dead = true
    local self_kill = (killer == id)
    local cloaked = r.cloak_vis ~= nil or r.mask_vis ~= nil

    local escapes = r.named and id ~= S.boss_id
    local stays = self_kill or (by_player and not cloaked and not escapes)
    r.death = { teleport = not stays }
    S.dying[id] = true
    local how
    if self_kill then how = "self-kill, engine removed it, no teleport"
    elseif escapes and not cloaked then how = "a named hunter never leaves a body, teleports"
    elseif r.cloak_vis then how = "cloaked, teleports"
    elseif cloaked then how = "made invisible before the hit, teleports"
    elseif by_player then how = "player, body stays"
    else how = "NPC, teleports" end
    dbg("Nemesis: '%s' died, killer %s (%s%s).", r.name or "?", tostring(killer), how, source or "")
    if stays and by_player and not self_kill then nemesis_fx.reserve_body(id) end
    if id == S.boss_id then nemesis_boss.on_killed(id, by_player, r.name) end
end

local function on_death(victim, who)
    local id = victim and victim:id()
    local r = nemesis_state.member(id)
    if not r then return end
    local killer = 0
    pcall(function() killer = who and who:id() or 0 end)
    local by_player = false
    pcall(function() by_player = (db.actor ~= nil and who ~= nil and who:id() == db.actor:id()) end)
    decide_death(id, r, killer, by_player)
end

local function decide_dead(id, r)
    decide_death(id, r, r.hit_from or 0, r.hit_by_player == true, ", seen by the tick")
end

---------------------------------------------------------------------------
-- Time limit
---------------------------------------------------------------------------

local function hunt_time_up()
    local leader = nemesis_state.name_of(nemesis_state.leader())
    local boss = S.boss_id
    local boss_obj = boss and level.object_by_id(boss)
    local boss_alive = boss_obj ~= nil and nemesis_fx.alive_obj(boss_obj)
    local boss_name = boss and nemesis_state.name_of(boss)
    local boss_pic = boss_alive and nemesis_boss.icon(boss) or nil
    if boss_alive then
        nemesis_utils.send_news(nemesis_utils.boss_escape_line(), boss_name, boss_pic)
    else
        nemesis_utils.send_news(nemesis_utils.time_up_line(), leader)
    end
    end_hunt("time limit, you escaped", true)
end

local function time_limit_reached()
    local hours = nemesis_mcm.get_number("hunt_duration", 6)
    if hours < 4 then hours = 4 end
    if hours > 12 then hours = 12 end
    local now = nemesis_utils.game_seconds()
    S.hunt_start = S.hunt_start or now
    if now < S.hunt_start then S.hunt_start = now end
    return now - S.hunt_start >= hours * 3600
end

---------------------------------------------------------------------------
-- Per tick: one named hunter
---------------------------------------------------------------------------

local function manage_hunter(id, r, gt, actor, retreat_health)

    if r.retreat_at and not r.teleport_at then
        local runner = level.object_by_id(id)
        if not runner then
            r.teleport_at = gt
        elseif nemesis_utils.retreat_arrived(runner) or gt >= (r.cover_until or 0) then
            teleport_out(runner, r)
        else
            nemesis_chase.set_wanted(id, true)
        end
        return true, true
    end

    if r.retreat_at then
        local gone = level.object_by_id(id)
        if gt - r.teleport_at < nemesis_fx.RETREAT_VANISH_MS then
            if gone then pcall(function() gone:set_movement_type(move.stand) end) end
            return true, true
        end

        if gone and not nemesis_fx.invisible_model_exists() then nemesis_fx.play_retreat_fx(gone:position()) end
        release_id(id)
        nemesis_state.drop_member(id)
        nemesis_fx.queue_vanish(id, 0)
        return false, false
    end

    local obj = level.object_by_id(id)
    if not alife():object(id) then
        dbg("Nemesis: hunter %s has no server object, dropping.", tostring(id))
        release_id(id)
        nemesis_state.drop_member(id)
        return false, false
    end
    if not obj then return true, false end
    if not nemesis_fx.alive_obj(obj) then

        if not r.death and (r.dead or r.inited) then
            decide_dead(id, r)
            return true, true
        end
        if r.death and r.death.teleport then return true, true end
        if r.death or r.dead or r.inited then
            dbg("Nemesis: hunter %s is dead, body stays, dropping from the hunt.", tostring(id))
            release_id(id)
            nemesis_state.drop_member(id)
            return false, false
        end
        return true, true
    end
    nemesis_fx.unmask(obj, r)

    if not r.inited then
        r.inited = true
        S.seen_online = true
        r.grace_until = gt + RETREAT_GRACE_MS
        local hp0 = tonumber(obj.health)

        if hp0 and hp0 > 0.05 and hp0 <= 1 then
            r.last_hp = hp0
            r.hp_armed = true
        end

        if r.follow_hp and r.follow_hp > 0.05 and r.follow_hp < 1 then
            nemesis_utils.set_health(obj, r.follow_hp)
            r.last_hp = r.follow_hp
        end
        r.follow_hp = nil
        dbg("Nemesis: '%s' is online (health %s). No retreat for %ss.", r.name or "A hunter",
            (hp0 and string.format("%.2f", hp0)) or "unread", tostring(RETREAT_GRACE_MS / 1000))

        never_ignore_player(obj)
    end

    if not r.hp_armed then
        local hpa = tonumber(obj.health)
        if hpa and hpa > 0.05 and hpa <= 1 then
            r.last_hp = hpa
            r.hp_armed = true
            dbg("Nemesis: '%s' health armed late (%.2f).", r.name or "A hunter", hpa)
        end
    end

    local hp = tonumber(obj.health)
    if not hp or hp <= 0 or hp > 1 then hp = r.last_hp or 1 end
    local prev = r.last_hp

    hp = nemesis_damage.absorb(obj, r, prev, hp)
    local in_grace = r.grace_until and gt < r.grace_until
    local hurt = r.hp_armed and prev and hp < (prev - 0.02)
    if in_grace then r.pending = false end
    if hp > 0.05 then r.last_hp = hp end

    if id ~= S.boss_id and not in_grace and (r.pending or (hurt and hp <= retreat_health)) then
        begin_retreat(obj, r)
        return true, true
    end
    if id == S.boss_id then nemesis_boss.update(obj, r, gt, actor) end
    nemesis_fx.cloak_update(obj, r, gt, actor)

    nemesis_chase.set_wanted(id, true)
    if not nemesis_chase.install(obj) and not chase_install_warned then
        chase_install_warned = true
        dbg("!Nemesis ERROR: could not add the chase action to the hunter.")
    end
    if r.grace_until and gt > r.grace_until + 3000 and not nemesis_chase.has_run(id) and not r.idle_warned then
        r.idle_warned = true
        dbg("!Nemesis ERROR: chase action has not run for '%s'.", r.name or "?")
    end
    return true, true
end

local function manage_extra(id, r, actor)
    local extra = level.object_by_id(id)
    if extra and not r.death and not nemesis_fx.alive_obj(extra) and r.inited then
        decide_dead(id, r)
        return
    end
    if not (extra and nemesis_fx.alive_obj(extra)) then return end
    nemesis_fx.unmask(extra, r)
    if not r.inited then
        r.inited = true
        never_ignore_player(extra)
        if r.follow_hp and r.follow_hp > 0.05 and r.follow_hp < 1 then nemesis_utils.set_health(extra, r.follow_hp) end
        r.follow_hp = nil
    end
    if not r.role_set then

        S.role_side = -(S.role_side or 1)
        nemesis_utils.set_role(id, { extra = true, side = S.role_side, angle = math.random(30, 60) })
        r.role_set = true
    end
    nemesis_chase.set_wanted(id, true)
    nemesis_chase.install(extra)
end

local function player_left_level()
    for _, id in ipairs(S.hunter_ids) do
        local anchor = alife():object(id)
        local r = S.m[id]
        if anchor and not (r and r.retreat_at) then
            return nemesis_utils.same_level(anchor, alife():actor()) == false
        end
    end
    return false
end

local function call_off(gt, why, retry_ms)
    dbg("Nemesis: %s", why)
    release_npc()
    S.phase = "idle"
    nemesis_spawn.block(gt + retry_ms)
end

---------------------------------------------------------------------------
-- Prepare for uninstall (MCM, Debug)
---------------------------------------------------------------------------

local UNINSTALL_SECTIONS = { nemesis_hunter_squad = true, nemesis_hunter_squad_isg = true }
local UNINSTALL_SWEEP_MS = 3000
local MAX_SE_ID = 65534
local uninstall = nil

local function our_squads_in_world()
    local found = {}
    local sim = alife()
    if not sim then return found end
    for id = 1, MAX_SE_ID do
        local se = sim:object(id)
        if se then
            local ok, sec = pcall(function() return se:section_name() end)
            if ok and UNINSTALL_SECTIONS[sec] then found[id] = true end
        end
    end
    return found
end

local function uninstall_tick(gt)
    if not nemesis_mcm.get_bool("prepare_uninstall", false) then
        if uninstall then
            uninstall = nil
            dbg("Nemesis: uninstall preparation off, hunts can start again.")
        end
        return false
    end
    if not uninstall then
        if S.phase ~= "idle" then call_off(gt, "preparing for uninstall: the hunt is called off.", 0) end
        if S.follow then
            S.follow = nil
            dbg("Nemesis: preparing for uninstall: the squad following you is called off.")
        end
        nemesis_spawn.reset_runtime()
        nemesis_guard.forget_death_marker()
        uninstall = { squads = our_squads_in_world(), at = gt + UNINSTALL_SWEEP_MS, said = false }
        local n = 0
        for _ in pairs(uninstall.squads) do n = n + 1 end
        dbg("Nemesis: preparing for uninstall, %s Nemesis squad(s) in the world.", tostring(n))
    end
    if gt < uninstall.at then return true end
    local left = 0
    for id in pairs(uninstall.squads) do
        local sq = alife():object(id)
        local ours = false
        pcall(function() ours = UNINSTALL_SECTIONS[sq:section_name()] == true end)
        if not (sq and ours) then
            uninstall.squads[id] = nil
        else
            nemesis_fx.remove_object(sq)
            left = left + 1
        end
    end
    if left > 0 then
        uninstall.at = gt + 1000
    elseif not uninstall.said then
        uninstall.said = true
        dbg("Nemesis: uninstall preparation done, no Nemesis squad left.")
        nemesis_utils.send_news("No hunt is left in the world. Save now, then you can remove Nemesis and load that save.", "Nemesis")
    end
    return true
end

local function read_surroundings(gt, actor)
    local pos = nil
    pcall(function() pos = actor:position() end)
    if not pos then return end
    local inside = false
    pcall(function() inside = xcombat.is_indoor(pos) == true end)
    local was = nemesis_utils.player_indoor()
    nemesis_utils.set_player_indoor(inside, gt)
    if inside ~= was then
        dbg("Nemesis: player is %s.", inside and "indoors, the hunters wait outside" or "outdoors again")
    end
    local lname = nil
    pcall(function() lname = level.name() end)
    local known = lname ~= nil and nemesis_state.known_spot(lname, pos, nemesis_utils.game_seconds())
    nemesis_utils.set_known_spot(known)
    if known and not S.spot_said then
        S.spot_said = true
        dbg("Nemesis: player is at a remembered spot.")
        for _, id in ipairs(S.hunter_ids) do
            local r = S.m[id]
            if r and r.named and id ~= S.boss_id and not r.retreat_at then
                nemesis_utils.send_news(nemesis_utils.known_spot_line(), r.name)
                break
            end
        end
    end
end

---------------------------------------------------------------------------
-- They follow you to another map (user design)
---------------------------------------------------------------------------

local FOLLOW_MAX = 2
local FOLLOW_CLEAR_M = 40
local FOLLOW_MIN_S, FOLLOW_MAX_S = 60, 120

local function here(actor)
    local lname, pos = nil, nil
    pcall(function() lname = level.name() end)
    pcall(function() pos = actor:position() end)
    return lname, pos
end

local function escape_follow(why, caption)
    nemesis_utils.send_news(nemesis_utils.time_up_line(), caption or "A hunter")
    S.follow = nil
    end_hunt(why, true)
end

local function begin_follow(gt, actor)
    local leader = nemesis_state.name_of(nemesis_state.leader())
    if (S.follows or 0) >= FOLLOW_MAX then
        escape_follow("you changed maps again; they lost your trail, you escaped", leader)
        return
    end
    local members = {}
    local function add(id, named)
        local r = S.m[id]
        if not r or r.retreat_at or r.dead or r.death then return end
        local e = { name = r.name or "?", named = named, boss = (id == S.boss_id), hp = r.last_hp or 1 }
        if e.boss then table.insert(members, 1, e) else members[#members + 1] = e end
    end
    for _, id in ipairs(S.hunter_ids) do add(id, true) end
    for _, id in ipairs(S.squad_ids) do add(id, false) end
    if #members == 0 or not members[1].named then
        end_hunt("every hunter was breaking off when you left the map")
        return
    end
    local lname, pos = here(actor)
    local f = { members = members, faction = S.faction, boss_look = S.boss_look, boss_hunt = S.boss_hunt,
                hunt_start = S.hunt_start, lvl = lname, ax = pos and pos.x or 0, az = pos and pos.z or 0 }
    dbg("Nemesis: player changed maps; %s hunter(s) follow (%s of %s).", tostring(#members),
        tostring((S.follows or 0) + 1), tostring(FOLLOW_MAX))
    release_npc()
    nemesis_utils.reset_chase()
    S.phase = "idle"
    S.retreat_announced = false
    S.seen_online = nil
    S.follow = f
    S.follows = (S.follows or 0) + 1
end

local function follow_tick(gt, actor, slow)
    local f = S.follow
    if not slow or not f then return end
    local caption = f.members[1] and f.members[1].name
    if time_limit_reached() then
        escape_follow("time limit while they followed you, you escaped", caption)
        return
    end
    local lname, pos = here(actor)
    if not pos then return end
    if lname and f.lvl and lname ~= f.lvl then

        if (S.follows or 0) >= FOLLOW_MAX then
            escape_follow("you changed maps again; they lost your trail, you escaped", caption)
            return
        end
        S.follows = (S.follows or 0) + 1
        f.lvl, f.ax, f.az, f.spawn_at = lname, pos.x, pos.z, nil
        dbg("Nemesis: player changed maps again; they follow (%s of %s).", tostring(S.follows), tostring(FOLLOW_MAX))
        return
    end
    if not f.spawn_at then
        local dx, dz = pos.x - f.ax, pos.z - f.az
        if dx * dx + dz * dz < FOLLOW_CLEAR_M * FOLLOW_CLEAR_M then return end
        f.spawn_at = gt + math.random(FOLLOW_MIN_S, FOLLOW_MAX_S) * 1000
        dbg("Nemesis: player left the arrival area; the hunters arrive in %.0f s.", (f.spawn_at - gt) / 1000)
        return
    end
    if gt < f.spawn_at or nemesis_spawn.follow_blocked(actor) then return end
    nemesis_spawn.spawn_follow(gt, f)
    if S.phase ~= "idle" then S.follow = nil end
end

local function manage(gt, actor, slow)
    if #S.hunter_ids == 0 then
        call_off(gt, "hunter object no longer exists; resetting.", 10000)
        return
    end
    process_deaths()
    if S.phase == "idle" then return end

    if slow and time_limit_reached() then
        hunt_time_up()
        return
    end
    if slow and player_left_level() then
        begin_follow(gt, actor)
        return
    end
    if slow then
        nemesis_spawn.apply_names()

        nemesis_spawn.hold_guard_exemption()
        read_surroundings(gt, actor)
    end

    local any_online = false
    local retreat_health = nemesis_utils.get_retreat_health(S.cycle)
    local ids = {}
    for _, id in ipairs(S.hunter_ids) do ids[#ids + 1] = id end
    for _, id in ipairs(ids) do
        local r = S.m[id]
        if r then
            local _, online = manage_hunter(id, r, gt, actor, retreat_health)
            if online then any_online = true end
        end
    end

    if #S.hunter_ids == 0 then
        end_hunt(S.retreat_announced and "retreat" or "killed")
        return
    end

    if not any_online then
        S.offline_since = S.offline_since or gt
        if gt - S.offline_since > OFFLINE_LIMIT_MS then
            call_off(gt, "hunters stayed offline too long, respawning.", 3000)
            return
        end
    else
        S.offline_since = nil
    end

    for _, id in ipairs(S.squad_ids) do
        local r = S.m[id]
        if r then manage_extra(id, r, actor) end
    end

    if slow or nemesis_spawn.has_unbound_member() then nemesis_spawn.keep_squad_friendly() end
    nemesis_fx.hum_update(actor)
    nemesis_fx.distort_update(actor)
end

---------------------------------------------------------------------------
-- Tick and callbacks
---------------------------------------------------------------------------
local function tick()
    if not check_xlibs() then return end
    nemesis_guard.tick()
    local actor = db.actor
    if not actor or not actor:alive() or not alife() then return end
    if S.first_hunt == nil then S.first_hunt = nemesis_utils.game_seconds() end

    local gt = time_global()
    local slow = false
    if gt >= next_slow then
        slow = true
        next_slow = gt + SLOW_MS
    end
    nemesis_boss.debug_mark_tick(gt)
    if slow then
        nemesis_boss.stash_tick()
        nemesis_fx.reserve_tick(gt, actor)
    end
    if uninstall_tick(gt) then return end
    if S.phase == "idle" then
        nemesis_fx.hum_stop()
        nemesis_fx.distort_stop()
        if S.follow then follow_tick(gt, actor, slow)
        else nemesis_spawn.idle_tick(gt, actor, slow) end
    else
        nemesis_spawn.fill_squad()
        manage(gt, actor, slow)
    end
end

local function on_update()
    local gt = time_global()

    if S.phase ~= "idle" and next(S.dying) ~= nil then process_deaths() end
    nemesis_fx.process_queues(gt)
    if gt < next_tick then return end
    next_tick = gt + ((S.phase == "idle") and TICK_IDLE_MS or TICK_HUNT_MS)
    tick()
end

local function on_se_unregister(se_obj, type_name)
    local id = se_obj and se_obj.id
    if not id or S.phase == "idle" or not nemesis_utils.debug_on() or not nemesis_state.is_member(id) then return end
    local tb = ""
    pcall(function() tb = debug.traceback("", 2) end)
    dbg("!Nemesis DIAG: hunt member %s unregistered (%s).%s", tostring(id), tostring(type_name), tb or "")
end

local function on_net_destroy()
    loaded_flag = false
end

local function on_npc_net_destroy(npc)
    local id = nil
    pcall(function() id = npc:id() end)
    if not id or S.phase == "idle" or not nemesis_state.is_member(id) then return end
    nemesis_chase.offline(id)
    nemesis_utils.reset_chase(id)
    dbg("Nemesis: %s went offline; the chase is added again when he is back.", nemesis_state.name_of(id) or tostring(id))
end

local function on_first_update()
    if not loaded_flag then

        nemesis_state.reset()
        load_vanish = {}
    end
    nemesis_fx.reset_runtime()
    nemesis_spawn.reset_runtime()
    nemesis_boss.reset_runtime()
    uninstall = nil
    for _, id in ipairs(load_vanish) do nemesis_fx.queue_vanish(id, 2000) end
    load_vanish = {}
    nemesis_guard.apply_death_reset()
    nemesis_mcm.invalidate()
    nemesis_mcm.sync_difficulty()
    nemesis_chase.reset_all()
    loaded_flag = false
    next_tick = 0
    next_slow = 0
    nemesis_damage.unseed_br()
end

local function save_state(mdata)
    nemesis_state.save(mdata, nemesis_fx.vanish_ids())
end

local function load_state(mdata)
    nemesis_chase.reset_all()
    loaded_flag = true
    load_vanish = nemesis_state.load(mdata)
end

function on_game_start()
    nemesis_mcm.on_game_start()
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
    RegisterScriptCallback("actor_on_first_update", on_first_update)
    RegisterScriptCallback("actor_on_update", on_update)
    RegisterScriptCallback("actor_on_net_destroy", on_net_destroy)
    RegisterScriptCallback("npc_on_net_destroy", on_npc_net_destroy)
    RegisterScriptCallback("npc_on_before_hit", nemesis_damage.on_before_hit)
    RegisterScriptCallback("npc_on_hit_callback", nemesis_damage.on_hunter_hit)
    RegisterScriptCallback("npc_shot_dispersion", nemesis_damage.on_shot_dispersion)
    RegisterScriptCallback("actor_on_before_hit", nemesis_damage.on_actor_before_hit)
    RegisterScriptCallback("on_enemy_eval", nemesis_fx.on_enemy_eval)
    RegisterScriptCallback("npc_on_death_callback", on_death)
    RegisterScriptCallback("actor_on_hit_callback", nemesis_guard.on_actor_hit)
    RegisterScriptCallback("actor_on_before_death", nemesis_guard.on_actor_before_death)
    RegisterScriptCallback("server_entity_on_unregister", on_se_unregister)
end
