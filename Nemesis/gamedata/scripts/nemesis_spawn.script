-- Nemesis Spawn

local S = nemesis_state.S
local NO_VERTEX = 4294967295

local function dbg(...) nemesis_utils.log_tag("SPAWN", ...) end

local SPAWN_RETRY_MS = 10000
local block_until = 0
local cooldown_logged = nil
local warned_no_squad = false

function block(gt_ms) block_until = gt_ms end
function retry_later(gt) block_until = gt + SPAWN_RETRY_MS end

---------------------------------------------------------------------------
-- When
---------------------------------------------------------------------------

local function in_grace(now)
    if nemesis_mcm.get_bool("debug_mode", false) or S.spawned_count ~= 0 or not S.first_hunt then return false end
    return now - S.first_hunt < nemesis_mcm.get_number("grace_period", 18) * 86400
end

local function spawn_allowed(gt)
    if gt < block_until then return false end
    local debug_mode = nemesis_mcm.get_bool("debug_mode", false)
    local now = nemesis_utils.game_seconds()
    if in_grace(now) then return false end
    if S.last_retreat then
        if now < S.last_retreat then
            S.last_retreat = now
        end

        local cooldown = nemesis_mcm.get_number("retreat_cooldown", 36)
        if cooldown < 0 then cooldown = 0 end
        if debug_mode then cooldown = 120 / 3600 end
        if now - S.last_retreat < cooldown * 3600 then

            local key = tostring(S.last_retreat) .. "/" .. tostring(cooldown)
            if cooldown_logged ~= key then
                cooldown_logged = key
                local left = (S.last_retreat + cooldown * 3600 - now) / 3600
                if debug_mode then
                    dbg("Nemesis: next hunt in %s game seconds (Debug mode overrides Time between hunts).", string.format("%.0f", left * 3600))
                else
                    dbg("Nemesis: next hunt in %s game hours (Time between hunts = %s h).", string.format("%.1f", left), tostring(cooldown))
                end
            end
            return false
        end
    end
    return true
end

local SAFE_RADIUS_M   = 120
local BASE_KEEP_OUT_M = 60

local NO_BASES = {}
local BASE_CACHE_MS = 60000
local base_bypass_logged = false
local base_cache, base_cache_level, base_cache_at = nil, nil, 0

function forget_bases() base_cache, base_cache_level = nil, nil end
local function base_smarts_on_level()
    if nemesis_mcm.get_bool("debug_mode", false) then
        if not base_bypass_logged then
            base_bypass_logged = true
            dbg("Nemesis: debug mode, base and trader safe zones are ignored for spawning.")
        end
        return NO_BASES
    end
    base_bypass_logged = false

    local sim_actor = alife():actor()

    local ok_l, lname = pcall(xlevel.get_level_id, sim_actor)
    if not ok_l then lname = nil end
    local now = time_global()
    if base_cache and lname ~= nil and base_cache_level == lname and now - base_cache_at < BASE_CACHE_MS then
        return base_cache
    end
    local out = {}

    local ok, by_name = pcall(xsmart.get_named_smarts)
    if not ok or type(by_name) ~= "table" then return out end
    for _, smart in pairs(by_name) do
        local base = false

        pcall(function() base = xsmart.is_base(smart) end)
        if base and smart.position and nemesis_utils.same_level(smart, sim_actor) == true then
            local name = "?"
            pcall(function() name = smart:name() end)
            local p = smart.position
            local pos = vector()
            pos:set(p.x, p.y, p.z)

            local declared = {}

            pcall(function() for f in pairs(xsmart.get_declared_factions(smart)) do declared[#declared + 1] = f end end)
            out[#out + 1] = { position = pos, name = name, id = smart.id, declared = declared }
        end
    end
    if lname ~= nil then base_cache, base_cache_level, base_cache_at = out, lname, now end
    return out
end

local function friendly_base(b)
    local me = nemesis_utils.player_community()
    if not me or not b.id then return true end

    local ok, hostile = pcall(xsmart.has_enemy_squad, b.id, me)
    if ok and hostile then return false end
    local stationed = false

    pcall(function() for _ in xsmart.iterate_stationed_squads(b.id) do stationed = true; break end end)
    if stationed or #b.declared == 0 then return true end
    for _, f in ipairs(b.declared) do

        local ok2, enemy = pcall(game_relations.is_factions_enemies, me, f)
        if not ok2 or not enemy then return true end
    end
    return false
end

local function near_base(pos, radius, bases, accept)
    for _, b in ipairs(bases) do
        if b.position:distance_to(pos) < radius and (not accept or accept(b)) then return b end
    end
    return nil
end

local blocked_logged = nil
local function spawn_blocked(actor, ignore_bases)
    local reason = nil
    local talking, sleeping = false, false

    pcall(function() talking = actor:is_talking() end)

    pcall(function() sleeping = actor:has_info("actor_is_sleeping") end)
    if talking then
        reason = "in a dialogue"
    elseif sleeping then
        reason = "sleeping"
    elseif nemesis_utils.on_underground_map() then
        reason = "on an underground map"
    elseif not ignore_bases then
        local base = near_base(actor:position(), SAFE_RADIUS_M, base_smarts_on_level(), friendly_base)
        if base then reason = "within " .. SAFE_RADIUS_M .. " m of base " .. base.name end
    end
    if reason ~= blocked_logged then
        blocked_logged = reason
        if reason then dbg("Nemesis: hunt held back, player is %s.", reason) end
    end
    return reason ~= nil
end

function extra_allowed(gt, actor)
    return gt >= block_until and not in_grace(nemesis_utils.game_seconds()) and not spawn_blocked(actor, false)
end

---------------------------------------------------------------------------
-- Arrival warning
---------------------------------------------------------------------------

local WARN_MIN_S, WARN_MAX_S = 30, 120
local WARN_DEBUG_S = 15
local WARN_STALE_MS = 600000
local warn_spawn_at = nil

local function warning_pda() return nemesis_mcm.get_bool("warning_pda", false) end
local function warning_audio() return nemesis_mcm.get_bool("warning_audio", true) end
function warning_on() return warning_pda() or warning_audio() end

local PERF_SLOW_MS = 20
local perf_seen = {}
local perf = nil
local function perf_begin(what)
    perf = nil
    if not nemesis_utils.debug_on() then return end
    local t = nemesis_engine.clock_ms()
    perf = { what = what, t0 = t, last = t, steps = {} }
end
local function perf_step(name)
    if not perf then return end
    local t = nemesis_engine.clock_ms()
    perf.steps[#perf.steps + 1] = name .. " " .. string.format("%.1f", t - perf.last)
    perf.last = t
end
local function perf_end()
    if not perf then return end
    local p = perf
    perf = nil
    local total = nemesis_engine.clock_ms() - p.t0
    local first = not perf_seen[p.what]
    perf_seen[p.what] = true
    if first or total > PERF_SLOW_MS then
        dbg("Nemesis PERF: %s%s took %s ms (%s).", first and "the first " or "", p.what, string.format("%.1f", total), table.concat(p.steps, ", "))
    end
end

local function give_warning(gt)
    perf_begin("arrival warning")
    local delay = nemesis_mcm.get_bool("debug_mode", false) and WARN_DEBUG_S or math.random(WARN_MIN_S, WARN_MAX_S)
    warn_spawn_at = gt + delay * 1000

    S.faction = nemesis_utils.faction_for_player()
    local boss = nemesis_boss.roll_for_warning()
    local pda, audio = warning_pda(), warning_audio()
    perf_step("faction and boss roll")
    if boss then
        if pda then nemesis_utils.send_news(nemesis_utils.boss_warning_line(nemesis_utils.get_npc_name()), nemesis_utils.text("st_nemesis_caption_unknown")) end
    else
        if pda then nemesis_utils.send_news(nemesis_utils.warning_line(), nemesis_utils.text("st_nemesis_caption_unknown")) end
    end
    perf_step("PDA message")

    if audio then nemesis_sound.warning(boss) end
    perf_step("sound")
    dbg("Nemesis: arrival warning given%s (PDA %s, audio %s), hunt in %s s.", boss and " (BOSS)" or "",
        pda and "on" or "off", audio and "on" or "off", tostring(delay))
    perf_end()
end

---------------------------------------------------------------------------
-- Names and relations
---------------------------------------------------------------------------

function apply_names()
    for id, r in pairs(S.m) do
        local name = r.name
        local se = name and nemesis_engine.se(id)
        if se then
            pcall(function()
                if se.set_character_name and se:character_name() ~= name then
                    nemesis_engine.set_character_name(se, name)
                end
            end)
        end
    end
end

local SQUAD_PASS_MS = 10000
local squad_pass_at = -1000000
local function _set_rel(a, rel, b) a:set_relation(rel, b) end
function keep_squad_friendly()
    local objs = {}
    local fresh = false
    local function consider(id)
        local obj = nemesis_engine.obj(id)
        if not obj or not nemesis_fx.alive_obj(obj) then return end
        local r = S.m[id]
        if not r.bound then fresh = true end
        r.bound = true
        objs[#objs + 1] = obj
    end
    for _, id in ipairs(S.hunter_ids) do consider(id) end
    for _, id in ipairs(S.squad_ids) do consider(id) end
    local now = time_global()
    if fresh or now - squad_pass_at >= SQUAD_PASS_MS then
        squad_pass_at = now
        local friend = game_object.friend
        for i = 1, #objs do
            for j = 1, #objs do
                if i ~= j then pcall(_set_rel, objs[i], friend, objs[j]) end
            end
        end
    end
    local actor = db.actor
    if not actor then return end
    local enemy = game_object.enemy
    for _, obj in ipairs(objs) do
        local r = S.m[obj:id()]
        if r and not r.retreat_at then
            pcall(_set_rel, obj, enemy, actor)
            pcall(_set_rel, actor, enemy, obj)
        end
    end
end

function has_unbound_member()
    for id, r in pairs(S.m) do
        if not r.bound then
            local o = nemesis_engine.obj(id)
            if o and nemesis_fx.alive_obj(o) then return true end
        end
    end
    return false
end

---------------------------------------------------------------------------
-- The squad
---------------------------------------------------------------------------
function member_ids(squad)
    local ids = {}
    if not squad then return ids end
    pcall(function()

        for mid in xsquad.iterate_member_ids(squad) do
            if type(mid) == "number" then ids[#ids + 1] = mid end
        end
    end)
    return ids
end

local SQUAD_WEIGHTS = { 50, 25, 14, 10, 6 }

local AREA_SQUAD_CAP = { [0] = 2, [1] = 3 }
local AREA_NAMED_BONUS = { [4] = 10, [5] = 20 }
function area_tier()
    if not nemesis_mcm.get_bool("area_scaling", true) then return nil end
    local tier = nil

    pcall(function() tier = xlevel.get_danger_tier(nemesis_engine.level_name()) end)
    if type(tier) ~= "number" then tier = xlevel.DANGER_TIER_DEFAULT or 2 end
    return tier
end

local function roll_squad_size()
    local total = 0
    local weights = {}
    for i = 1, 5 do
        local w = nemesis_mcm.get_number("squad_w" .. i, SQUAD_WEIGHTS[i])
        if w < 0 then w = 0 end
        weights[i] = w
        total = total + w
    end
    if total <= 0 then return 1 end
    local roll = math.random() * total
    local acc = 0
    for i = 1, 5 do
        acc = acc + weights[i]
        if roll <= acc then return i end
    end
    return 1
end

local function boss_escort()
    local n = math.floor(nemesis_mcm.get_number("boss_escort", 4) + 0.5)
    if n < 0 then n = 0 end
    if n > 4 then n = 4 end
    return n
end

local function arrival_fx(id)
    local se = id and nemesis_engine.se(id)
    if se and se.position then nemesis_fx.play_retreat_fx(se.position) end
end

local function named_chance(tier)
    local chance = nemesis_mcm.get_number("named_chance", 15)
    if chance < 0 then chance = 0 end
    chance = chance + (tier and AREA_NAMED_BONUS[tier] or 0)
    if chance < 0 then chance = 0 end
    if chance > 100 then chance = 100 end
    return chance
end

local function vertex_pos(lv)
    local raw = nemesis_engine.vertex_pos(lv)
    if not raw then return nil end
    local pos = vector()
    pos:set(raw.x, raw.y, raw.z)
    return pos
end

local function spawn_extra(job)
    local squad = S.sim_squad_id and nemesis_engine.se(S.sim_squad_id)
    if not squad or not squad.add_squad_member then return nil end
    local origin = vertex_pos(job.origin_lv)
    if not origin then return nil end
    local before = {}
    for _, mid in ipairs(member_ids(squad)) do before[mid] = true end
    for attempt = 1, 12 do
        local ang = math.random() * 6.28318
        local dir = vector()
        dir:set(math.cos(ang), 0, math.sin(ang))
        local dist = 8 + attempt * 1.5
        local node = nemesis_engine.vertex_toward(job.origin_lv, dir, dist)
        if node and node < NO_VERTEX and node ~= job.origin_lv and not job.used[node] then
            local pos = vertex_pos(node)
            if pos and pos:distance_to(origin) >= 6 then
                local ok, res = pcall(function()
                    return nemesis_engine.add_squad_member(squad, job.section, pos, node, job.gvid)
                end)
                local new_id = nil
                for _, mid in ipairs(member_ids(squad)) do
                    if not before[mid] then new_id = mid end
                end
                if not new_id and ok then
                    if type(res) == "number" and not before[res] then new_id = res end
                    if type(res) == "userdata" and res.id and not before[res.id] then new_id = res.id end
                end
                if new_id then
                    job.used[node] = true
                    return new_id
                end
            end
        end
    end
    return nil
end

STAGGER_MS = 750

function stagger_next(prev_due, now)
    return math.max((prev_due or now) + STAGGER_MS, now + STAGGER_MS / 2)
end

function fill_squad()
    local job = S.pending_squad
    if not job or job.left <= 0 then return end
    local now = time_global()
    if job.next_at and now < job.next_at then return end
    if not job.section or job.section == "" then
        dbg("!Nemesis ERROR: no stalker section for the extra members.")
        S.pending_squad = nil
        return
    end
    local extra_id = spawn_extra(job)
    if not extra_id then
        job.misses = (job.misses or 0) + 1
        if job.misses >= 8 then
            dbg("Nemesis: stopped after %s squad members, no free vertex for the rest",
                tostring(#S.hunter_ids + #S.squad_ids))
            S.pending_squad = nil
        end
        return
    end

    local got = "?"
    pcall(function()
        local se_new = nemesis_engine.se(extra_id)

        if se_new then got = se_new:section_name() end
    end)
    if got ~= job.section then
        dbg("!Nemesis ERROR: extra member %s is section %s, expected %s.", tostring(extra_id), tostring(got), tostring(job.section))
    end
    job.misses = 0
    job.left = job.left - 1
    job.next_at = stagger_next(job.next_at, now)
    local fe = job.follow and table.remove(job.follow, 1)
    local named, ename
    if fe then
        named, ename = fe.named, fe.name
    else
        named = job.all_named or math.random(100) <= named_chance(area_tier())
        ename = nemesis_utils.next_hunter_name(job.used_names, named)
    end
    nemesis_state.add_member(extra_id, named, ename)
    if fe then
        local r = nemesis_state.member(extra_id)
        if r then r.follow_hp = fe.hp end
        arrival_fx(extra_id)
    end
    if named then
        dbg("Nemesis: named hunter '%s' joined the squad", ename)
        if job.all_named and not fe then arrival_fx(extra_id) end
    else
        dbg("Nemesis: stalker '%s' joined the squad", ename)
    end
    if job.left <= 0 then
        dbg("Nemesis: squad complete, %s stalkers", tostring(#S.hunter_ids + #S.squad_ids))
        S.pending_squad = nil
    end
end

---------------------------------------------------------------------------
-- The scripted target
---------------------------------------------------------------------------

local function arm_squad(squad)
    if not squad then return end

    pcall(xsquad.set_target_actor, squad, true)

    pcall(xsmart.assign_squad_to_smart, squad, nil)
    dbg("Nemesis: squad %s is scripted on the player and off the smart roster.", tostring(squad.id))
end

function hold_guard_exemption()
    local id = S.sim_squad_id
    if not id then return end
    local squad = nemesis_engine.se(id)
    if not squad then return end
    local needs = false
    pcall(function() needs = squad.scripted_target ~= "actor" end)
    if needs then

        pcall(xsquad.set_target_actor, squad, true)
        if not S.target_restore_logged then
            S.target_restore_logged = true
            dbg("Nemesis: restored the scripted target on squad %s.", tostring(id))
        end
    end
end

---------------------------------------------------------------------------
-- Where
---------------------------------------------------------------------------

local function spawn_range()
    local dmin = nemesis_mcm.get_number("spawn_dist_min", 80)
    local dmax = nemesis_mcm.get_number("spawn_dist_max", 140)
    if dmin > dmax then dmin, dmax = dmax, dmin end
    return dmin, dmax
end

local FOLLOW_SIDE_DEG = 45
local FOLLOW_SIDE_COS = math.cos(math.rad(FOLLOW_SIDE_DEG))

local function side_dir(apos, toward)
    if not (apos and toward) then return nil end
    local dx, dz = toward.x - apos.x, toward.z - apos.z
    local l = math.sqrt(dx * dx + dz * dz)
    if l < 5 then return nil end
    return dx / l, dz / l
end

local function on_side(apos, pos, sx, sz)
    local dx, dz = pos.x - apos.x, pos.z - apos.z
    local l = math.sqrt(dx * dx + dz * dz)
    return l > 0.1 and (dx * sx + dz * sz) / l >= FOLLOW_SIDE_COS
end

local function pick_spawn_smart(actor, toward)
    local dmin, dmax = spawn_range()
    local apos = actor:position()

    local sim_actor = alife():actor()

    local ok, by_name = pcall(xsmart.get_named_smarts)
    if not ok or type(by_name) ~= "table" then return nil end
    local bases = base_smarts_on_level()
    local ring = {}
    for _, smart in pairs(by_name) do
        if smart and smart.position and not near_base(smart.position, BASE_KEEP_OUT_M, bases)
            and sim_actor and nemesis_utils.same_level(smart, sim_actor) == true then
            local d = smart.position:distance_to(apos)
            if d >= dmin and d <= dmax then ring[#ring + 1] = smart end
        end
    end
    if #ring == 0 then return nil end
    local sx, sz = side_dir(apos, toward)
    if sx then
        local side = {}
        for _, smart in ipairs(ring) do if on_side(apos, smart.position, sx, sz) then side[#side + 1] = smart end end
        if #side > 0 then return side[math.random(#side)], true end
    end
    return ring[math.random(#ring)], false
end

local function pick_ring_vertex(actor, toward, from_lv)
    local dmin, dmax = spawn_range()
    local alv, apos
    pcall(function() alv = actor:level_vertex_id(); apos = actor:position() end)
    if not alv or alv >= NO_VERTEX or not apos then return nil end
    if from_lv and from_lv < NO_VERTEX then alv = from_lv end
    local best_lv, best_pos, best_d = nil, nil, 0
    local bases = base_smarts_on_level()

    local sx, sz = side_dir(apos, toward)
    local base_ang = sx and math.atan2(sz, sx) or nil
    for try = 1, 32 do
        local ang = math.random() * 6.28318
        if base_ang and try <= 16 then ang = base_ang + (math.random() * 2 - 1) * math.rad(FOLLOW_SIDE_DEG) end
        local dir = vector()
        dir:set(math.cos(ang), 0, math.sin(ang))
        local want = dmin + math.random() * (dmax - dmin)
        local lv = nil
        pcall(function() lv = nemesis_engine.vertex_toward(alv, dir, want) end)
        if lv and lv < NO_VERTEX and lv ~= alv then
            local pos = vertex_pos(lv)
            if pos and not near_base(pos, BASE_KEEP_OUT_M, bases) then
                local d = pos:distance_to(apos)
                if d >= dmin and d <= dmax then return lv, pos end
                if d > best_d and d >= 40 then best_lv, best_pos, best_d = lv, pos, d end
            end
        end
    end
    return best_lv, best_pos
end

local function create_squad_at(section, pos, lv, gv)
    local squad = nemesis_engine.create_squad(section, pos, lv, gv)
    if not squad then return nil end

    squad:create_npc(nil, pos, lv, gv)

    pcall(function() squad:set_squad_relation() end)
    return squad
end

---------------------------------------------------------------------------
-- How
---------------------------------------------------------------------------

local function fresh_hunt(faction, squad, follow)
    nemesis_state.clear_members()
    S.faction = faction
    S.sim_squad_id = squad.id
    S.pending_squad = nil
    S.target_restore_logged = nil
    S.retreat_announced = false
    S.offline_since = nil
    S.seen_online = nil
    S.role_side = nil
    S.fx = {}
    S.boss_id = nil
    S.boss_hunt = nil
    S.boss_sneak = nil
    S.emission_hunt = nil
    S.spot_said = nil
    if not follow then
        S.follows = 0
        S.reload_said = nil
    end
    nemesis_utils.reset_chase()
    nemesis_chase.reset_all()
    arm_squad(squad)
end

local function try_spawn(gt, follow)
    local actor = db.actor
    if not actor then return end

    if S.phase ~= "idle" or #S.hunter_ids > 0 or (S.sim_squad_id and nemesis_engine.se(S.sim_squad_id)) or (S.follow and not follow) then
        dbg("Nemesis: a hunt is already active; no second one is started.")
        retry_later(gt)
        return
    end

    perf_begin(follow and "squad arrival (follow)" or "squad spawn")
    local toward = follow and follow.ax and vector():set(follow.ax, 0, follow.az) or nil
    local spawn_smart, from_side = pick_spawn_smart(actor, toward)
    local ring_lv, ring_pos = nil, nil

    local sx, sz = side_dir(actor:position(), toward)
    if spawn_smart and sx and not from_side then
        local lv2, pos2 = pick_ring_vertex(actor, toward)
        if pos2 and on_side(actor:position(), pos2, sx, sz) then
            spawn_smart, ring_lv, ring_pos, from_side = nil, lv2, pos2, true
        end
    end
    if not spawn_smart and not ring_lv then
        ring_lv, ring_pos = pick_ring_vertex(actor, toward)
        from_side = sx ~= nil and ring_pos ~= nil and on_side(actor:position(), ring_pos, sx, sz)
        if not ring_lv then
            dbg("Nemesis: no smart and no free vertex in the spawn range, retrying later")
            retry_later(gt)
            return
        end
    end

    perf_step("spot")
    local faction = (follow and follow.faction) or nemesis_utils.faction_for_player()

    local squad_section = (follow and nemesis_events.ask("squad_section", faction, follow)) or nemesis_utils.resolve_squad_section(faction)
    if not squad_section then
        if not warned_no_squad then
            warned_no_squad = true
            dbg("!Nemesis ERROR: no squad section found, nothing was spawned.")
        end
        block_until = gt + 60000
        return
    end

    local pos, lv, gv
    if spawn_smart then
        pos, lv, gv = spawn_smart.position, spawn_smart.m_level_vertex_id, spawn_smart.m_game_vertex_id
    else
        pos, lv, gv = ring_pos, ring_lv, actor:game_vertex_id()
    end
    local ok, squad = pcall(function() return create_squad_at(squad_section, pos, lv, gv) end)
    if not ok then dbg("!!Nemesis ERROR: squad spawn failed (%s).", tostring(squad)) end
    if not ok or not squad then
        dbg("!!Nemesis ERROR: squad creation failed for %s.", squad_section)
        retry_later(gt)
        return
    end

    perf_step("squad and leader")
    fresh_hunt(faction, squad, follow)

    local members = member_ids(squad)
    if #members == 0 then
        dbg("!Nemesis ERROR: squad %s has no stalkers.", tostring(squad.id))
        nemesis_engine.release_squad(squad)
        S.sim_squad_id = nil
        nemesis_fx.queue_squad_cleanup(squad.id)
        S.phase = "idle"
        retry_later(gt)
        return
    end

    local tier = area_tier()
    local chance = named_chance(tier)
    local used_names = {}
    local follow_rest = nil
    if follow then

        follow_rest = {}
        for i, e in ipairs(follow.members) do if i > 1 then follow_rest[#follow_rest + 1] = e end end
        for _, e in ipairs(follow.members) do used_names[e.name] = true end
        for i, mid in ipairs(members) do
            local e = (i == 1) and follow.members[1] or table.remove(follow_rest, 1)
            if e then
                nemesis_state.add_member(mid, e.named, e.name)
                local r = nemesis_state.member(mid)
                if r then r.follow_hp = e.hp end

                if e.boss and nemesis_events.ask("follow_boss", mid, follow) then

                elseif e.boss then
                    nemesis_boss.make(mid)
                    S.boss_look = follow.boss_look or S.boss_look
                end
            end
        end
        S.boss_hunt = follow.boss_hunt or S.boss_hunt
        for _, mid in ipairs(members) do arrival_fx(mid) end
        S.hunt_start = follow.hunt_start or nemesis_utils.game_seconds()
    else

        local leader_boss = nemesis_boss.take_leader_roll(warning_on())
        for i, mid in ipairs(members) do
            local named = (i == 1) or (math.random(100) <= chance)
            nemesis_state.add_member(mid, named, nemesis_utils.next_hunter_name(used_names, named))
            if i == 1 and leader_boss then nemesis_boss.make(mid) end
        end
        nemesis_boss.count_hunt(S.boss_id ~= nil)
        if S.boss_id then for _, mid in ipairs(members) do arrival_fx(mid) end end
        S.spawned_count = S.spawned_count + 1
        S.hunt_start = nemesis_utils.game_seconds()
    end
    perf_step("member records")
    S.phase = "hunting"

    if not follow then nemesis_events.emit("hunt_started", S.faction, S.boss_hunt and true or false, false) end
    perf_step("hunt_started")

    local wanted = roll_squad_size()
    local cap = tier and AREA_SQUAD_CAP[tier]
    if cap and wanted > cap then wanted = cap end
    local all_named = false
    if follow then
        wanted = #members + #follow_rest
    elseif S.boss_id then

        wanted = #members + boss_escort()
        all_named = true
    end
    if #members < wanted then
        local section = nemesis_utils.pick_member_section(faction)
        if not section then
            dbg("!Nemesis ERROR: no generic section for the extra stalkers.")
        else
            local origin, gvid = 0, 0
            pcall(function()
                origin = squad.m_level_vertex_id or (spawn_smart and spawn_smart.m_level_vertex_id) or ring_lv or 0
                gvid = squad.m_game_vertex_id or (spawn_smart and spawn_smart.m_game_vertex_id) or 0
            end)
            local used = {}
            if origin ~= 0 then used[origin] = true end
            S.pending_squad = {
                section = section,
                origin_lv = origin,
                gvid = gvid,
                left = wanted - #members,
                used = used,
                used_names = used_names,
                misses = 0,
                all_named = all_named,
                follow = follow_rest,
                next_at = time_global() + STAGGER_MS,
            }
        end
    end

    perf_step("extras planned")
    local leader = nemesis_state.name_of(nemesis_state.leader()) or nemesis_utils.text("st_nemesis_caption_hunter")
    local sname = "navmesh vertex " .. tostring(ring_lv)
    if spawn_smart then pcall(function() sname = spawn_smart:name() end) end
    nemesis_fx.wd_malfunction(S.boss_id ~= nil)
    perf_step("Wearable Devices")
    if follow and S.boss_id then
        nemesis_boss.news(nemesis_utils.follow_line())
    elseif follow then
        nemesis_utils.send_news(nemesis_utils.follow_line(), leader)
    elseif S.boss_id then
        nemesis_boss.news(nemesis_utils.boss_line())
    else
        nemesis_utils.send_news(nemesis_utils.taunt(S.cycle), leader)
    end
    perf_step("PDA message")
    local dist = (spawn_smart and spawn_smart.position or ring_pos):distance_to(actor:position())
    dbg("Nemesis: '%s' squad spawned (%s) at %s, %s m away, %s stalkers, want %s [cycle %s, scripted, off the smart roster]",
        leader, squad_section, tostring(sname), string.format("%.0f", dist), tostring(#members),
        tostring(wanted), tostring(S.cycle))
    if toward then
        dbg("Nemesis: they followed you in %s.", from_side and "from the side you came in on"
            or "from another side (no spot in range on yours)")
    end
    perf_end()
end

function idle_tick(gt, actor, slow)
    if S.follow then return end
    local warn_on = warning_on()

    if warn_spawn_at and gt - warn_spawn_at > WARN_STALE_MS then warn_spawn_at = nil end
    local committed = warn_on and warn_spawn_at ~= nil
    if not (slow and spawn_allowed(gt) and not spawn_blocked(actor, committed)) then return end
    if warn_on then
        if not warn_spawn_at then
            give_warning(gt)
        elseif gt >= warn_spawn_at then
            if nemesis_events.ask("take_hunt", gt) then
                warn_spawn_at = nil
                return
            end
            try_spawn(gt)
            if S.phase ~= "idle" then warn_spawn_at = nil end
        end
    else
        if nemesis_events.ask("take_hunt", gt) then return end
        try_spawn(gt)
    end
end

function spawn_lone_boss(faction, from_lvs, who)
    local actor = db.actor
    if not actor then return nil end
    local label = who.label or "lone boss"
    if S.phase ~= "idle" or #S.hunter_ids > 0 or (S.sim_squad_id and nemesis_engine.se(S.sim_squad_id)) or S.follow then
        dbg("Nemesis: a hunt is already active; the %s waits.", label)
        return nil
    end
    local lv, pos, gv = nil, nil, actor:game_vertex_id()
    local smart = pick_spawn_smart(actor, nil)
    if smart then
        pos, lv, gv = smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id
    else
        for _, from in ipairs(from_lvs or {}) do
            lv, pos = pick_ring_vertex(actor, nil, from)
            if lv then break end
        end
        if not lv then lv, pos = pick_ring_vertex(actor, nil) end
    end
    if not lv or not pos then
        dbg("Nemesis: no smart and no free vertex in the spawn range for the %s, retrying.", label)
        return nil
    end
    local section = who.section
    if not section then return nil end
    local ok, squad = pcall(function() return create_squad_at(section, pos, lv, gv) end)
    if not ok or not squad then
        dbg("!!Nemesis ERROR: the %s squad %s could not be created (%s).", label, section, tostring(squad))
        return nil
    end
    fresh_hunt(faction, squad, nil)
    local members = member_ids(squad)
    if #members == 0 then
        dbg("!Nemesis ERROR: %s squad %s has no stalkers.", label, tostring(squad.id))
        nemesis_engine.release_squad(squad)
        S.sim_squad_id = nil
        nemesis_fx.queue_squad_cleanup(squad.id)
        return nil
    end
    local used = {}
    for i, mid in ipairs(members) do
        local name = (i == 1) and who.name or nemesis_utils.next_hunter_name(used, true)
        used[name] = true
        nemesis_state.add_member(mid, true, name)
    end
    who.make_boss(members[1])
    S.spawned_count = S.spawned_count + 1
    S.hunt_start = nemesis_utils.game_seconds()
    S.phase = "hunting"
    nemesis_events.emit("hunt_started", S.faction, true, S.emission_hunt == true)
    nemesis_fx.wd_malfunction(true)
    dbg("Nemesis: %s '%s' spawned (%s) at navmesh vertex %s, %s m away [cycle %s, scripted, off the smart roster]",
        label, tostring(nemesis_state.name_of(members[1])), section, tostring(lv),
        string.format("%.0f", pos:distance_to(actor:position())), tostring(S.cycle))
    return pos
end

function follow_blocked(actor) return spawn_blocked(actor, true) end
function spawn_follow(gt, follow) try_spawn(gt, follow) end

function reset_runtime()
    warn_spawn_at = nil
    squad_pass_at = -1000000
    forget_bases()
end

