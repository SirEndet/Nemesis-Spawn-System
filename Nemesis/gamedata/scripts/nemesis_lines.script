        sneak = { "st_nemesis_army_sneak_1" },
        rush = { "st_nemesis_army_rush_1" },
        close = { "st_nemesis_army_close_1" },
        follow = {
            "st_nemesis_army_follow_1",
            "st_nemesis_army_follow_2",
            "st_nemesis_army_follow_3",
        },
        reload = { "st_nemesis_army_reload_1" },
        known_spot = {
            "st_nemesis_army_known_spot_1",
            "st_nemesis_army_known_spot_2",
        },
    },
}

-- %faction%: the player's faction, for UNISG lines (they hunt Monolith, Zombified and Sin).
local FACTION_NAMES = { monolith = "st_nemesis_faction_monolith", zombied = "st_nemesis_faction_zombied", greh = "st_nemesis_faction_greh" }
-- Your faction's name (see above), the Monolith's when it is none of the three.
local function player_faction_name()
    -- player_community: nemesis_utils, your faction id
    return text(FACTION_NAMES[nemesis_utils.player_community() or ""] or FACTION_NAMES.monolith)
end

-- line with %name%, %faction% and %boss% filled in (boss, else the hunt's boss name).
local function fill(line, boss)
    local you = player_name()
    line = string.gsub(line, "%%name%%", function() return you end)
    line = string.gsub(line, "%%faction%%", function() return player_faction_name() end)
    line = string.gsub(line, "%%boss%%", function() return tostring(boss or nemesis_utils.get_npc_name()) end)
    return line
end

-- Public for a module's own lines (the emission boss's, nemesis_emission).
function fill_line(line, boss) return fill(line, boss) end

-- A random line of kind for the hunt's faction, filled in; a module's own line comes first.
local function pick(kind, boss)
    -- A module's hunt has its own lines (the emission boss, round 93; asked since round 115); the
    -- rest are the hunt's.
    local own = nemesis_events.ask("own_line", kind, boss)   -- ask: nemesis_events, the first module's answer, or nil
    if own then return own end
    local set = LINES[hunt_faction()][kind]
    return fill(text(set[math.random(#set)]), boss)
end

-- The hunt's warning (nemesis_spawn, before the spawn).
function warning_line() return pick("warning") end
-- A named hunter breaking off (nemesis_core).
function retreat_line() return pick("retreat") end
-- The hunt's time ran out with no living boss (nemesis_core).
function time_up_line() return pick("time_up") end
-- The boss's hunt-start line (nemesis_spawn).
function boss_line() return pick("boss") end
-- The warning of a boss hunt; boss is the boss's name (nemesis_spawn).
function boss_warning_line(boss) return pick("boss_warning", boss) end
-- The boss stash reward is marked (you killed him); boss is his name (nemesis_boss).
function boss_stash_line(boss) return pick("boss_stash", boss) end
-- The boss leaves alive when the time runs out (nemesis_core).
function boss_escape_line() return pick("boss_escape") end
-- A line from nowhere, now and then while the boss is cloaked and close (nemesis_boss).
function dread_line() return pick("dread") end
-- The sneaking boss is behind you; he attacks soon (nemesis_boss).
function sneak_line() return pick("sneak") end
-- You ran, and the sneaking boss has run you down (nemesis_boss).
function rush_line() return pick("rush") end
-- The sneaking boss is within his close range of you (nemesis_boss).
function close_line() return pick("close") end
-- You are at a spot the hunters remember; each named hunter says it (nemesis_core).
function known_spot_line() return pick("known_spot") end
-- The squad follows you to the next map (nemesis_spawn).
function follow_line() return pick("follow") end
-- You reload while the boss is near, once a hunt (nemesis_boss).
function reload_line() return pick("reload") end

-- Hunt-start taunt by cycle: he remembers earlier hunts, and later ones call you by name.
function taunt(cycle)
    cycle = cycle or 1
    for _, tier in ipairs(LINES[hunt_faction()].taunt) do
        if cycle <= tier.max then return fill(text(tier.lines[math.random(#tier.lines)])) end
    end
    return text("st_nemesis_taunt_fallback")
end
