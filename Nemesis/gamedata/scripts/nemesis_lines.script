-- Nemesis Lines: what the hunt says and shows; split out of nemesis_utils in round 112.
-- Everything the hunt says and shows: the PDA messages (send_news), the hunters' names, the
-- lines per hunt faction (warning, taunt, retreat, boss lines ...). The sound picks went to
-- nemesis_sound, which owns every sound since round 126. The emission boss's own lines are in nemesis_emission (pick asks
-- there first). Callers call here directly; the old names in nemesis_utils went in round 137.
-- Used by: nemesis_spawn, nemesis_core, nemesis_boss, nemesis_emission, nemesis_guard,
-- nemesis_damage, nemesis_utils (text and the line functions).
-- Uses: nemesis_state (the hunt faction, names), nemesis_utils (boss names, the player's
-- faction), nemesis_mcm (HD icon), nemesis_sound (the PDA beep), nemesis_engine (portraits),
-- nemesis_events (a module's own lines); the engine's translate_string and give_game_news.

-- One log line: nemesis_utils.log_msg (tagged AI).
local function log_msg(...) return nemesis_utils.log_msg(...) end

-- Since the localization of round 134 (owner: the whole mod in Russian), every word the player sees comes
-- from the game's string tables (configs/text/<language>/st_nemesis*.xml), so the lines speak the
-- language the game runs in; the tables here hold string ids. An id with no text in the
-- language's files comes back as the id itself (the engine's way); so does a failed call.
function text(id)
    local t = nil
    -- src: engine level_script.cpp (game.translate_string)
    pcall(function() t = game.translate_string(id) end)
    return (type(t) == "string" and t ~= "") and t or id
end

-- The hunt's faction for its lines: UNISG's or the Monolith's.
local function hunt_faction() return nemesis_state.S.faction == "isg" and "isg" or "monolith" end

---------------------------------------------------------------------------
-- Hunter names
---------------------------------------------------------------------------
-- 30 first names, 30 surnames, all male (every Monolith and UNISG model and voice is male).
-- Combined when a hunter spawns, not stored as 900 strings. The boss name (default Bogdan
-- Kravets) is filtered out in next_hunter_name. Round 134: the lists hold string ids
-- (st_nemesis_fname_N, st_nemesis_lname_N, st_nemesis_rank_<faction>_N in configs/text/<language>/
-- st_nemesis.xml), read with text() when a name is made: a hunter keeps the name he was given.
local FIRST_NAMES = {
    "st_nemesis_fname_1", "st_nemesis_fname_2", "st_nemesis_fname_3", "st_nemesis_fname_4", "st_nemesis_fname_5",
    "st_nemesis_fname_6", "st_nemesis_fname_7", "st_nemesis_fname_8", "st_nemesis_fname_9", "st_nemesis_fname_10",
    "st_nemesis_fname_11", "st_nemesis_fname_12", "st_nemesis_fname_13", "st_nemesis_fname_14", "st_nemesis_fname_15",
    "st_nemesis_fname_16", "st_nemesis_fname_17", "st_nemesis_fname_18", "st_nemesis_fname_19", "st_nemesis_fname_20",
    "st_nemesis_fname_21", "st_nemesis_fname_22", "st_nemesis_fname_23", "st_nemesis_fname_24", "st_nemesis_fname_25",
    "st_nemesis_fname_26", "st_nemesis_fname_27", "st_nemesis_fname_28", "st_nemesis_fname_29", "st_nemesis_fname_30",
}

local LAST_NAMES = {
    "st_nemesis_lname_1", "st_nemesis_lname_2", "st_nemesis_lname_3", "st_nemesis_lname_4", "st_nemesis_lname_5",
    "st_nemesis_lname_6", "st_nemesis_lname_7", "st_nemesis_lname_8", "st_nemesis_lname_9", "st_nemesis_lname_10",
    "st_nemesis_lname_11", "st_nemesis_lname_12", "st_nemesis_lname_13", "st_nemesis_lname_14", "st_nemesis_lname_15",
    "st_nemesis_lname_16", "st_nemesis_lname_17", "st_nemesis_lname_18", "st_nemesis_lname_19", "st_nemesis_lname_20",
    "st_nemesis_lname_21", "st_nemesis_lname_22", "st_nemesis_lname_23", "st_nemesis_lname_24", "st_nemesis_lname_25",
    "st_nemesis_lname_26", "st_nemesis_lname_27", "st_nemesis_lname_28", "st_nemesis_lname_29", "st_nemesis_lname_30",
}

-- A random first name and surname, in the game's language.
local function compose_name()
    return text(FIRST_NAMES[math.random(#FIRST_NAMES)]) .. " " .. text(LAST_NAMES[math.random(#LAST_NAMES)])
end

-- Named hunters carry a rank in front of their name, so they stand out from the regular
-- stalkers of the squad. Monolith hunts use Monolith titles, UNISG hunts (when the player is
-- Monolith, Zombified or Sin) military ranks. The boss keeps the MCM name as typed.
local RANKS = {
    monolith = { "st_nemesis_rank_monolith_1", "st_nemesis_rank_monolith_2", "st_nemesis_rank_monolith_3", "st_nemesis_rank_monolith_4", "st_nemesis_rank_monolith_5", "st_nemesis_rank_monolith_6" },
    isg = { "st_nemesis_rank_isg_1", "st_nemesis_rank_isg_2", "st_nemesis_rank_isg_3", "st_nemesis_rank_isg_4", "st_nemesis_rank_isg_5", "st_nemesis_rank_isg_6" },
}

-- A random rank of the hunt's faction, in the game's language.
local function rank()
    local list = RANKS[nemesis_state.S.faction] or RANKS.monolith
    return text(list[math.random(#list)])
end

-- One random name for a hunter; `named` adds a rank. `used` avoids the same name twice in
-- one squad. The boss name (MCM) is never handed out, so it always means the boss.
function next_hunter_name(used, named)
    used = used or {}
    local name = nil
    for _ = 1, 24 do
        name = compose_name()
        if named then name = rank() .. " " .. name end
        if not used[name] and not nemesis_utils.is_boss_name(name) then break end   -- is_boss_name: nemesis_utils, either boss's name
    end
    if nemesis_utils.is_boss_name(name) then name = (named and rank() .. " " or "") .. text("st_nemesis_name_fallback") end
    used[name] = true
    return name
end


---------------------------------------------------------------------------
-- PDA messages and sounds
---------------------------------------------------------------------------
-- PDA message with the Nemesis banner (HD optional). Same engine call and sound as GAMMA's own
-- skill messages (haru_skills: give_game_news + xr_sound "pda_tips"). The old version swallowed
-- any error in a pcall and played no sound, so a failure was invisible. Now:
--   * the result is logged (debug logs), with the error text if the call failed,
--   * a failed call is retried once with a vanilla icon,
--   * the PDA "tips" sound plays when the message went out.
-- If the log says "sent" and nothing shows on screen, another mod is hiding it.
local FALLBACK_ICON = "ui_inGame2_PD_storonnik_ravnovesiya"
local NEWS_SHOW_MS = 7000

-- msg: the message; caption: the sender line (nil or "": the Nemesis caption); icon_override:
-- optional texture (the boss's own portrait). Default: the Nemesis banner.
-- The message is msg, not text (round 141): a parameter named text hid this script's text(), so
-- the fallback caption failed with "attempt to call local 'text'" (round 134 to 140).
function send_news(msg, caption, icon_override)
    local actor = db.actor
    if not actor then
        log_msg("!Nemesis: PDA message skipped, no actor yet: %s", tostring(msg))
        return false
    end
    if type(caption) ~= "string" or caption == "" then caption = text("st_nemesis_caption") end
    local icon = "ui_nemesis_news"
    if nemesis_mcm.get_bool("hd_icon", false) then   -- get_bool: nemesis_mcm, a menu checkbox (cached)
        icon = "ui_nemesis_news_hd"
    end
    if type(icon_override) == "string" and icon_override ~= "" then icon = icon_override end
    -- src: engine script_game_object_script3.cpp (give_game_news)
    local ok, err = pcall(function() actor:give_game_news(caption, msg, icon, 0, NEWS_SHOW_MS) end)
    if not ok then
        log_msg("!Nemesis ERROR: PDA message failed with icon %s (%s), retrying with a vanilla icon.", icon, tostring(err))
        icon = FALLBACK_ICON
        ok, err = pcall(function() actor:give_game_news(caption, msg, icon, 0, NEWS_SHOW_MS) end)
    end
    if ok then
        nemesis_sound.pda_tip()   -- pda_tip: nemesis_sound, the PDA beep
        log_msg("Nemesis: PDA message sent [%s] %s (icon %s).", caption, msg, icon)
    else
        log_msg("!Nemesis ERROR: PDA message failed twice (%s).", tostring(err))
    end
    return ok
end

-- A PDA message from the boss: under his name (the boss name when he is not in the hunt yet)
-- and with his portrait. Round 135 (the boss module): here, not in nemesis_boss, because the
-- spawn, the core and the emission boss send his lines too.
function boss_news(msg)
    local id = nemesis_state.S.boss_id
    -- name_of: nemesis_state, his PDA name; get_npc_name: nemesis_utils, the hunt's boss name;
    -- character_icon: nemesis_engine, his portrait
    return send_news(msg, nemesis_state.name_of(id) or nemesis_utils.get_npc_name(), id and nemesis_engine.character_icon(id))
end


-- Your character's name, or the fallback word when it cannot be read.
local function player_name()
    local name = nil
    -- src: engine script_game_object_script3.cpp (actor) (db.actor.character_name)
    pcall(function() name = db.actor:character_name() end)
    if type(name) ~= "string" or name == "" then name = text("st_nemesis_player_fallback") end
    return name
end

