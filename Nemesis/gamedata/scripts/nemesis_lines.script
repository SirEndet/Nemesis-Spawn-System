    "st_nemesis_lname_26", "st_nemesis_lname_27", "st_nemesis_lname_28", "st_nemesis_lname_29", "st_nemesis_lname_30",
}

local function compose_name()
    return text(FIRST_NAMES[math.random(#FIRST_NAMES)]) .. " " .. text(LAST_NAMES[math.random(#LAST_NAMES)])
end

local RANKS = {
    monolith = { "st_nemesis_rank_monolith_1", "st_nemesis_rank_monolith_2", "st_nemesis_rank_monolith_3", "st_nemesis_rank_monolith_4", "st_nemesis_rank_monolith_5", "st_nemesis_rank_monolith_6" },
    isg = { "st_nemesis_rank_isg_1", "st_nemesis_rank_isg_2", "st_nemesis_rank_isg_3", "st_nemesis_rank_isg_4", "st_nemesis_rank_isg_5", "st_nemesis_rank_isg_6" },
}

local function rank()
    local list = RANKS[nemesis_state.S.faction] or RANKS.monolith
    return text(list[math.random(#list)])
end

function next_hunter_name(used, named)
    used = used or {}
    local name = nil
    for _ = 1, 24 do
        name = compose_name()
        if named then name = rank() .. " " .. name end
        if not used[name] and not nemesis_utils.is_boss_name(name) then break end
    end
    if nemesis_utils.is_boss_name(name) then name = (named and rank() .. " " or "") .. text("st_nemesis_name_fallback") end
    used[name] = true
    return name
end

---------------------------------------------------------------------------
-- PDA messages and sounds
---------------------------------------------------------------------------

local FALLBACK_ICON = "ui_inGame2_PD_storonnik_ravnovesiya"
local NEWS_SHOW_MS = 7000

function send_news(msg, caption, icon_override)
    local actor = db.actor
    if not actor then
        log_msg("!Nemesis: PDA message skipped, no actor yet: %s", tostring(msg))
        return false
    end
    if type(caption) ~= "string" or caption == "" then caption = text("st_nemesis_caption") end
    local icon = "ui_nemesis_news"
    if nemesis_mcm.get_bool("hd_icon", false) then
        icon = "ui_nemesis_news_hd"
    end
    if type(icon_override) == "string" and icon_override ~= "" then icon = icon_override end

    local ok, err = pcall(function() actor:give_game_news(caption, msg, icon, 0, NEWS_SHOW_MS) end)
    if not ok then
        log_msg("!Nemesis ERROR: PDA message failed with icon %s (%s), retrying with a vanilla icon.", icon, tostring(err))
        icon = FALLBACK_ICON
        ok, err = pcall(function() actor:give_game_news(caption, msg, icon, 0, NEWS_SHOW_MS) end)
    end
    if ok then
        nemesis_sound.pda_tip()
        log_msg("Nemesis: PDA message sent [%s] %s (icon %s).", caption, msg, icon)
    else
        log_msg("!Nemesis ERROR: PDA message failed twice (%s).", tostring(err))
    end
    return ok
end

function boss_news(msg)
    local id = nemesis_state.S.boss_id

    return send_news(msg, nemesis_state.name_of(id) or nemesis_utils.get_npc_name(), id and nemesis_engine.character_icon(id))
end

local function player_name()
    local name = nil

    pcall(function() name = db.actor:character_name() end)
    if type(name) ~= "string" or name == "" then name = text("st_nemesis_player_fallback") end
    return name
end

