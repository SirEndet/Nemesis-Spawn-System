-- Nemesis Damage

local S = nemesis_state.S

local function dbg(...) nemesis_utils.log_msg(...) end

LETHAL_FLOOR = 0.05

function damage_div(id)
    local m = nemesis_utils.get_escalation(S.cycle)
    if id ~= nil and id == S.boss_id then
        local t = nemesis_mcm.get_number("boss_toughness", 30)
        if t < 0 then t = 0 end
        if t > 100 then t = 100 end
        m = m * (1 + t / 100)
    end
    return m
end

local function damage_floor()
    local cap = nemesis_mcm.get_number("max_damage_reduction", 80)
    if cap < 50 then cap = 50 end
    if cap > 95 then cap = 95 end
    return 1 - cap / 100
end

local function capped_div(id)
    return math.min(damage_div(id), 1 / damage_floor())
end

local function capped_pair(id, pct)
    local floor = damage_floor()
    pct = pct or 0
    local div = damage_div(id)
    if (1 - pct) / div < floor then
        if 1 - pct <= floor then pct, div = 1 - floor, 1
        else div = (1 - pct) / floor end
    end
    return pct, div
end

function absorb(obj, r, prev, hp, div)
    local mult = div or capped_div(r.id)
    if r.hp_armed and prev and mult > 1 and hp < prev and hp > LETHAL_FLOOR then
        hp = math.min(1, hp + (prev - hp) * (1 - 1 / mult))
        nemesis_utils.set_health(obj, hp)
    end
    return hp
end

function regular_cut()
    local t = nemesis_mcm.get_number("regular_toughness", 10)
    if t < 0 then t = 0 end
    if t > 75 then t = 75 end
    return t / 100
end

local function ask_retreat(npc, r)
    r.pending = true
    nemesis_utils.set_health(npc, 1)
end

local function in_grace(r)
    return (not r.hp_armed) or (r.grace_until ~= nil and time_global() < r.grace_until)
end

function hunter_br_now(id)
    local add_br, add_pct = nemesis_utils.br_gains(S.cycle)
    if id ~= nil and id == S.boss_id then
        local extra = nemesis_mcm.get_number("boss_br_add", 0)
        if extra < 0 then extra = 0 end
        if extra > 1 then extra = 1 end
        add_br = add_br + extra
    end
    local body, head, body_pct, head_pct, body_hf, head_hf = nemesis_utils.player_br_stats()
    local function cap_pct(v)
        v = (v or 0) + add_pct
        if v > 0.90 then v = 0.90 end
        if v < 0 then v = 0 end
        return v
    end
    return (body or 0) + add_br, (head or 0) + add_br, cap_pct(body_pct), cap_pct(head_pct),
        body_hf or 1, head_hf or 1
end

local function is_head(bone_id)
    local bid = tonumber(bone_id) or 0
    return bid >= 14 and bid <= 19
end

local function worst_loss(power, bone_id)
    return (power or 0) * (is_head(bone_id) and 4 or 2)
end

local function _from_player(shit) return shit.draftsman:id() == db.actor:id() end
local function from_player(shit)
    local ok, yes = pcall(_from_player, shit)
    return ok and yes == true
end

local function mask_if_lethal(npc, r, shit, bone_id)
    if r.cloak_vis or r.mask_vis or not shit or from_player(shit) then return end
    local hp = tonumber(npc.health)
    if not hp or hp - worst_loss(shit.power, bone_id) > 0 then return end
    local vis = nemesis_fx.get_visual(npc)
    if vis and nemesis_fx.make_invisible(npc) then r.mask_vis = vis end
end

---------------------------------------------------------------------------
-- Engine hits
---------------------------------------------------------------------------
local gbo_wrapped = false

function on_before_hit(npc, shit, bone_id, flags)
    if not npc then return end
    local id = npc:id()
    local r = nemesis_state.member(id)
    if not r then return end

    if S.phase == "hunting" and not r.retreat_at and shit and (shit.power or 0) > 0 then
        r.hit_at = time_global()
        r.hit_by_player = from_player(shit)
        r.hit_from = nil
        pcall(function() r.hit_from = shit.draftsman and shit.draftsman:id() end)
        if r.hit_by_player then
            r.player_struck = true
            r.player_hit_at = r.hit_at
            nemesis_utils.break_siege()
        end
    end
    if not r.named then

        if S.phase == "hunting" and shit and not (gbo_wrapped and from_player(shit)) then
            local cut = regular_cut()
            if cut > 0 then shit.power = (shit.power or 0) * (1 - cut) end
        end
        if S.phase == "hunting" then mask_if_lethal(npc, r, shit, bone_id) end
        return
    end
    if r.retreat_at then

        if flags then flags.ret_value = false end
        return
    end
    if S.phase ~= "hunting" then return end

    if gbo_wrapped and from_player(shit) then return end

    local div = capped_div(id)
    local pct = 0
    if shit then
        local _, _, body_pct, head_pct = hunter_br_now(id)
        pct = (is_head(bone_id) and head_pct or body_pct) or 0
        pct, div = capped_pair(id, pct)
        if pct > 0 then shit.power = (shit.power or 0) * (1 - pct) end
    end

    if shit then shit.power = (shit.power or 0) / div end
    r.hit_cut = true
    r.hit_pre = tonumber(npc.health)

    if id == S.boss_id then
        mask_if_lethal(npc, r, shit, bone_id)
        return
    end

    local hp = tonumber(npc.health)
    if not hp then return end
    if hp - worst_loss(shit and shit.power, bone_id) <= LETHAL_FLOOR then
        if flags then flags.ret_value = false end
        r.hit_cut = nil
        if not in_grace(r) then ask_retreat(npc, r) end
        return
    end
end

function on_hunter_hit(npc, amount, dir, who, bone)
    if not npc then return end
    local r = nemesis_state.member(npc:id())
    if not r or not r.hit_cut then return end

    r.hit_cut = nil
    local pre = r.hit_pre or r.last_hp
    r.hit_pre = nil
    local hp = tonumber(npc.health)
    if not hp or hp <= 0 then return end
    if r.id ~= S.boss_id and S.phase == "hunting" and not r.retreat_at and not in_grace(r)
        and pre and hp < pre - 0.02 and hp <= nemesis_utils.get_retreat_health(S.cycle) then
        ask_retreat(npc, r)
    end
    if hp > 0.05 then r.last_hp = hp end
end

---------------------------------------------------------------------------
-- Accuracy boost
---------------------------------------------------------------------------

local BOSS_ACCURACY_EXTRA = 15
local cone_version = nil
local cone = nil

local function cone_for(p) return 1 / math.sqrt(1 + p / 100) end

local function accuracy_cones()
    local v = nemesis_mcm.settings_version()
    if v ~= cone_version then
        cone_version = v
        local p = nemesis_mcm.get_number("accuracy_boost", 20)
        if p > 40 then p = 40 end
        if p <= 0 then
            cone = false
        else
            cone = { regular = cone_for(p / 2), named = cone_for(p), boss = cone_for(p + BOSS_ACCURACY_EXTRA) }
        end
    end
    return cone
end

local BOSS_MISSES = 3
local BOSS_MISS_SPREAD = 10

function on_shot_dispersion(obj, wpn, body_state, move_type, t)
    if S.phase ~= "hunting" or not obj or type(t) ~= "table" then return end
    local r = S.m[obj:id()]
    if not r or r.retreat_at or type(t.dispersion) ~= "number" then return end

    local at_player = true
    if r.id == S.boss_id then
        pcall(function() local be = obj:best_enemy(); if be then at_player = be:id() == 0 end end)
    end
    if r.id == S.boss_id and at_player then
        S.boss_shots = (S.boss_shots or 0) + 1
        if math.max(S.boss_shots, S.boss_hit_frames or 0) <= BOSS_MISSES then
            t.dispersion = t.dispersion * BOSS_MISS_SPREAD
            return
        end
    end
    local c = accuracy_cones()
    if not c then return end
    local k = (r.id == S.boss_id and c.boss) or (r.named and c.named) or c.regular
    t.dispersion = t.dispersion * k
end

function on_actor_before_hit(shit, bone_id, flags)
    if S.phase ~= "hunting" or not S.boss_id or not shit then return end
    local from = nil
    pcall(function() from = shit.draftsman and shit.draftsman:id() end)
    if from ~= S.boss_id then return end
    local frame = time_global()
    if S.boss_hit_frame ~= frame then
        S.boss_hit_frame = frame
        S.boss_hit_frames = (S.boss_hit_frames or 0) + 1
    end
    if math.max(S.boss_shots or 0, S.boss_hit_frames) <= BOSS_MISSES then
        shit.power = 0
        if flags then flags.ret_value = false end
    end
end

---------------------------------------------------------------------------
-- GAMMA ballistics (grok_bo)
---------------------------------------------------------------------------

local br_seeded = {}

local function seed(gbo, id, body_br, head_br, body_hf, head_hf)
    if br_seeded[id] then return end
    br_seeded[id] = true
    local function store(br)
        if not br or br < 0.001 then return 0.001 end
        return br
    end
    local sid = tostring(id)
    local rows = {
        { sid .. "_2", store(body_br), body_hf },
        { sid .. "_11", store(body_br), body_hf },
        { sid .. "_15", store(head_br), head_hf },
    }
    for _, row in ipairs(rows) do
        local key = row[1]
        gbo.custom_bone_value[key] = row[2]
        if type(gbo.custom_bone_hf) == "table" then gbo.custom_bone_hf[key] = row[3] or 1 end
        if type(gbo.custom_bone_ap) == "table" then gbo.custom_bone_ap[key] = 1 end
    end
end

function unseed_br()
    if next(br_seeded) ~= nil then
        pcall(function()
            local gbo = grok_bo
            if type(gbo) ~= "table" then return end
            for id in pairs(br_seeded) do
                for _, group in ipairs({ "_2", "_11", "_15" }) do
                    local key = tostring(id) .. group
                    if type(gbo.custom_bone_value) == "table" then gbo.custom_bone_value[key] = nil end
                    if type(gbo.custom_bone_hf) == "table" then gbo.custom_bone_hf[key] = nil end
                    if type(gbo.custom_bone_ap) == "table" then gbo.custom_bone_ap[key] = nil end
                end
            end
        end)
    end
    br_seeded = {}
end

local gbo_checked = false
function install_br_wrap()
    if gbo_wrapped or gbo_checked then return end
    gbo_checked = true
    local gbo = nil
    pcall(function() gbo = grok_bo end)
    if type(gbo) ~= "table" or type(gbo.npc_on_before_hit) ~= "function" or type(gbo.custom_bone_value) ~= "table" then
        dbg("Nemesis: GAMMA ballistics (grok_bo) not found; BR%% is applied by cutting the hit.")
        return
    end

    local function is_grok(f)
        local ok, env = pcall(getfenv, f)
        return ok and env == gbo
    end
    local function find_grok(f, depth)
        if type(f) ~= "function" then return nil end
        if is_grok(f) then return f end
        if depth <= 0 or not (debug and debug.getupvalue) then return nil end
        for i = 1, 30 do
            local ok, name, v = pcall(debug.getupvalue, f, i)
            if not ok or name == nil then break end
            local found = find_grok(v, depth - 1)
            if found then return found end
        end
        return nil
    end
    local field = gbo.npc_on_before_hit
    local orig = find_grok(field, 3)
    if not orig then
        dbg("!Nemesis ERROR: grok_bo's own hit function was not found (another mod wraps it); GAMMA ballistics are left alone.")
        return
    end
    if orig ~= field then
        dbg("Nemesis: grok_bo's hit function is wrapped by another script; hooking the original, the wrapper stays out of NPC hits as in stock GAMMA.")
        pcall(function() UnregisterScriptCallback("npc_on_before_hit", field) end)
    end

    local function wrapped(npc, shit, bone_id, flags)
        local r = npc and nemesis_state.member(npc:id())

        if r and r.named and r.retreat_at then return end

        if r and not r.named and S.phase == "hunting" and from_player(shit) and regular_cut() > 0 then
            local cut = regular_cut()
            local hp0 = tonumber(npc.health) or 1
            local ok, err = pcall(orig, npc, shit, bone_id, flags)
            local hp1 = tonumber(npc.health) or hp0
            if hp1 > 0 and hp1 < hp0 then
                nemesis_utils.set_health(npc, hp0 - (hp0 - hp1) * (1 - cut))
            end
            if not ok then dbg("!Nemesis ERROR: grok_bo hit failed (%s).", tostring(err)) end
            return
        end
        if not (r and r.named and S.phase == "hunting") or not from_player(shit) then
            return orig(npc, shit, bone_id, flags)
        end
        local id = r.id
        local body_br, head_br, body_pct, head_pct, body_hf, head_hf = hunter_br_now(id)

        if nemesis_mcm.get_bool("obrien_armor", false) then br_seeded[id] = nil end
        pcall(seed, gbo, id, body_br, head_br, body_hf, head_hf)
        local hp0 = tonumber(npc.health) or 1
        nemesis_utils.set_health(npc, 1)
        local ok, err = pcall(orig, npc, shit, bone_id, flags)
        local hp1 = tonumber(npc.health) or 1
        local dmg = 1 - hp1
        if dmg < 0 then dmg = 0 end
        local pct = (is_head(bone_id) and head_pct or body_pct) or 0
        local div
        pct, div = capped_pair(id, pct)
        local hp = hp0 - dmg * (1 - pct) / div
        if id == S.boss_id then

            if hp <= 0 then
                nemesis_utils.set_health(npc, hp0)
                ok, err = pcall(orig, npc, shit, bone_id, flags)
            else
                nemesis_utils.set_health(npc, hp)
                r.last_hp = hp
            end
            if not ok then dbg("!Nemesis ERROR: grok_bo hit failed (%s).", tostring(err)) end
            return
        end
        if hp < LETHAL_FLOOR then hp = LETHAL_FLOOR end
        nemesis_utils.set_health(npc, hp)
        r.last_hp = hp
        if not in_grace(r) and (hp <= LETHAL_FLOOR + 0.001 or hp <= nemesis_utils.get_retreat_health(S.cycle)) then
            ask_retreat(npc, r)
        end
        if not ok then dbg("!Nemesis ERROR: grok_bo hit failed (%s).", tostring(err)) end
    end
    pcall(function() UnregisterScriptCallback("npc_on_before_hit", orig) end)
    gbo.npc_on_before_hit = wrapped
    RegisterScriptCallback("npc_on_before_hit", wrapped)
    gbo_wrapped = true
    dbg("Nemesis: GAMMA ballistics hooked (hunter BR and BR%% follow the player).")
end
