-- Nemesis Member: the one owner of a hunt member's life. It says which state a member is in and

local S = nemesis_state.S

local function dbg(...) nemesis_utils.log_tag("MEMBER", ...) end

ACTIVE, LEAVING, DEAD, GONE = "active", "leaving", "dead", "gone"

function state(id)
    local r = nemesis_state.member(id)
    if not r then return GONE end
    if r.dead or r.death then return DEAD end
    if r.retreat_at then return LEAVING end
    return ACTIVE
end

function is_body(r, obj)
    if not r then return false end
    if r.dead or r.death then return true end
    return obj ~= nil and not nemesis_engine.alive(obj)
end

function hittable(npc)
    if not npc then return nil end
    local r = nemesis_state.member(npc:id())
    if not r or is_body(r, npc) then return nil end
    return r
end

ASSIST_MS = 2000

function assisted(r)
    return r ~= nil and r.player_hit_at ~= nil and time_global() - r.player_hit_at <= ASSIST_MS
end

function is_boss(id) return id ~= nil and id == S.boss_id end

local function name(id, r) return tostring((r and r.name) or nemesis_state.name_of(id) or id) end

function set_leaving(id, why)
    local r = nemesis_state.member(id)
    if not r or r.retreat_at or r.dead or r.death then return false end
    r.retreat_at = time_global()
    dbg("Nemesis: %s: %s -> %s (%s).", name(id, r), ACTIVE, LEAVING, why or "?")
    return true
end

function set_dead(id, teleport, why)
    local r = nemesis_state.member(id)
    if not r or r.death then return false end
    local from = state(id)
    r.dead = true
    r.death = { teleport = teleport and true or false }
    S.dying[id] = true
    dbg("Nemesis: %s: %s -> %s (%s).", name(id, r), from, DEAD, why or "?")
    return true
end

function forget(id, why)
    local r = nemesis_state.member(id)
    if not r then return end
    local from = state(id)
    nemesis_state.drop_member(id)
    dbg("Nemesis: %s: %s -> %s (%s).", name(id, r), from, GONE, why or "?")
end
